<Window x:Class="SmartBuilding.Desktop.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
        xmlns:models="clr-namespace:SmartBuilding.Desktop.WPF.Models"
        xmlns:views="clr-namespace:SmartBuilding.Desktop.WPF.Views"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="Manual"
        Background="#E8EFED"
        AllowsTransparency="False"
        WindowStyle="None"
        ResizeMode="NoResize">
    <Window.Resources>
        <conv:ModuleNavStyleConverter x:Key="ModuleNavStyleConverter"/>
        <conv:ModuleNavStyleMultiConverter x:Key="ModuleNavStyleMultiConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:StringToPackIconKindConverter x:Key="StringToPackIconKindConverter"/>
        <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter"/>

        <DataTemplate DataType="{x:Type models:ShellNavSectionHeader}">
            <TextBlock Text="{Binding Label}" Style="{StaticResource SbmsSectionLabel}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:ShellNavModuleItem}">
            <Button Command="{Binding DataContext.NavigateCommand, ElementName=ShellPanel}"
                    CommandParameter="{Binding Id}">
                <Button.Style>
                    <MultiBinding Converter="{StaticResource ModuleNavStyleMultiConverter}">
                        <Binding Path="DataContext.SelectedModuleId" ElementName="ShellPanel"/>
                        <Binding Path="Id"/>
                    </MultiBinding>
                </Button.Style>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="{Binding IconKind, Converter={StaticResource StringToPackIconKindConverter}}"
                                             VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate DataType="{x:Type models:ShellNavExpandableModuleItem}">
            <Expander IsExpanded="True" Background="Transparent" BorderThickness="0" Margin="0,2">
                <Expander.Header>
                    <Button Command="{Binding DataContext.NavigateCommand, ElementName=ShellPanel}"
                            CommandParameter="locations-create"
                            Background="Transparent" BorderThickness="0" Padding="0" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="{Binding IconKind, Converter={StaticResource StringToPackIconKindConverter}}"
                                                     VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Children}" Margin="12,4,0,4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:ShellNavChildItem}">
                            <Button Command="{Binding DataContext.NavigateCommand, ElementName=ShellPanel}"
                                    CommandParameter="{Binding Id}" Margin="0,2,0,0" Padding="12,8">
                                <Button.Style>
                                    <MultiBinding Converter="{StaticResource ModuleNavStyleMultiConverter}">
                                        <Binding Path="DataContext.SelectedModuleId" ElementName="ShellPanel"/>
                                        <Binding Path="Id"/>
                                    </MultiBinding>
                                </Button.Style>
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- Fond login (opaque — AllowsTransparency ne peut pas changer après Show) -->
        <Grid x:Name="LoginBackdrop" Visibility="Visible" Background="#E8EFED"/>

        <!-- Conteneur login centré, 75% écran, coins arrondis -->
        <Border x:Name="LoginChrome" Visibility="Visible"
                CornerRadius="16" ClipToBounds="True" Background="White"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="48" ShadowDepth="0" Opacity="0.25" Color="#0F172A"/>
            </Border.Effect>
            <views:LoginView x:Name="LoginPanel"/>
        </Border>

        <!-- Application complète après connexion -->
        <Grid x:Name="ShellPanel" Visibility="Collapsed" Background="{DynamicResource SbmsPageBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource SbmsSidebarBrush}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="8"
                                    Background="{DynamicResource SbmsAccentGreenBrush}" Margin="0,0,10,0"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image Source="{Binding ShellLogoPath, Converter={StaticResource FilePathToImageSourceConverter}}"
                                           Stretch="Uniform" Margin="3"
                                           Visibility="{Binding HasShellLogo, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <materialDesign:PackIcon Kind="OfficeBuilding" Width="24" Height="24"
                                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon.Style>
                                            <Style TargetType="materialDesign:PackIcon">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasShellLogo}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </materialDesign:PackIcon.Style>
                                    </materialDesign:PackIcon>
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding ShellBrandName}" FontWeight="Bold" FontSize="18" Foreground="White"
                                           TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                <TextBlock Text="{Binding ShellBrandSubtitle}" FontSize="10" Foreground="#A8C5C0"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="12,8,12,12">
                        <Border Background="#152E2C" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Trésorerie" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding TreasuryAvailableDisplay}" Foreground="#95D5B2" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding TreasuryDetailDisplay}" Foreground="#A8C5C0" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                <TextBlock Text="État de la connexion" Foreground="White" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center"
                                             Visibility="{Binding IsInternetConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"
                                             Visibility="{Binding IsInternetConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                    <TextBlock Grid.Column="1" Text="Internet" Foreground="#A8C5C0" FontSize="11" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding InternetStatusLabel}" Foreground="White" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="#22C55E" VerticalAlignment="Center"
                                             Visibility="{Binding IsCloudConnected, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Ellipse Width="8" Height="8" Fill="#EF4444" VerticalAlignment="Center"
                                             Visibility="{Binding IsCloudConnected, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                    <TextBlock Grid.Column="1" Text="Serveur Cloud" Foreground="#A8C5C0" FontSize="11" Margin="8,0,0,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding CloudStatusLabel}" Foreground="White" FontSize="11"/>
                                </Grid>
                                <DockPanel Margin="0,0,0,6" LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Left" Text="Base Locale (SQLite)" Foreground="#A8C5C0" FontSize="11"/>
                                    <TextBlock Text="{Binding LocalDbStatusLabel}" Foreground="White" FontSize="11" HorizontalAlignment="Right"/>
                                </DockPanel>
                                <TextBlock FontSize="11" Foreground="#A8C5C0">
                                    <Run Text="Dernier ping : "/><Run Text="{Binding PingDisplay}" Foreground="White"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Background="#152E2C" CornerRadius="10" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="18" Background="#2D6A4F">
                                    <TextBlock Text="{Binding ShellUserInitials}" Foreground="White" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ShellUserName}" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding ShellUserRole}" Foreground="#A8C5C0" FontSize="10"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button Content="Déconnexion" Command="{Binding LogoutCommand}"
                                Style="{StaticResource SbmsSidebarButton}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding NavigationItems}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Background="{DynamicResource SbmsPageBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border x:Name="TreasuryHeaderBar" Grid.Row="0"
                        Background="{DynamicResource SbmsCardBrush}"
                        BorderBrush="{DynamicResource SbmsBorderBrush}"
                        BorderThickness="0,0,0,1" Padding="16,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="WalletOutline" Width="22" Height="22" Foreground="#2D6A4F" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="#64748B" Text="Disponible ce mois (loyers du mois − dépenses du mois)"/>
                                <TextBlock Text="{Binding TreasuryAvailableDisplay}" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TreasuryDetailDisplay}" FontSize="12" Foreground="#475569"/>
                            <TextBlock Text="Seuls les loyers encaissés via Locations alimentent le budget. Aucune autre recette n'est autorisée."
                                       FontSize="11" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="Trésorerie épuisée — aucune nouvelle dépense possible."
                                       FontSize="11" FontWeight="SemiBold" Foreground="#DC2626" Margin="0,4,0,0"
                                       Visibility="{Binding IsTreasuryDepleted, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Grid Grid.Row="1">
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                    <Border Background="#08000000"
                            IsHitTestVisible="{Binding IsCurrentViewBusy}"
                            Visibility="{Binding IsCurrentViewBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
