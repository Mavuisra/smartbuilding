                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Background}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20"
                                                                         Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                                                                         VerticalAlignment="Top" Margin="0,0,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#1B3D3B"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesSidebarCard}">
                        <StackPanel>
                            <TextBlock Text="Résumé présence" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding PresenceSummaryLines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontSize="11" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ValueDisplay}"
                                                       Foreground="{Binding Color, Converter={StaticResource HexToBrushConverter}}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="Normal"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBold}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="FontSize" Value="13"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource FinancesSidebarCard}">
                        <StackPanel>
                            <TextBlock Text="Par département" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding DepartmentSlices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Department}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" Foreground="#2D6A4F"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource FinancesSidebarCard}"
                        Visibility="{Binding ShowDetailSidebar, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PersonnelDetailPanelTemplate}"/>
                </Border>

                <!-- Panneau détail — sous le tableau (écran moyen) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="White" CornerRadius="12"
                        BorderBrush="#E8EFED" BorderThickness="1" Margin="0,12,0,0" MaxHeight="420"
                        Visibility="{Binding ShowDetailStacked, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PersonnelDetailPanelTemplate}"/>
                </Border>

                <!-- Panneau détail — tiroir / overlay (petit écran) -->
                <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2" Panel.ZIndex="40"
                      Visibility="{Binding ShowDetailOverlay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Button Command="{Binding CloseDetailPanelCommand}" Background="#660F172A" BorderThickness="0"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="Hand"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="420" MinWidth="280" MaxWidth="520"
                            Background="White" BorderBrush="#E8EFED" BorderThickness="1,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="-4" Opacity="0.15" Direction="180"/>
                        </Border.Effect>
                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource PersonnelDetailPanelTemplate}"/>
                    </Border>
                </Grid>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Page fiche employé — style locateur -->
        <Grid x:Name="EmployeeDetailPageGrid" Grid.Row="0" Grid.RowSpan="2"
