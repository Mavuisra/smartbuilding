                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="22" Height="22" Foreground="#2D6A4F"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
