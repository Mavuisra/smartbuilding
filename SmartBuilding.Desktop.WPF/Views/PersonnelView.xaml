<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.PersonnelView"
             x:Name="PersonnelRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/FinancesStyles.xaml"/>
                <ResourceDictionary Source="/Themes/PersonnelStyles.xaml"/>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="PersonnelFieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
            </Style>
            <Style x:Key="PersonnelFieldValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#1B3D3B"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,12"/>
            </Style>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:BoolToScrollBarVisibilityConverter x:Key="BoolToScrollBarVisibilityConverter"/>
            <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter"/>

            <DataTemplate x:Key="PersonnelDetailPanelTemplate">
                <Grid DataContext="{Binding}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="20,16,20,12">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseDetailPanelCommand}"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                        <TextBlock Text="Détails de l'employé" FontSize="16" FontWeight="Bold" Foreground="#1B3D3B" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,0,20,12">
                        <StackPanel DataContext="{Binding SelectedEmployee}">
                            <StackPanel HorizontalAlignment="Center" Margin="0,0,0,16">
                                <Border Width="80" Height="80" CornerRadius="40" Background="#D1FAE5" HorizontalAlignment="Center" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding Initials}" FontSize="26" FontWeight="Bold" Foreground="#2D6A4F"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding FullName}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                                <TextBlock Text="{Binding Matricule}" FontSize="12" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                <Border Background="#DCFCE7" CornerRadius="10" Padding="12,4" HorizontalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding StatusLabel}" Foreground="#166534" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Informations" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="0" Style="{StaticResource PersonnelDetailTabButton}"/>
                                    <Button Content="Salaire" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="1" Style="{StaticResource PersonnelDetailTabButton}"/>
                                    <Button Content="Présence" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="2" Style="{StaticResource PersonnelDetailTabButton}"/>
                                    <Button Content="Documents" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="3" Style="{StaticResource PersonnelDetailTabButton}"/>
                                    <Button Content="Historique" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="4" Style="{StaticResource PersonnelDetailTabButton}"/>
                                </StackPanel>
                            </ScrollViewer>
                            <StackPanel Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                                <TextBlock Text="Informations personnelles" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Téléphone" FontSize="10" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding Phone}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="Email" FontSize="10" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding Email}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Adresse" FontSize="10" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding Address}" Margin="0,2,0,10" TextWrapping="Wrap"/>
                                        <TextBlock Text="Genre" FontSize="10" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding Gender}"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="Informations professionnelles" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <TextBlock Text="Fonction" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding Position}" Margin="0,2,0,8" TextWrapping="Wrap"/>
                                <TextBlock Text="Département" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding Department}" Margin="0,2,0,8"/>
                                <TextBlock Text="Date d'embauche" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding HireDate, StringFormat=dd/MM/yyyy}" Margin="0,2,0,8"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                                <TextBlock Text="Rémunération" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <TextBlock Text="Salaire de base" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding SalaryDisplay}" FontSize="20" FontWeight="Bold" Foreground="#2D6A4F" Margin="0,4,0,12"/>
                                <TextBlock Text="Type de contrat" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ContractType}" Margin="0,2,0,8"/>
                                <TextBlock Text="Superviseur" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding Supervisor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                                <TextBlock Text="Présence journalière (aujourd'hui)" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                <Border Background="{Binding PresenceBadgeBackground}" CornerRadius="10" Padding="12,8" Margin="0,0,0,16" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <Binding Path="PresenceColor" Converter="{StaticResource HexToBrushConverter}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{Binding PresenceLabel}" Foreground="{Binding PresenceBadgeForeground}" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Pointage journalier — enregistrer pour aujourd'hui" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,10"/>
                                <UniformGrid Columns="3" Margin="0,0,0,0">
                                    <Button Command="{Binding DataContext.SetPointageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="present" Style="{StaticResource PersonnelPointageChoiceButton}"
                                            Background="#22C55E" Foreground="White" ToolTip="Marquer présent">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="CheckCircleOutline" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Présent" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.SetPointageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="absent" Style="{StaticResource PersonnelPointageChoiceButton}"
                                            Background="#F97316" Foreground="White" ToolTip="Marquer absent">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="CloseCircleOutline" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Absent" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.OpenPointagePopupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Style="{StaticResource PersonnelPointageChoiceButton}"
                                            Background="#8B5CF6" Foreground="White" ToolTip="Congé avec motif">
                                        <StackPanel>
                                            <materialDesign:PackIcon Kind="Beach" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Congé" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                            <StackPanel Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                                <TextBlock Text="Documents RH" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Contrats et pièces jointes liés à cet employé." Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=4}">
                                <TextBlock Text="Historique" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Historique des modifications et pointages à venir." Foreground="#94A3B8" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" Padding="20,12,20,16" BorderBrush="#E8EFED" BorderThickness="0,1,0,0">
                        <Button Command="{Binding ViewEmployeeCommand}" CommandParameter="{Binding SelectedEmployee}"
                                Style="{StaticResource SbmsLoginPrimaryButton}" HorizontalAlignment="Stretch" Padding="14,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="PencilOutline" Margin="0,0,8,0"/>
                                <TextBlock Text="Modifier les informations"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête (aligné Finances) -->
        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E8EFED" BorderThickness="0,0,0,1"
                Visibility="{Binding IsEmployeeDetailPageOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Personnel" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Gestion des employés de l'entreprise" FontSize="13"
                               Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,0" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Background="White" VerticalAlignment="Center" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20"
                                                 Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="0,0,12,0"
                                 materialDesign:HintAssist.Hint="Rechercher (nom, ID, fonction...)"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40">
                        <materialDesign:PackIcon Kind="BellOutline"/>
                    </Button>
                    <Border Background="#E63946" CornerRadius="9" MinWidth="18" Height="18"
                            Margin="-14,-8,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Corps (aligné Finances) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8"
                      Visibility="{Binding IsEmployeeDetailPageOpen, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,8">
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Total employés" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding TotalEmployees}" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                            <TextBlock Text="Effectif actif" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Présents aujourd'hui" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding PresentToday}" FontSize="18" FontWeight="Bold" Foreground="#166534"/>
                            <TextBlock Text="{Binding PresentPercent}" FontSize="10" Foreground="#22C55E"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Absents aujourd'hui" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding AbsentToday}" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                            <TextBlock Text="{Binding AbsentPercent}" FontSize="10" Foreground="#F97316"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="En congé aujourd'hui" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding OnLeaveToday}" FontSize="18" FontWeight="Bold" Foreground="#7C3AED"/>
                            <TextBlock Text="{Binding OnLeavePercent}" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Disponible (loyers − dépenses)" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding AvailableBalanceDisplay}" FontSize="15" FontWeight="Bold" Foreground="#1B3D3B"/>
                            <TextBlock Text="{Binding RentCollectedTotalDisplay}" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Paies validées (mois)" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding MonthlyPayroll}" FontSize="15" FontWeight="Bold" Foreground="#2D6A4F"/>
                            <TextBlock Text="Plafonnées par les loyers encaissés" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Nouveaux employés" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding NewThisMonth}" FontSize="18" FontWeight="Bold" Foreground="#2D6A4F"/>
                            <TextBlock Text="Ce mois-ci" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Retards aujourd'hui" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding LateToday}" FontSize="18" FontWeight="Bold" Foreground="#EAB308"/>
                            <TextBlock Text="Pointage matin" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="Taux de présence" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding PresenceRateDisplay}" FontSize="15" FontWeight="Bold" Foreground="#2D6A4F"/>
                            <TextBlock Text="Aujourd'hui" FontSize="10" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E8EFED" BorderThickness="1"
                        Padding="10,8" Margin="0,0,0,8">
                    <WrapPanel>
                        <Button Command="{Binding AddEmployeeCommand}" Style="{StaticResource FinancesPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,6,0"/>
                                <TextBlock Text="Ajouter employé"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenAttendanceDashboardCommand}" Style="{StaticResource FinancesToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ClockCheckOutline" Margin="0,0,6,0"/>
                                <TextBlock Text="Dashboard pointage"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportPayrollExcelCommand}" Style="{StaticResource FinancesToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileExportOutline" Margin="0,0,6,0"/>
                                <TextBlock Text="Export paies Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FinancesToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,6,0"/>
                                <TextBlock Text="Export PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FinancesToolbarButton}">
                            <materialDesign:PackIcon Kind="Printer"/>
                        </Button>
                        <Button Command="{Binding LoadCommand}" Style="{StaticResource FinancesToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Margin="0,0,6,0"/>
                                <TextBlock Text="Actualiser"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SyncCommand}" Style="{StaticResource FinancesToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Margin="0,0,6,0"/>
                                <TextBlock Text="Synchroniser"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,8">
                    <Border Style="{StaticResource FinancesAnalyticsCard}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Masse salariale (5 mois)" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding PayrollTrendSeries}" Height="130"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesAnalyticsCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Répartition par département" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:PieChart Series="{Binding DepartmentPieSeries}" Height="130"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesAnalyticsCard}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Présence (aujourd'hui)" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding PresenceBarSeries}" Height="130"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="3" MinHeight="360">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="{Binding RightSidebarColumnWidth}"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1"
                        Margin="0,0,8,0" Padding="10,8" ClipToBounds="False">
                    <DockPanel LastChildFill="True">
                        <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding Departments}" SelectedItem="{Binding FilterDepartment}" Style="{StaticResource FinancesFilterCombo}"/>
                                <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding FilterPosition}" Style="{StaticResource FinancesFilterCombo}"/>
                                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource FinancesFilterCombo}"/>
                                <ComboBox ItemsSource="{Binding Presences}" SelectedItem="{Binding FilterPresence}" Style="{StaticResource FinancesFilterCombo}" MinWidth="140"/>
                                <TextBox Style="{StaticResource FinancesFilterSearch}"
                                         materialDesign:HintAssist.Hint="Rechercher..."
                                         Text="{Binding TableSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="{Binding PresenceDayCaption}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            <TextBlock DockPanel.Dock="Right" Text="← Faites défiler horizontalement pour voir toutes les colonnes →"
                                       FontSize="10" Foreground="#94A3B8" FontStyle="Italic" VerticalAlignment="Center"
                                       Visibility="{Binding UseHorizontalTableScroll, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </DockPanel>

                        <ScrollViewer x:Name="EmployeesGridScroll" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" PanningMode="Both"
                                      CanContentScroll="False" ClipToBounds="False">
                        <DataGrid x:Name="EmployeesGrid" ItemsSource="{Binding Employees}" Style="{StaticResource PersonnelDataGrid}"
                                  SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                                  HorizontalAlignment="Left"
                                  materialDesign:DataGridAssist.CellPadding="8,4" MinHeight="200" MinWidth="1320">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="48" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn x:Name="ColMatricule" Header="ID EMPLOYÉ" Binding="{Binding Matricule}" Width="110"
                                                    MinWidth="96" ElementStyle="{StaticResource FinancesCellText}"/>
                                <DataGridTemplateColumn Header="EMPLOYÉ" Width="220" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" ClipToBounds="True" ToolTip="{Binding FullName}">
                                                <Grid Visibility="{Binding DataContext.ShowCompactEmployeeCell, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                            Background="#D1FAE5" Margin="0,0,10,0">
                                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" Foreground="#2D6A4F" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="0">
                                                        <TextBlock Text="{Binding FullName}" Style="{StaticResource FinancesCellText}" FontWeight="SemiBold"
