                                <Border Width="88" Height="88" CornerRadius="44" Background="#E8F5EE" Margin="0,0,0,8" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding DetailProfilePhotoPath, Converter={StaticResource FilePathToImageSourceConverter}}"
                                               Stretch="UniformToFill"
                                               Visibility="{Binding HasDetailProfilePhoto, Converter={StaticResource BoolToVisibilityConverter}}"/>
