                                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="État civil" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
