                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailBirthDateDisplay}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Âge"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailAgeDisplay}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Genre"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailGender}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Pièce d'identité"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailNationalId}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Situation matrimoniale"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailMaritalStatus}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Poste &amp; urgence" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Date d'embauche"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailHireDateDisplay}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Superviseur"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailSupervisor}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Horaires"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailWorkSchedule}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Contact d'urgence"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailEmergencyName}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Téléphone urgence"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailEmergencyPhone}"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Observations"/>
                                        <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailNotes}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                                    <TextBlock Text="Contrat de travail" FontWeight="SemiBold" FontSize="15" Foreground="#1B3D3B" Margin="0,0,0,12"/>
                                    <UniformGrid Columns="2" Margin="0,0,0,12">
