                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="White" Padding="20,14" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Command="{Binding GoBackFromEmployeeDetailCommand}"
                            Style="{StaticResource LocationsToolbarButton}" Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,6,0"/>
                            <TextBlock Text="Retour au personnel"/>
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Personnel / Fiche employé" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
