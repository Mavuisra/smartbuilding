                                                        <Border CornerRadius="8" Padding="6,2" Background="#F1F5F9">
                                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                                    <Button Command="{Binding OpenPayrollDialogCommand}" Style="{StaticResource FinancesPrimaryButton}"
                                            HorizontalAlignment="Left" Margin="0,0,0,12"
                                            Visibility="{Binding CanManagePersonnel, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="CashPlus" Margin="0,0,6,0"/>
                                            <TextBlock Text="Générer une fiche de paie"/>
                                        </StackPanel>
                                    </Button>
                                    <DataGrid ItemsSource="{Binding DetailSalaryPayments}" Style="{StaticResource LocationsDataGrid}"
                                              materialDesign:DataGridAssist.CellPadding="8,4" IsReadOnly="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PÉRIODE" Binding="{Binding PeriodDisplay}" Width="*"/>
                                            <DataGridTextColumn Header="BRUT" Binding="{Binding GrossDisplay}" Width="100"/>
                                            <DataGridTextColumn Header="NET" Binding="{Binding AmountDisplay}" Width="100"/>
                                            <DataGridTextColumn Header="DATE" Binding="{Binding PaymentDateDisplay}" Width="100"/>
                                            <DataGridTemplateColumn Header="STATUT" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding StatusColor}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="PDF" Width="60">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.OpenPaySlipPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}">
                                                            <materialDesign:PackIcon Kind="FilePdfBox"/>
                                                        </Button>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                                    <TextBlock Text="{Binding PresenceDayCaption}" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,12"/>
                                    <Border Background="{Binding DetailPresenceBadgeBackground}" CornerRadius="10" Padding="12,8" Margin="0,0,0,16" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding DetailPresenceLabel}" Foreground="{Binding DetailPresenceBadgeForeground}" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding DetailPresenceStatsLine}" FontSize="12" Foreground="#64748B" Margin="0,0,0,12" TextWrapping="Wrap"/>
                                    <UniformGrid Columns="4" Margin="0,0,0,16">
                                        <Button Command="{Binding SetPointageCommand}" CommandParameter="present"
                                                Style="{StaticResource PersonnelPointageChoiceButton}" Background="#22C55E" Foreground="White" Margin="0,0,4,0">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Login" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="Arrivée" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SetPointageCommand}" CommandParameter="checkout"
                                                Style="{StaticResource PersonnelPointageChoiceButton}" Background="#2563EB" Foreground="White" Margin="2,0">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Logout" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="Sortie" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding SetPointageCommand}" CommandParameter="absent"
                                                Style="{StaticResource PersonnelPointageChoiceButton}" Background="#F97316" Foreground="White" Margin="2,0">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="CloseCircleOutline" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="Absent" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding OpenPointagePopupCommand}" CommandParameter="{Binding SelectedEmployee}"
                                                Style="{StaticResource PersonnelPointageChoiceButton}" Background="#8B5CF6" Foreground="White" Margin="4,0,0,0">
                                            <StackPanel>
                                                <materialDesign:PackIcon Kind="Beach" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                <TextBlock Text="Congé" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    <TextBlock Text="Historique récent (30 jours)" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                    <DataGrid ItemsSource="{Binding DetailAttendances}" Style="{StaticResource LocationsDataGrid}"
                                              materialDesign:DataGridAssist.CellPadding="8,4" IsReadOnly="True" MaxHeight="280">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="100"/>
                                            <DataGridTextColumn Header="ARRIVÉE" Binding="{Binding CheckInDisplay}" Width="80"/>
                                            <DataGridTextColumn Header="DÉPART" Binding="{Binding CheckOutDisplay}" Width="80"/>
                                            <DataGridTextColumn Header="HEURES" Binding="{Binding WorkedHoursDisplay}" Width="70"/>
                                            <DataGridTextColumn Header="RETARD" Binding="{Binding LateDisplay}" Width="70"/>
                                            <DataGridTemplateColumn Header="STATUT" Width="*">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="11" Foreground="{Binding StatusColor}"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding DetailDisciplinaryNotes}"
                                              Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=4}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FFF7ED" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#FED7AA" BorderThickness="1">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#EA580C" Margin="0,0,8,0"/>
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DateDisplay}" FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl ItemsSource="{Binding DetailActivities}"
                                              Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=5}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#E8EFED" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#E8F5EE" Margin="0,0,12,0">
                                                        <materialDesign:PackIcon Kind="History" Width="18" Height="18" Foreground="#2D6A4F"
                                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2" Text="{Binding DateDisplay}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Top"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <!-- Mode édition -->
                            <ScrollViewer Visibility="{Binding IsEmployeeDetailEditMode, Converter={StaticResource BoolToVisibilityConverter}}"
                                          VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <StackPanel>
                                    <TextBlock Text="Modifier la fiche" FontWeight="SemiBold" FontSize="15" Foreground="#1B3D3B" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Prénom *" Text="{Binding FormFirstName, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Nom *" Text="{Binding FormLastName, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Téléphone" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Email" Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Adresse" Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Genre" Text="{Binding FormGender, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DatePicker Grid.Row="3" Grid.Column="1" Margin="8,0,0,10" SelectedDate="{Binding FormBirthDate}"
                                                    materialDesign:HintAssist.Hint="Date de naissance"/>
                                        <TextBox Grid.Row="4" Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="N° pièce d'identité" Text="{Binding FormNationalId, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="8,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Situation matrimoniale" Text="{Binding FormMaritalStatus, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="5" Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Matricule *" Text="{Binding FormMatricule, UpdateSourceTrigger=PropertyChanged}"/>
                                        <DatePicker Grid.Row="5" Grid.Column="1" Margin="8,0,0,10" SelectedDate="{Binding FormHireDate}"
                                                    materialDesign:HintAssist.Hint="Date d'embauche"/>
                                    </Grid>
                                    <TextBlock Text="Contrat &amp; poste" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,8,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="N° contrat" Text="{Binding FormContractNumber, UpdateSourceTrigger=PropertyChanged}"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,10" ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding FormContractType}"
                                                  materialDesign:HintAssist.Hint="Type de contrat"/>
                                        <DatePicker Grid.Row="1" Grid.Column="0" Margin="0,0,8,10" SelectedDate="{Binding FormContractStart}"
                                                    materialDesign:HintAssist.Hint="Début du contrat"/>
                                        <DatePicker Grid.Row="1" Grid.Column="1" Margin="8,0,0,10" SelectedDate="{Binding FormContractEnd}"
                                                    materialDesign:HintAssist.Hint="Fin du contrat (CDD)"/>
                                        <TextBox Grid.Row="2" Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Fonction" Text="{Binding FormPosition, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Département" Text="{Binding FormDepartment, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Salaire de base (€)" Text="{Binding FormBaseSalaryText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="8,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                 materialDesign:HintAssist.Hint="Superviseur" Text="{Binding FormSupervisor, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                    <TextBox Margin="0,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Horaires de travail" Text="{Binding FormWorkSchedule, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="0,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Contact d'urgence" Text="{Binding FormEmergencyContactName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="0,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Téléphone urgence" Text="{Binding FormEmergencyContactPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="0,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Observations" Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap"/>
                                    <CheckBox Content="Employé actif" IsChecked="{Binding FormIsActive}" Margin="0,0,0,8"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" Background="White" Padding="16,12" BorderBrush="#E8EFED" BorderThickness="0,1,0,0">
                <DockPanel>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,12,0"
                            Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding EnterEmployeeDetailEditModeCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="20,10" Margin="0,0,10,0"
                                Visibility="{Binding IsEmployeeDetailEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PencilOutline" Margin="0,0,8,0"/>
                                <TextBlock Text="Modifier les informations"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelEmployeeDetailEditCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                Padding="20,10" Margin="0,0,10,0" Content="Annuler"
                                Visibility="{Binding IsEmployeeDetailEditMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Command="{Binding SaveEmployeeEditorCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" Padding="24,10"
                                Visibility="{Binding IsEmployeeDetailEditMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Margin="0,0,8,0"/>
                                <TextBlock Text="Enregistrer"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="{StaticResource SbmsAccentGreenBrush}"/>

        <!-- Popup pointage -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="60"
              Visibility="{Binding IsPointagePopupOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#800F172A"/>
            <Border Background="White" CornerRadius="16" MaxWidth="480" MinWidth="320" Width="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.22" Color="#0F172A"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="24,20,24,12">
                        <Button DockPanel.Dock="Right" Command="{Binding ClosePointagePopupCommand}"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Pointage" FontSize="20" FontWeight="Bold" Foreground="#1B3D3B"/>
                            <TextBlock Text="{Binding PointageEmployee.FullName}" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding PointageEmployee.Matricule}" FontSize="11" Foreground="#94A3B8"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="24,0,24,12"
                            Visibility="{Binding PointageError, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding PointageError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                    </Border>
                    <UniformGrid Columns="3" Margin="24,0,24,0">
                        <Button Command="{Binding SetPointageCommand}" CommandParameter="present"
                                Style="{StaticResource PersonnelPointageChoiceButton}"
                                Background="#22C55E" Foreground="White">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Présent" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SetPointageCommand}" CommandParameter="absent"
                                Style="{StaticResource PersonnelPointageChoiceButton}"
                                Background="#F97316" Foreground="White">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="CloseCircleOutline" Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Absent" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SetPointageCommand}" CommandParameter="leave"
                                Style="{StaticResource PersonnelPointageChoiceButton}"
                                Background="#8B5CF6" Foreground="White">
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Beach" Width="22" Height="22" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                <TextBlock Text="Congé" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <StackPanel Margin="24,16,24,24">
                        <TextBlock Text="Motif du congé (obligatoire pour Congé)" FontSize="11" Foreground="#64748B" Margin="0,0,0,6"/>
                        <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Ex. maladie, congé personnel, formation..."
                                 Text="{Binding PointageLeaveReason, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dashboard pointage -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="75"
              Visibility="{Binding IsAttendanceDashboardOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#800F172A"/>
            <Border Background="White" CornerRadius="12" Margin="24" Padding="0"
                    VerticalAlignment="Stretch" HorizontalAlignment="Stretch" MaxHeight="900">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="20,16,20,8">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseAttendanceDashboardCommand}"
                                Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Dashboard pointage" FontSize="20" FontWeight="Bold" Foreground="#1B3D3B"/>
                            <TextBlock Text="Historique, filtres et statistiques de présence" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Background="#F8FAFC" Padding="16,12" BorderBrush="#E8EFED" BorderThickness="0,1,0,1">
                        <WrapPanel VerticalAlignment="Center">
                            <DatePicker SelectedDate="{Binding AttendanceFilterFrom}" Width="140" Margin="0,0,8,8"
                                        materialDesign:HintAssist.Hint="Du"/>
                            <DatePicker SelectedDate="{Binding AttendanceFilterTo}" Width="140" Margin="0,0,8,8"
                                        materialDesign:HintAssist.Hint="Au"/>
                            <ComboBox ItemsSource="{Binding AttendanceEmployeeFilters}" SelectedItem="{Binding AttendanceFilterEmployee}"
                                      Width="220" Margin="0,0,8,8" materialDesign:HintAssist.Hint="Employé"/>
                            <ComboBox ItemsSource="{Binding AttendanceStatusFilters}" SelectedItem="{Binding AttendanceFilterStatus}"
                                      Width="160" Margin="0,0,8,8" materialDesign:HintAssist.Hint="Statut"/>
                            <Button Command="{Binding LoadAttendanceDashboardCommand}" Style="{StaticResource FinancesPrimaryButton}" Margin="0,0,8,8">
                                <TextBlock Text="Appliquer"/>
                            </Button>
                            <Button Command="{Binding ExportAttendanceExcelCommand}" Style="{StaticResource FinancesToolbarButton}" Margin="0,0,8,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" Margin="0,0,6,0"/>
                                    <TextBlock Text="Export Excel"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </Border>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding AttendanceHistoryRows}" Style="{StaticResource LocationsDataGrid}"
                              Margin="16,8" materialDesign:DataGridAssist.CellPadding="8,4" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="90"/>
                            <DataGridTextColumn Header="MATRICULE" Binding="{Binding Matricule}" Width="90"/>
                            <DataGridTextColumn Header="EMPLOYÉ" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="DÉPART." Binding="{Binding Department}" Width="100"/>
                            <DataGridTextColumn Header="ARRIVÉE" Binding="{Binding CheckInDisplay}" Width="70"/>
                            <DataGridTextColumn Header="DÉPART" Binding="{Binding CheckOutDisplay}" Width="70"/>
                            <DataGridTemplateColumn Header="STATUT" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Foreground="{Binding StatusColor}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="RETARD" Binding="{Binding LateDisplay}" Width="70"/>
                            <DataGridTextColumn Header="HEURES" Binding="{Binding WorkedHoursDisplay}" Width="70"/>
                            <DataGridTextColumn Header="HS" Binding="{Binding OvertimeHoursDisplay}" Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="3" Padding="16,12" Background="#F0FDF4" BorderBrush="#E8EFED" BorderThickness="0,1,0,0">
                        <TextBlock Text="{Binding AttendanceStatsSummary}" Foreground="#166534" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Dialog suspension -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="70"
              Visibility="{Binding IsSuspendDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#800F172A"/>
            <Border Background="White" CornerRadius="12" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Suspendre l'employé" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Motif *"
                             Text="{Binding SuspendReason, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <DatePicker SelectedDate="{Binding SuspendUntil}" materialDesign:HintAssist.Hint="Fin de suspension *" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding SuspendError}" Foreground="#DC2626" Visibility="{Binding SuspendError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Command="{Binding CloseSuspendDialogCommand}" Content="Annuler" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                        <Button Command="{Binding ConfirmSuspendCommand}" Content="Confirmer" Style="{StaticResource SbmsLoginPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dialog renvoi -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="70"
              Visibility="{Binding IsDismissDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#800F172A"/>
            <Border Background="White" CornerRadius="12" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Renvoyer l'employé" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Motif de renvoi *"
                             Text="{Binding DismissReason, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="80"/>
                    <TextBlock Text="{Binding DismissError}" Foreground="#DC2626" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Command="{Binding CloseDismissDialogCommand}" Content="Annuler" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                        <Button Command="{Binding ConfirmDismissCommand}" Content="Confirmer le renvoi" Style="{StaticResource SbmsLoginPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dialog paie -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="70"
              Visibility="{Binding IsPayrollDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#800F172A"/>
            <Border Background="White" CornerRadius="12" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Créer fiche de paie" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Année" Text="{Binding PayrollYear}"/>
                        <TextBox Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Mois" Text="{Binding PayrollMonth}"/>
                    </Grid>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Primes"
                             Text="{Binding PayrollBonusesText}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Pénalités"
                             Text="{Binding PayrollPenaltiesText}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Avances"
                             Text="{Binding PayrollAdvancesText}" Margin="0,0,0,8"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Retenues"
                             Text="{Binding PayrollDeductionsText}" Margin="0,0,0,8"/>
                    <Button Command="{Binding RefreshPayrollPreviewCommand}" Content="Calculer le net" Style="{StaticResource FinancesToolbarButton}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding PayrollNetPreview}" FontSize="20" FontWeight="Bold" Foreground="#2D6A4F" Margin="0,4,0,8"/>
                    <TextBlock Text="{Binding PayrollError}" Foreground="#DC2626"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Command="{Binding ClosePayrollDialogCommand}" Content="Annuler" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                        <Button Command="{Binding CreatePayrollCommand}" Content="Créer et générer PDF" Style="{StaticResource SbmsLoginPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Dialog remarque RH -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="70"
              Visibility="{Binding IsDisciplinaryDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#800F172A"/>
            <Border Background="White" CornerRadius="12" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="Remarque administrative" FontSize="18" FontWeight="Bold" Margin="0,0,0,12"/>
                    <ComboBox ItemsSource="{Binding DisciplinaryCategories}" SelectedItem="{Binding DisciplinaryCategory}" Margin="0,0,0,10"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Titre *"
                             Text="{Binding DisciplinaryTitle}" Margin="0,0,0,10"/>
                    <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" materialDesign:HintAssist.Hint="Description"
                             Text="{Binding DisciplinaryDescription}" AcceptsReturn="True" MinHeight="80"/>
                    <TextBlock Text="{Binding DisciplinaryError}" Foreground="#DC2626" Margin="0,8,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Command="{Binding CloseDisciplinaryDialogCommand}" Content="Annuler" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0"/>
                        <Button Command="{Binding SaveDisciplinaryNoteCommand}" Content="Enregistrer" Style="{StaticResource SbmsLoginPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal fiche / ajout employé -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Panel.ZIndex="50"
              Visibility="{Binding IsEmployeeFormVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#800F172A"/>
            <Border Background="White" CornerRadius="12" MaxWidth="640" MaxHeight="720"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Padding="28,24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.2" Color="#0F172A"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,20">
                            <Button DockPanel.Dock="Right" Command="{Binding CancelEmployeeEditorCommand}"
                                    Style="{StaticResource MaterialDesignIconButton}">
                                <materialDesign:PackIcon Kind="Close"/>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding EmployeeFormTitle}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="{Binding EmployeeFormSubtitle}"
                                           Foreground="{StaticResource SbmsTextMutedBrush}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                                Padding="12,8" Margin="0,0,0,16"
                                Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Matricule *" Text="{Binding FormMatricule, UpdateSourceTrigger=PropertyChanged}"/>
                            <DatePicker Grid.Row="0" Grid.Column="1" Margin="8,0,0,12" SelectedDate="{Binding FormHireDate}"
                                        materialDesign:HintAssist.Hint="Date d'embauche *"/>
                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Prénom *" Text="{Binding FormFirstName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Nom *" Text="{Binding FormLastName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Fonction" Text="{Binding FormPosition, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Département" Text="{Binding FormDepartment, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Téléphone" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Margin="8,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Email" Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="4" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Salaire de base (€)" Text="{Binding FormBaseSalaryText, UpdateSourceTrigger=PropertyChanged}"/>
                            <CheckBox Grid.Row="4" Grid.Column="1" Content="Employé actif" Margin="8,8,0,12" IsChecked="{Binding FormIsActive}" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Command="{Binding CancelEmployeeEditorCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="20,10" Margin="0,0,10,0" Content="Annuler"/>
                            <Button Command="{Binding SaveEmployeeEditorCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" Padding="24,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Margin="0,0,8,0"/>
                                    <TextBlock Text="Enregistrer"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
