                                        <TextBlock Text="Photo" FontSize="10"/>
                                    </Button>
                                    <Button Command="{Binding RemoveProfilePhotoCommand}" Style="{StaticResource FinancesToolbarButton}" Padding="8,4"
                                            Visibility="{Binding HasDetailProfilePhoto, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Retirer" FontSize="10"/>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{Binding EmployeeDetailTitle}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FormMatricule}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,8"/>
                                <TextBlock Text="{Binding FormPosition}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,8"/>
                                <Border Background="#DBEAFE" CornerRadius="8" Padding="10,4" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding FormDepartment}" Foreground="#1D4ED8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
                                </Border>
                                <Border Background="{Binding DetailPresenceBadgeBackground}" CornerRadius="8" Padding="10,4" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding DetailPresenceLabel}" Foreground="{Binding DetailPresenceBadgeForeground}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                                <TextBlock Text="{Binding DetailSalaryDisplay}" FontWeight="SemiBold" Foreground="#2D6A4F" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding DetailContractStatus, StringFormat=Contrat : {0}}" FontSize="11" Foreground="#64748B"
                                           HorizontalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DetailStatusLabel}" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding DetailSeniorityDisplay}" FontSize="11" Foreground="#2D6A4F" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <WrapPanel Margin="0,8,0,0" Visibility="{Binding CanManagePersonnel, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Command="{Binding OpenPayrollDialogCommand}" Style="{StaticResource FinancesToolbarButton}" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="CashPlus" Margin="0,0,6,0"/>
                                    <TextBlock Text="Créer paie"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenSuspendDialogCommand}" Style="{StaticResource FinancesToolbarButton}" Margin="0,0,6,6">
