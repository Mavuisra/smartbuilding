                                            <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="N° contrat"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailContractNumber}"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Type de contrat"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailContractType}"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Date de début"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailContractStartDisplay}"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Date de fin"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailContractEndDisplay}"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Salaire de base"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailSalaryDisplay}"/>
                                            <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Statut"/>
