                                    <Button Content="Salaires" Command="{Binding SetDetailTabCommand}" CommandParameter="2" Style="{StaticResource LocationsMainTabButton}"/>
                                    <Button Content="Présence" Command="{Binding SetDetailTabCommand}" CommandParameter="3" Style="{StaticResource LocationsMainTabButton}"/>
                                    <Button Content="Discipline" Command="{Binding SetDetailTabCommand}" CommandParameter="4" Style="{StaticResource LocationsMainTabButton}"/>
                                    <Button Content="Historique" Command="{Binding SetDetailTabCommand}" CommandParameter="5" Style="{StaticResource LocationsMainTabButton}"/>
                                </StackPanel>
                            </Border>
                            <!-- Lecture seule -->
                            <Grid Visibility="{Binding IsEmployeeDetailEditMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                <Grid Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
