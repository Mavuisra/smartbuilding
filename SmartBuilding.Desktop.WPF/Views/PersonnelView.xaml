                            <Button Command="{Binding OpenDismissDialogCommand}" Style="{StaticResource FinancesToolbarButton}" Margin="0,0,6,6">
                                <TextBlock Text="Renvoyer"/>
                            </Button>
                            <Button Command="{Binding OpenDisciplinaryDialogCommand}" Style="{StaticResource FinancesToolbarButton}" Margin="0,0,6,6">
                                <TextBlock Text="Remarque RH"/>
                            </Button>
                            <Button Command="{Binding AttachContractPdfCommand}" Style="{StaticResource FinancesToolbarButton}" Margin="0,0,6,6">
                                <TextBlock Text="Contrat PDF"/>
                            </Button>
                            <Button Command="{Binding OpenContractPdfCommand}" Style="{StaticResource FinancesToolbarButton}" Margin="0,0,6,6">
                                <TextBlock Text="Voir contrat"/>
                            </Button>
                            <Button Command="{Binding DeleteEmployeeCommand}" CommandParameter="{Binding SelectedEmployee}"
                                    Style="{StaticResource FinancesToolbarButton}" Margin="0,0,6,6">
                                <TextBlock Text="Archiver" Foreground="#DC2626"/>
                            </Button>
                        </WrapPanel>
                        <Border Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1" Padding="16" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Contact rapide" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Téléphone"/>
                                <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailPhone}"/>
                                <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Email"/>
                                <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailEmail}"/>
                                <TextBlock Style="{StaticResource PersonnelFieldLabel}" Text="Adresse"/>
                                <TextBlock Style="{StaticResource PersonnelFieldValue}" Text="{Binding DetailAddress}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1" Padding="16">
