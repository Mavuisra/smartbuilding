<Window x:Class="SmartBuilding.Desktop.WPF.Views.InitialSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Configuration initiale"
        Width="900" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F8F6">
    <Window.Resources>
        <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Background="#1B3D3B" CornerRadius="14" Padding="18" Grid.Row="0" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Bienvenue dans SBMS" Foreground="White" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Text="Assistant de première configuration locale"
                               Foreground="#D1FAE5" FontSize="13"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#2D6A4F" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StepIndex, StringFormat=Étape {0}/3}" Foreground="#F0FDF4" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <TextBlock Text="1. Administrateur" Margin="12,0" FontWeight="SemiBold"/>
                    <TextBlock Text="2. Bâtiment" Margin="12,0" FontWeight="SemiBold"/>
                    <TextBlock Text="3. Entreprise" Margin="12,0" FontWeight="SemiBold"/>
                    <TextBlock Text="4. Thème" Margin="12,0" FontWeight="SemiBold"/>
                </StackPanel>

                <Grid Grid.Row="1">
                    <!-- Etape 0 -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                        <TextBlock Text="Créer l'administrateur principal" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Nom complet"/>
                                <TextBox Text="{Binding AdminFullName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Nom d'utilisateur"/>
                                <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,8,8">
                                <TextBlock Text="Mot de passe"/>
                                <PasswordBox x:Name="PasswordBoxMain" Margin="0,4,0,0" PasswordChanged="PasswordBoxMain_OnPasswordChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Grid.Row="1" Margin="8,0,0,8">
                                <TextBlock Text="Confirmer le mot de passe"/>
                                <PasswordBox x:Name="PasswordBoxConfirm" Margin="0,4,0,0" PasswordChanged="PasswordBoxConfirm_OnPasswordChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Etape 1 -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                        <TextBlock Text="Configurer le bâtiment" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Nom du bâtiment"/>
                                <TextBox Text="{Binding BuildingName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Nombre d'étages"/>
                                <TextBox Text="{Binding TotalFloors, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,8">
                                <TextBlock Text="Adresse complète"/>
                                <TextBox Text="{Binding BuildingAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,8,8,8">
                                <TextBlock Text="Ville"/>
                                <TextBox Text="{Binding BuildingCity, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,8,0,8">
                                <TextBlock Text="Pays"/>
                                <TextBox Text="{Binding BuildingCountry, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Choisir un logo" Command="{Binding ChooseLogoCommand}" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding LogoPath}" VerticalAlignment="Center" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Etape 2 -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                        <TextBlock Text="Informations de l'entreprise" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Email entreprise"/>
                                <TextBox Text="{Binding CompanyEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Téléphone"/>
                                <TextBox Text="{Binding CompanyPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,8">
                                <TextBlock Text="Site web"/>
                                <TextBox Text="{Binding CompanyWebsite, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,8">
                                <TextBlock Text="Identifiant administratif (RCCM/ID Nat.)"/>
                                <TextBox Text="{Binding CompanyNationalId, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Etape 3 -->
                    <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                        <TextBlock Text="Choisir le thème visuel" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,8">
                                <TextBlock Text="Mode"/>
                                <ComboBox ItemsSource="{Binding ThemeModes}" SelectedItem="{Binding SelectedThemeMode}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,8">
                                <TextBlock Text="Couleur principale"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedPrimaryColor}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,8,8">
                                <TextBlock Text="Couleur menu"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedSidebarColor}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,8,0,8">
                                <TextBlock Text="Couleur secondaire"/>
                                <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedSecondaryColor}" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                            <TextBlock Text="Après validation, vous pourrez vous connecter immédiatement avec le compte administrateur créé."
                                       Foreground="#14532D" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SetupStatus}" Foreground="#166534" VerticalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="Annuler" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                        Background="#0F172A" Foreground="White"/>
                <Button Content="Précédent" Command="{Binding PreviousCommand}" Margin="0,0,8,0"
                        Background="#E2E8F0" Foreground="#0F172A"/>
                <Button Content="Suivant" Command="{Binding NextCommand}" Margin="0,0,8,0"
                        Background="#2D6A4F" Foreground="White"/>
                <Button Content="Terminer" Command="{Binding FinishCommand}" Background="#16A34A" Foreground="White"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
