<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.LocationsListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="#F5F7FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:TabIndexActiveConverter x:Key="TabIndexActiveConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

            <Style x:Key="StatusBadgeBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>

            <Style x:Key="RowActionsPanel" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1" Padding="20,16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Voir les locations" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="{Binding PageSubtitle}" FontSize="12" Foreground="#7A8699" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox Width="220" Margin="0,0,8,0" Style="{StaticResource LocationsFilterSearch}"
                             materialDesign:HintAssist.Hint="Rechercher..."
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    <ComboBox Width="150" Margin="0,0,8,0" Style="{StaticResource LocationsFilterCombo}"
                              ItemsSource="{Binding CurrentStatusFilters}" SelectedItem="{Binding FilterStatus}"/>
                    <Button Command="{Binding LoadCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0" Content="Actualiser"/>
                    <Button Command="{Binding CreateForTabCommand}" Style="{StaticResource LocationsPrimaryButton}" Padding="14,8"
                            Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,6,0"/>
                            <TextBlock Text="Créer"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Onglets -->
        <Border Grid.Row="1" Background="White" CornerRadius="14,14,0,0" BorderBrush="#E5EAF2" BorderThickness="1,1,1,0" Padding="12,8,12,0" Margin="0,0,0,0">
            <ItemsControl ItemsSource="{Binding ListTabs}" AlternationCount="99">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding DataContext.SetTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                Content="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource LocationsMainTabButton}">
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource TabIndexActiveConverter}">
                                                    <Binding Path="DataContext.SelectedTab" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="Foreground" Value="#2D6A4F"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="BorderBrush" Value="#2D6A4F"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Tableaux (TabControl : un seul grille active → en-têtes stables entre onglets) -->
        <Border Grid.Row="2" Background="White" CornerRadius="0,0,14,14" BorderBrush="#E5EAF2" BorderThickness="1" Padding="12">
            <TabControl SelectedIndex="{Binding SelectedTab, Mode=TwoWay}"
                        Background="Transparent" BorderThickness="0" Padding="0">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </TabControl.Template>

            <TabItem Header="Contrats">
                <DataGrid ItemsSource="{Binding Contracts}" Style="{StaticResource LocationsDataGrid}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="10,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N° CONTRAT" Binding="{Binding ContractNumber}" Width="110"/>
                        <DataGridTextColumn Header="LOCATAIRE" Binding="{Binding TenantName}" Width="1.4*" MinWidth="130"/>
                        <DataGridTextColumn Header="LOCAL" Binding="{Binding PremiseLabel}" Width="1.6*" MinWidth="150"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding ContractType}" Width="1.2*" MinWidth="120"/>
                        <DataGridTextColumn Header="DÉBUT" Binding="{Binding StartDisplay}" Width="90"/>
                        <DataGridTextColumn Header="FIN" Binding="{Binding EndDisplay}" Width="90"/>
                        <DataGridTextColumn Header="LOYER" Binding="{Binding RentDisplay}" Width="110"/>
                        <DataGridTemplateColumn Header="STATUT" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeBorder}"
                                            Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="{Binding StatusBadgeForeground, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="220">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource RowActionsPanel}">
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Voir"
                                                Command="{Binding DataContext.ViewContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Fiche locataire"
                                                Command="{Binding DataContext.OpenTenantFromContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="AccountOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Modifier"
                                                Command="{Binding DataContext.EditContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="PDF"
                                                Command="{Binding DataContext.ViewContractPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeleteContractCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="*" MinWidth="8" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource LocationsDataGridFillerCell}"/>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Locaux">
                <DataGrid ItemsSource="{Binding Premises}" Style="{StaticResource LocationsDataGrid}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="10,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="RÉFÉRENCE" Binding="{Binding Code}" Width="100"/>
                        <DataGridTextColumn Header="NOM" Binding="{Binding Name}" Width="1.2*" MinWidth="120"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding PremiseType}" Width="110"/>
                        <DataGridTextColumn Header="BÂTIMENT" Binding="{Binding Building}" Width="1*" MinWidth="100"/>
                        <DataGridTextColumn Header="ÉTAGE" Binding="{Binding Floor}" Width="80"/>
                        <DataGridTextColumn Header="SURFACE" Binding="{Binding AreaDisplay}" Width="90"/>
                        <DataGridTextColumn Header="LOYER" Binding="{Binding RentDisplay}" Width="110"/>
                        <DataGridTextColumn Header="LOCATAIRE" Binding="{Binding TenantName}" Width="1.2*" MinWidth="120"/>
                        <DataGridTemplateColumn Header="DISPONIBILITÉ" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeBorder}"
                                            Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="{Binding StatusBadgeForeground, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource RowActionsPanel}">
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Voir"
                                                Command="{Binding DataContext.ViewPremiseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Modifier"
                                                Command="{Binding DataContext.EditPremiseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeletePremiseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="*" MinWidth="8" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource LocationsDataGridFillerCell}"/>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Paiements">
                <DataGrid ItemsSource="{Binding Payments}" Style="{StaticResource LocationsDataGrid}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="10,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="LOCATAIRE" Binding="{Binding TenantName}" Width="1.3*" MinWidth="120"/>
                        <DataGridTextColumn Header="LOCAL" Binding="{Binding PremiseLabel}" Width="1.4*" MinWidth="140"/>
                        <DataGridTextColumn Header="PÉRIODE" Binding="{Binding PeriodDisplay}" Width="80"/>
                        <DataGridTextColumn Header="DÛ" Binding="{Binding AmountDisplay}" Width="100"/>
                        <DataGridTextColumn Header="PAYÉ" Binding="{Binding AmountPaidDisplay}" Width="100"/>
                        <DataGridTextColumn Header="ÉCHÉANCE" Binding="{Binding DueDisplay}" Width="95"/>
                        <DataGridTextColumn Header="DATE PAIEMENT" Binding="{Binding PaidDisplay}" Width="105"/>
                        <DataGridTextColumn Header="RETARD" Binding="{Binding LateLabel}" Width="70"/>
                        <DataGridTemplateColumn Header="STATUT" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeBorder}"
                                            Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   Foreground="{Binding StatusBadgeForeground, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource RowActionsPanel}">
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Voir"
                                                Command="{Binding DataContext.ViewPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Modifier"
                                                Command="{Binding DataContext.EditPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Quittance"
                                                Command="{Binding DataContext.GenerateReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Receipt" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="*" MinWidth="8" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource LocationsDataGridFillerCell}"/>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Garanties">
                <DataGrid ItemsSource="{Binding Guarantees}" Style="{StaticResource LocationsDataGrid}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          materialDesign:DataGridAssist.CellPadding="10,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CONTRAT" Binding="{Binding ContractNumber}" Width="110"/>
                        <DataGridTextColumn Header="LOCATAIRE" Binding="{Binding TenantName}" Width="1.4*" MinWidth="130"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding TypeLabel}" Width="90"/>
                        <DataGridTextColumn Header="MONTANT" Binding="{Binding AmountDisplay}" Width="110"/>
                        <DataGridTextColumn Header="REMBOURSÉ" Binding="{Binding RefundedDisplay}" Width="110"/>
                        <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="95"/>
                        <DataGridTemplateColumn Header="STATUT" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeBorder}"
                                            Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusBadgeForeground, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource RowActionsPanel}">
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Voir"
                                                Command="{Binding DataContext.ViewGuaranteeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Modifier"
                                                Command="{Binding DataContext.EditGuaranteeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Rembourser"
                                                Command="{Binding DataContext.RefundGuaranteeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="CashRefund" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Supprimer"
                                                Command="{Binding DataContext.DeleteGuaranteeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="*" MinWidth="8" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource LocationsDataGridFillerCell}"/>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            </TabControl>
        </Border>

        <ProgressBar Grid.Row="2" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="#2D6A4F"/>

        <!-- Modales -->
        <Grid Grid.RowSpan="3">
            <!-- Local -->
            <Border Background="#80000000" Visibility="{Binding IsPremiseFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="{Binding PremiseFormTitle}" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="Code" Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                 IsReadOnly="{Binding IsEditMode}"/>
                        <TextBox materialDesign:HintAssist.Hint="Nom *" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Bâtiment" Text="{Binding FormBuilding, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Étage" Text="{Binding FormFloor, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Type" Text="{Binding FormType, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Loyer mensuel (FC)" Text="{Binding FormRentText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                                   Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler" Command="{Binding ClosePremiseFormCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0"/>
                            <Button Content="Enregistrer" Command="{Binding SavePremiseFormCommand}" Style="{StaticResource LocationsPrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Contrat -->
            <Border Background="#80000000" Visibility="{Binding IsContractFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Modifier le contrat" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="N° contrat" Text="{Binding FormContractNumber}" IsReadOnly="True" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding FormContractType}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Date début (jj/mm/aaaa)" Text="{Binding FormStartDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Date fin (jj/mm/aaaa)" Text="{Binding FormEndDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Loyer mensuel (FC)" Text="{Binding FormContractRentText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Caution (FC)" Text="{Binding FormDepositText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                                   Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler" Command="{Binding CloseContractFormCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0"/>
                            <Button Content="Enregistrer" Command="{Binding SaveContractFormCommand}" Style="{StaticResource LocationsPrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Paiement -->
            <Border Background="#80000000" Visibility="{Binding IsPaymentFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="Modifier le paiement" FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>
                        <TextBox materialDesign:HintAssist.Hint="Montant dû (FC)" Text="{Binding FormAmountDueText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Montant payé (FC)" Text="{Binding FormAmountPaidText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Échéance (jj/mm/aaaa)" Text="{Binding FormDueDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="Date paiement (jj/mm/aaaa)" Text="{Binding FormPaidDate, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding PaymentStatuses}" SelectedItem="{Binding FormPaymentStatus}" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                                   Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler" Command="{Binding ClosePaymentFormCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0"/>
                            <Button Content="Enregistrer" Command="{Binding SavePaymentFormCommand}" Style="{StaticResource LocationsPrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>

            <!-- Garantie -->
            <Border Background="#80000000" Visibility="{Binding IsGuaranteeFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Nouvelle garantie"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                            <Setter Property="Text" Value="Modifier la garantie"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="Locataire *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding GuaranteeTenants}" SelectedItem="{Binding FormSelectedTenant}" DisplayMemberPath="Label" Margin="0,0,0,10"/>

                        <StackPanel Visibility="{Binding FormSelectedTenant, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Contrat *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding TenantContractsForGuarantee}" SelectedItem="{Binding FormSelectedContract}"
                                      DisplayMemberPath="Label" Margin="0,0,0,10">
                                <ComboBox.Style>
                                    <Style TargetType="ComboBox">
                                        <Setter Property="IsEnabled" Value="True"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ComboBox.Style>
                            </ComboBox>
                            <TextBox materialDesign:HintAssist.Hint="Montant caution (FC) *" Text="{Binding FormGuaranteeAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding GuaranteeStatuses}" SelectedItem="{Binding FormGuaranteeStatus}" Margin="0,0,0,8"/>
                            <TextBox materialDesign:HintAssist.Hint="Notes" Text="{Binding FormGuaranteeNotes, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                        </StackPanel>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8"
                                Visibility="{Binding FormSelectedTenant, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="Sélectionnez un locataire pour choisir le contrat et saisir la garantie."
                                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                                   Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Annuler" Command="{Binding CloseGuaranteeFormCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0"/>
                            <Button Content="Enregistrer" Command="{Binding SaveGuaranteeFormCommand}" Style="{StaticResource LocationsPrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>
