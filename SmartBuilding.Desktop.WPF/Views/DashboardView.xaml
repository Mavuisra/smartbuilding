<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <Style x:Key="DashHeroCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DashKpiIconHost" TargetType="Border">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E0E8E6" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="CENTRE DE PILOTAGE" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,0,4"/>
                    <TextBlock Text="Tableau de bord" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Vue statistique en temps réel — loyers, dépenses et occupation"
                               Foreground="{StaticResource SbmsTextMutedBrush}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Recherche globale (locataire, local, fournisseur...)"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         VerticalAlignment="Center" Margin="16,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Margin="4,0">
                        <materialDesign:PackIcon Kind="Bell"/>
                    </Button>
                    <Border Background="#E63946" CornerRadius="8" Padding="5,1" Margin="-20,0,12,16" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SbmsAccentGreenBrush}">
                        <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <DatePicker SelectedDate="{Binding SelectedDate}" Margin="12,0,0,0" Width="140"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SbmsAccentGreenBrush}"
                           Margin="6,0,6,8" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                <!-- Bandeau statistiques clés -->
                <UniformGrid Columns="4" Margin="0,0,0,6">
                    <Border Style="{StaticResource DashHeroCard}" Background="#1B4332">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="Wallet" Foreground="#95D5B2" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Disponible ce mois" FontSize="11" Foreground="#D8F3DC"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AvailableBalanceDisplay}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="{Binding NetBalanceDisplay, StringFormat=Solde net : {0}}" FontSize="10" Foreground="#A8C5C0" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashHeroCard}" Background="#166534">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="CashCheck" Foreground="#BBF7D0" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Taux d'encaissement" FontSize="11" Foreground="#DCFCE7"/>
                            </StackPanel>
                            <TextBlock Text="{Binding RentCollectionRateDisplay}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <ProgressBar Value="{Binding RentCollectionRate}" Maximum="100" Height="6" Margin="0,8,0,0"
                                           Foreground="#BBF7D0" Background="#14532D"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashHeroCard}" Background="#9A3412">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="TrendingDown" Foreground="#FED7AA" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Dépenses du mois" FontSize="11" Foreground="#FFEDD5"/>
                            </StackPanel>
                            <TextBlock Text="{Binding MonthlyExpensesDisplay}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Engagements validés" FontSize="10" Foreground="#FDBA74" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource DashHeroCard}" Background="#1D3557">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <materialDesign:PackIcon Kind="OfficeBuilding" Foreground="#BFDBFE" Width="20" Height="20" Margin="0,0,8,0"/>
                                <TextBlock Text="Occupation" FontSize="11" Foreground="#DBEAFE"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary.OccupancyRate, StringFormat={}{0:F1} %}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock FontSize="10" Foreground="#93C5FD" Margin="0,4,0,0">
                                <Run Text="{Binding Summary.OccupiedPremises}"/><Run Text=" / "/><Run Text="{Binding Summary.TotalPremises}"/><Run Text=" locaux occupés"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 8 KPI avec icônes -->
                <UniformGrid Columns="4" Margin="0,0,0,4">
                    <Border Style="{StaticResource SbmsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource DashKpiIconHost}" Background="#E8F5EE">
                                <materialDesign:PackIcon Kind="CurrencyUsd" Foreground="#2D6A4F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Revenus loyers (mois)" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Text="{Binding MonthlyRevenueDisplay}" FontSize="20" FontWeight="Bold" Foreground="#2D6A4F"/>
                                <TextBlock Text="{Binding RentSubtitleDisplay}" FontSize="9" Foreground="#64748B" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SbmsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource DashKpiIconHost}" Background="#E0E7FF">
                                <materialDesign:PackIcon Kind="Door" Foreground="#1D3557" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Locaux" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Text="{Binding Summary.TotalPremises}" FontSize="20" FontWeight="Bold" Foreground="#1D3557"/>
                                <TextBlock Text="Parc immobilier" FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SbmsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource DashKpiIconHost}" Background="#FEE2E2">
                                <materialDesign:PackIcon Kind="ClockAlert" Foreground="#E63946" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Loyers en retard" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Text="{Binding RentLateDisplay}" FontSize="20" FontWeight="Bold" Foreground="#E63946"/>
                                <TextBlock Text="{Binding RentCollectedDisplay, StringFormat=Encaissés : {0}}" FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SbmsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource DashKpiIconHost}" Background="#FFEDD5">
                                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#F77F00" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Incidents ouverts" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Text="{Binding Summary.OpenIncidents}" FontSize="20" FontWeight="Bold" Foreground="#F77F00"/>
                                <TextBlock Text="À traiter" FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SbmsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource DashKpiIconHost}" Background="#F3E8FF">
                                <materialDesign:PackIcon Kind="Wrench" Foreground="#7B2CBF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Maintenances" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Text="{Binding Summary.PendingMaintenance}" FontSize="20" FontWeight="Bold" Foreground="#7B2CBF"/>
                                <TextBlock Text="Planifiées" FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SbmsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource DashKpiIconHost}" Background="#DBEAFE">
                                <materialDesign:PackIcon Kind="FileDocument" Foreground="#0077B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Contrats actifs" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Text="{Binding Summary.ActiveLeases}" FontSize="20" FontWeight="Bold" Foreground="#0077B6"/>
                                <TextBlock Text="Locations en cours" FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SbmsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource DashKpiIconHost}" Background="#E8F5EE">
                                <materialDesign:PackIcon Kind="Bank" Foreground="#1B3D3B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Disponible ce mois" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Text="{Binding AvailableBalanceDisplay}" FontSize="20" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="{Binding RentCollectedTotalDisplay, StringFormat=Total encaissé : {0}}" FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SbmsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource DashKpiIconHost}" Background="#FEF3C7">
                                <materialDesign:PackIcon Kind="ChartPie" Foreground="#6A4C3A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Taux occupation" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Text="{Binding Summary.OccupancyRate, StringFormat={}{0:F1} %}" FontSize="20" FontWeight="Bold" Foreground="#6A4C3A"/>
                                <TextBlock Text="Taux de remplissage" FontSize="9" Foreground="#64748B" Margin="0,4,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Graphiques principaux : 6 mois + encaissement -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SbmsPanelCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Loyers vs dépenses — 6 derniers mois" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left"/>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                    <Border Background="#E8F5EE" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                                        <TextBlock Text="Loyers" FontSize="10" Foreground="#166534" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Background="#FEE2E2" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="Dépenses" FontSize="10" Foreground="#991B1B" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                            </DockPanel>
                            <lvc:CartesianChart Series="{Binding RevenueExpenseSeries}" Height="220"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SbmsPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Encaissement loyers (mois)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding RentCollectionRateDisplay}" FontSize="28" FontWeight="Bold" Foreground="#2D6A4F" HorizontalAlignment="Center"/>
                            <lvc:CartesianChart Series="{Binding RentCollectionSeries}" Height="160" Margin="0,8,0,0"/>
                            <TextBlock Text="Vert = encaissé · Clair = prévu · Rouge = retard" FontSize="10"
                                       Foreground="{StaticResource SbmsTextMutedBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Ligne graphiques détaillés -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SbmsPanelCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="Tendance financière" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left"/>
                                <Button Content="Synchroniser" Command="{Binding SyncNowCommand}"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" DockPanel.Dock="Right" Height="28" Padding="8,0"/>
                            </DockPanel>
                            <TextBlock Text="Solde net journalier — 7 derniers jours" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding FinanceTrendSeries}" Height="200"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SbmsPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Top dépenses (mois)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <lvc:CartesianChart Series="{Binding TopExpenseSeries}" Height="200"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SbmsPanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Répartition dépenses" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <lvc:PieChart Series="{Binding ExpensePieSeries}" Height="130"/>
                            </StackPanel>
                            <Border Grid.Row="1" Height="1" Background="#E2E8F0" Margin="0,8"/>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Statut des locaux" FontWeight="SemiBold" FontSize="14" Margin="0,8,0,4"/>
                                <TextBlock HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <Run Text="{Binding Summary.OccupancyRate, StringFormat={}{0:F0}}" FontSize="20" FontWeight="Bold" Foreground="#2D6A4F"/>
                                    <Run Text=" % occupés" FontSize="12" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                </TextBlock>
                                <lvc:PieChart Series="{Binding OccupancySeries}" Height="110"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Table + alertes -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SbmsPanelCard}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <TextBlock Text="Derniers mouvements financiers" FontWeight="SemiBold" FontSize="14" DockPanel.Dock="Left"/>
                                <TextBlock Text="Montants en USD" FontSize="11" Foreground="#64748B" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DataGrid ItemsSource="{Binding RecentMovements}" Style="{StaticResource SbmsDataGrid}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal" CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="38">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                                    <DataGridTemplateColumn Header="Type" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Type}" Value="IN">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Type}" FontWeight="SemiBold" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#991B1B"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="IN">
                                                                        <Setter Property="Foreground" Value="#166534"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="*"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Montant" Binding="{Binding AmountDisplay}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="#1B3D3B"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Réf." Binding="{Binding Reference}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SbmsPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Alertes récentes" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding Alerts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderThickness="1" BorderBrush="#E2E8F0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F8FAF9"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                            <Setter Property="Background" Value="#FEF2F2"/>
                                                            <Setter Property="BorderBrush" Value="#FECACA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                            <Setter Property="Background" Value="#FFFBEB"/>
                                                            <Setter Property="BorderBrush" Value="#FDE68A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                            <Setter Property="Background" Value="#F0FDF4"/>
                                                            <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                <TextBlock Text="{Binding Message}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm}" FontSize="10" Foreground="#AAA" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Activité + stats -->
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SbmsPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Activité récente" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding RecentActivity}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Ellipse Width="8" Height="8" Fill="{StaticResource SbmsAccentGreenBrush}" Margin="0,6,10,0"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12"/>
                                                <TextBlock Text="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm}" FontSize="10" Foreground="#AAA"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SbmsPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Statistiques rapides" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                            <ItemsControl ItemsSource="{Binding QuickStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F8FAFC" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource SbmsTextMutedBrush}" DockPanel.Dock="Left" FontSize="12"/>
                                                <TextBlock Text="{Binding Value}" FontWeight="Bold" DockPanel.Dock="Right" FontSize="12" Foreground="#1B3D3B"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
