<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.SettingsBuildingsApartmentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10"
                Padding="14,12" Margin="0,0,0,16"
                Visibility="{Binding PropertyStructureError, Converter={StaticResource NullToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#DC2626" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding PropertyStructureError}" Foreground="#DC2626" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Command="{Binding AddPropertyFloorCommand}"
                    Style="{StaticResource PropertyStructPrimaryButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Plus" Foreground="White" Width="18" Height="18" Margin="0,0,8,0"/>
                    <TextBlock Text="Ajouter un étage" Foreground="White"/>
                </StackPanel>
            </Button>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Étages et locaux" FontSize="15" FontWeight="Bold" Foreground="{StaticResource PatrimoineGelTextBrush}"/>
                <TextBlock Text="Structure de Bloom Prosperity" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <ItemsControl ItemsSource="{Binding PropertyFloors}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PropertyStructFloorCard}" Margin="0,0,0,12">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,14">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.AddPropertyApartmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PropertyStructSecondaryButton}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Door" Foreground="White" Width="16" Height="16" Margin="0,0,6,0"/>
                                            <TextBlock Text="Ajouter un local" Foreground="White"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding DataContext.RemovePropertyFloorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PropertyStructDangerButton}" ToolTip="Supprimer cet étage">
                                        <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Stairs" Foreground="{StaticResource PatrimoineGelBrush}" Width="22" Height="22" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PatrimoineGelTextBrush}"/>
                                        <TextBlock FontSize="11" Foreground="#64748B">
                                            <Run Text="Niveau"/>
                                            <Run Text="{Binding LevelNumberText}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Niveau" Style="{StaticResource SettingsFieldLabel}"/>
                                    <TextBox Text="{Binding LevelNumberText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Libellé (ex. RDC, 1er)" Style="{StaticResource SettingsFieldLabel}"/>
                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding Apartments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource PropertyStructUnitCard}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                                        <TextBlock Text="Code" Style="{StaticResource SettingsFieldLabel}"/>
                                                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="4,0,4,10">
                                                        <TextBlock Text="Nom du local" Style="{StaticResource SettingsFieldLabel}"/>
                                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,10">
                                                        <TextBlock Text="Type" Style="{StaticResource SettingsFieldLabel}"/>
                                                        <ComboBox ItemsSource="{Binding DataContext.UnitTypeChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding UnitType}"
                                                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Surface (m²)" Style="{StaticResource SettingsFieldLabel}"/>
                                                        <TextBox Text="{Binding AreaSqMText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="4,0,4,0">
                                                        <TextBlock Text="Loyer (USD)" Style="{StaticResource SettingsFieldLabel}"/>
                                                        <TextBox Text="{Binding MonthlyRentText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Button Grid.Column="1" VerticalAlignment="Top"
                                                        Command="{Binding DataContext.RemovePropertyApartmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource PropertyStructDangerButton}" Margin="8,0,0,0">
                                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
