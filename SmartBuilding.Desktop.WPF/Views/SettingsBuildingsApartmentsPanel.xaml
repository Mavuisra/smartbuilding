<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.SettingsBuildingsApartmentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,8,24">
        <StackPanel>
            <!-- En-tête -->
            <Border Background="{StaticResource PatrimoineGelSoftBrush}" CornerRadius="14" Padding="22,20" Margin="0,0,0,20"
                    BorderBrush="#4cc26b" BorderThickness="0,0,0,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{StaticResource PatrimoineGelLightBrush}" CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="HomeGroup" Width="26" Height="26" Foreground="{StaticResource PatrimoineGelBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Plan du bâtiment" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PatrimoineGelTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="Définissez les étages, les appartements ou locaux commerciaux, et les pièces de chaque logement."
                                   FontSize="12" Foreground="{StaticResource PatrimoineGelMutedBrush}" TextWrapping="Wrap" MaxWidth="520" Margin="56,0,0,0"/>
                        <TextBlock Text="{Binding StructureSummaryLine}" FontWeight="SemiBold" Foreground="{StaticResource PatrimoineGelBrush}"
                                   FontSize="12" Margin="56,12,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding AddPropertyFloorCommand}"
                            Style="{StaticResource PropertyStructPrimaryButton}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Foreground="White" Width="18" Height="18" Margin="0,0,8,0"/>
                            <TextBlock Text="Nouvel étage" Foreground="White"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10"
                    Padding="14,12" Margin="0,0,0,18"
                    Visibility="{Binding PropertyStructureError, Converter={StaticResource NullToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle" Foreground="#DC2626" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding PropertyStructureError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- KPI -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <Border Style="{StaticResource PropertyStructKpiChip}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ÉTAGES" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding BuildingFloors}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PatrimoineGelBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PropertyStructKpiChip}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="APPARTEMENTS" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ApartmentCount}" FontSize="26" FontWeight="Bold" Foreground="{StaticResource PatrimoineGelBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PropertyStructKpiChip}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="COMMERCES" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding CommercialUnitCount}" FontSize="26" FontWeight="Bold" Foreground="#6B8299" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource PropertyStructKpiChip}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="TOTAL LOCAUX" FontSize="10" FontWeight="Bold" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalPremisesConfig}" FontSize="26" FontWeight="Bold" Foreground="#0F172A" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Étages -->
            <ItemsControl ItemsSource="{Binding PropertyFloors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PropertyStructFloorCard}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,18">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Command="{Binding DataContext.AddPropertyApartmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PropertyStructSecondaryButton}" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="HomePlus" Foreground="White" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="Ajouter une unité" Foreground="White"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding DataContext.RemovePropertyFloorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PropertyStructDangerButton}" ToolTip="Supprimer cet étage">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="16" Height="16" Margin="0,0,4,0"/>
                                                <TextBlock Text="Supprimer"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{StaticResource PatrimoineGelLightBrush}" CornerRadius="10" Width="48" Height="48" Margin="0,0,14,0"
                                                BorderBrush="#D4EDDC" BorderThickness="1">
                                            <materialDesign:PackIcon Kind="Stairs" Foreground="{StaticResource PatrimoineGelBrush}" Width="26" Height="26"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="Étage" FontSize="11" Foreground="{StaticResource PatrimoineGelMutedBrush}"/>
                                            <TextBlock Text="{Binding Label}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PatrimoineGelTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="Niveau (0 = RDC)" Style="{StaticResource SettingsFieldLabel}"/>
                                        <TextBox Text="{Binding LevelNumberText, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Libellé affiché" Style="{StaticResource SettingsFieldLabel}"/>
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="Unités sur cet étage" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource PatrimoineGelTextBrush}" Margin="0,0,0,12"/>

                                <ItemsControl ItemsSource="{Binding Apartments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PropertyStructUnitCard}">
                                                <StackPanel>
                                                    <DockPanel Margin="0,0,0,16">
                                                        <Button DockPanel.Dock="Right"
                                                                Command="{Binding DataContext.RemovePropertyApartmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource PropertyStructDangerButton}">
                                                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                                                        </Button>
                                                        <StackPanel Orientation="Horizontal">
                                                            <materialDesign:PackIcon Kind="Door" Foreground="#2D6A4F" Width="22" Height="22" Margin="0,0,10,0"/>
                                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                                            <Border Background="#E0E7FF" CornerRadius="6" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding UnitType}" FontSize="10" FontWeight="SemiBold" Foreground="#3730A3"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </DockPanel>

                                                    <Grid Margin="0,0,0,16">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                                            <TextBlock Text="Code" Style="{StaticResource SettingsFieldLabel}"/>
                                                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                                            <TextBlock Text="Type" Style="{StaticResource SettingsFieldLabel}"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.UnitTypeChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding UnitType}"
                                                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                                            <TextBlock Text="Surface (m²)" Style="{StaticResource SettingsFieldLabel}"/>
                                                            <TextBox Text="{Binding AreaSqMText, UpdateSourceTrigger=PropertyChanged}"
                                                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <StackPanel Margin="0,0,0,8" MaxWidth="280" HorizontalAlignment="Left">
                                                        <TextBlock Text="Loyer indicatif (USD)" Style="{StaticResource SettingsFieldLabel}"/>
                                                        <TextBox Text="{Binding MonthlyRentText, UpdateSourceTrigger=PropertyChanged}"
                                                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding IsResidential, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <DockPanel Margin="0,8,0,10">
                                                            <TextBlock Text="Pièces du logement" FontWeight="SemiBold" Foreground="{StaticResource PatrimoineGelTextBrush}" VerticalAlignment="Center" FontSize="13"/>
                                                            <Button DockPanel.Dock="Right"
                                                                    Command="{Binding DataContext.AddPropertyRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource PropertyStructPrimaryButton}" Padding="14,8">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon Kind="Plus" Foreground="White" Width="14" Height="14" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="Pièce" Foreground="White" FontSize="12"/>
                                                                </StackPanel>
                                                            </Button>
                                                        </DockPanel>

                                                        <Border Background="White" CornerRadius="10" BorderBrush="#D4EDDC" BorderThickness="1" Padding="2">
                                                        <DataGrid ItemsSource="{Binding Rooms}" Style="{StaticResource PropertyStructRoomsGrid}"
                                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                                  IsReadOnly="False" materialDesign:DataGridAssist.CellPadding="10,8">
                                                            <DataGrid.Columns>
                                                                <DataGridTemplateColumn Header="NOM" Width="*">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Style="{StaticResource PropertyStructRoomCellTextBox}"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="TYPE" Width="180" MinWidth="160">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <ComboBox ItemsSource="{Binding DataContext.RoomTypeChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                      SelectedItem="{Binding RoomType, UpdateSourceTrigger=PropertyChanged}"
                                                                                      Style="{StaticResource PropertyStructRoomCellComboBox}"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="M²" Width="100" MinWidth="90">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <TextBox Text="{Binding AreaSqMText, UpdateSourceTrigger=PropertyChanged}"
                                                                                     Style="{StaticResource PropertyStructRoomCellTextBox}"
                                                                                     HorizontalContentAlignment="Right"/>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                                <DataGridTemplateColumn Header="ACTION" Width="72">
                                                                    <DataGridTemplateColumn.CellTemplate>
                                                                        <DataTemplate>
                                                                            <Button Command="{Binding DataContext.RemovePropertyRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Style="{StaticResource PropertyStructRoomDeleteButton}">
                                                                                <materialDesign:PackIcon Kind="TrashCanOutline" Foreground="#A67B7B" Width="22" Height="22"/>
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </DataGridTemplateColumn.CellTemplate>
                                                                </DataGridTemplateColumn>
                                                            </DataGrid.Columns>
                                                        </DataGrid>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Background="{StaticResource PatrimoineGelLightBrush}" BorderBrush="#D4EDDC" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="InformationOutline" Foreground="{StaticResource PatrimoineGelBrush}" Margin="0,0,12,0"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource PatrimoineGelTextBrush}" FontSize="12">
                        <Run Text="Enregistrez via le bouton « Enregistrer la société » en bas de la page."/>
                        <LineBreak/>
                        <Run Text="Les unités sont synchronisées automatiquement dans le module Location."/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
