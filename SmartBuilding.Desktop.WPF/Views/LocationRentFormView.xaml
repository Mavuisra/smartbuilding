<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.LocationRentFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="#F5F7FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20,14" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding GoBackCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,6,0"/>
                        <TextBlock Text="Retour"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding Breadcrumb}" FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="#111827"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid MaxWidth="920" HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>

                <!-- Sélection locataire / local -->
                <Border Grid.Column="0" Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1" Padding="24,22" Margin="0,0,12,0">
                    <StackPanel>
                        <Border Background="#E8F5EE" CornerRadius="10" Padding="14" Margin="0,0,0,18">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCash" Width="28" Height="28" Foreground="#2D6A4F" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock Text="Étape 1 — Qui paie ?" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                    <TextBlock Text="Choisissez le locataire, puis le local concerné." FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                                Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                        </Border>

                        <TextBlock Text="Locataire *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding Tenants}" SelectedItem="{Binding SelectedTenant}" DisplayMemberPath="Label"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding SelectedTenant, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="Local / bien *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding TenantPremises}" SelectedItem="{Binding SelectedPremise}" DisplayMemberPath="Label"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>
                            <TextBlock Text="{Binding ContractSummary}" FontSize="12" Foreground="#2D6A4F" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,8,0,0"
                                Visibility="{Binding SelectedTenant, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="Les détails du local et du paiement s'afficheront après la sélection du locataire."
                                       Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Formulaire paiement -->
                <Border Grid.Column="1" Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1" Padding="24,22">
                    <StackPanel>
                        <TextBlock Text="Détails du paiement" FontSize="17" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,16"/>

                        <StackPanel Visibility="{Binding CanShowPaymentDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,14"
                                    Background="#FEF3C7" BorderBrush="#FCD34D" BorderThickness="1"
                                    Visibility="{Binding IsMonthFullyPaid, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#B45309" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding PeriodPaymentSummary}" Foreground="#92400E" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="10" Padding="12,10" Margin="0,0,0,14"
                                    Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1"
                                    Visibility="{Binding IsMonthFullyPaid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                <TextBlock Text="{Binding PeriodPaymentSummary}" Foreground="#1E40AF" FontSize="12" TextWrapping="Wrap"/>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="Montant à payer (FC) *" Style="{StaticResource LocationFieldLabel}"/>
                                    <TextBox Text="{Binding FormAmountText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Date de paiement *" Style="{StaticResource LocationFieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding FormPaymentDate}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="Mois *" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding FormMonth}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Année *" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding YearOptions}" SelectedItem="{Binding FormYear}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,12">
                                    <TextBlock Text="Mode de paiement *" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding FormPaymentMethod}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="2" Grid.Column="1" Margin="8,0,0,12">
                                    <TextBlock Text="Statut du paiement *" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PaymentStatuses}" SelectedItem="{Binding FormPaymentStatus}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="Référence / n° transaction" Style="{StaticResource LocationFieldLabel}"/>
                                    <TextBox Text="{Binding FormTransactionReference, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Ex. TRX-2026-0042"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="Générer la quittance PDF après validation" IsChecked="{Binding GenerateReceipt}" Margin="0,8,0,20"/>

                            <Button Command="{Binding SaveCommand}" Style="{StaticResource LocationsPrimaryButton}" Padding="20,12" HorizontalAlignment="Stretch"
                                    IsEnabled="{Binding CanRecordPayment}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Margin="0,0,8,0"/>
                                    <TextBlock Text="Valider le paiement" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="20"
                                Visibility="{Binding CanShowPaymentDetails, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="Complétez la sélection du locataire et du local pour accéder au formulaire de paiement."
                                       Foreground="#64748B" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="#2D6A4F"/>
    </Grid>
</UserControl>
