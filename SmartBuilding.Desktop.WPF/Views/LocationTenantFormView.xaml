<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.LocationTenantFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" Padding="20,14" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding GoBackCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,6,0"/>
                        <TextBlock Text="Retour aux locations"/>
                    </StackPanel>
                </Button>
                <StackPanel>
                    <TextBlock Text="{Binding Breadcrumb}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <Border Background="White" CornerRadius="12" BorderBrush="#E8EFED" BorderThickness="1"
                    Padding="32,28" MaxWidth="800" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Fiche locataire" FontSize="16" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,20"/>
                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16"
                            Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                    </Border>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}" IsReadOnly="True"
                                     materialDesign:HintAssist.Hint="N° dossier" Text="{Binding FormDossier}"/>
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Nom complet *" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Téléphone *" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Email" Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Entreprise" Text="{Binding FormCompany, UpdateSourceTrigger=PropertyChanged}"/>
                            <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" materialDesign:HintAssist.Hint="Statut location"
                                      ItemsSource="{Binding TenantStatusChoices}" SelectedItem="{Binding FormStatus}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Adresse" Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Nationalité" Text="{Binding FormNationality, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Profession" Text="{Binding FormProfession, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Contact urgence (nom)" Text="{Binding FormEmergencyName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Margin="0,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Contact urgence (tél.)" Text="{Binding FormEmergencyPhone, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" MinHeight="80"
                                     materialDesign:HintAssist.Hint="Remarques administratives" Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Command="{Binding GoBackCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Padding="24,12" Margin="0,0,12,0" Content="Annuler"/>
                        <Button Command="{Binding SaveCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" Padding="28,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountCheck" Margin="0,0,8,0"/>
                                <TextBlock Text="Enregistrer le locataire"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="{StaticResource SbmsAccentGreenBrush}"/>
    </Grid>
</UserControl>
