<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.LocationTenantFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="#F5F7FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

            <Style x:Key="TenantFormHeader" TargetType="Border" BasedOn="{StaticResource LocationsBwFormHeader}">
                <Setter Property="Background" Value="#1B3D3B"/>
            </Style>
            <Style x:Key="TenantFormCard" TargetType="Border" BasedOn="{StaticResource LocationsBwFormCard}">
                <Setter Property="BorderBrush" Value="#2D6A4F"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>
            <Style x:Key="DependentRowCard" TargetType="Border">
                <Setter Property="Background" Value="#F8FAFC"/>
                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="20,14" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding GoBackCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,6,0"/>
                        <TextBlock Text="Retour"/>
                    </StackPanel>
                </Button>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Breadcrumb}" FontSize="11" Foreground="#7A8699"/>
                    <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <Border Style="{StaticResource TenantFormCard}" MaxWidth="1000" HorizontalAlignment="Stretch" Margin="0,0,0,24">
                <StackPanel>
                    <Border Style="{StaticResource TenantFormHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountEdit" Foreground="White" Width="22" Height="22" Margin="0,0,10,0"/>
                                    <TextBlock Text="Fiche locataire" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                                <TextBlock Text="Identité, situation familiale, coordonnées et foyer"
                                           Foreground="#A7F3D0" FontSize="12" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#FFFFFF22" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormDossier}" Foreground="White" FontFamily="Consolas" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="16,14,16,0"
                            Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#DC2626" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="16,14,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource LocationsBwFormSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="BadgeAccount" Foreground="#2D6A4F" Margin="0,0,8,0"/>
                                    <TextBlock Text="Identité" Style="{StaticResource LocationsBwFormSectionTitle}" Margin="0"/>
                                </StackPanel>
                                <UniformGrid Columns="2">
                                    <TextBox Margin="0,0,6,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Nom complet *" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Margin="6,0,0,10" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="Statut location"
                                              ItemsSource="{Binding TenantStatusChoices}" SelectedItem="{Binding FormStatus}"/>
                                    <ComboBox Margin="0,0,6,10" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                              materialDesign:HintAssist.Hint="Type de locataire"
                                              ItemsSource="{Binding TenantCategoryChoices}" SelectedItem="{Binding FormTenantCategory}"/>
                                    <TextBox Margin="6,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Date de naissance (jj/mm/aaaa)" Text="{Binding FormDateOfBirthText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="0,0,6,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Téléphone *" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="6,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Email" Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"/>
                                </UniformGrid>
                                <TextBox Margin="0,0,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Entreprise / employeur déclaré" Text="{Binding FormCompany, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource LocationsBwFormSection}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <materialDesign:PackIcon Kind="MapMarker" Foreground="#2D6A4F" Margin="0,0,8,0"/>
                                    <TextBlock Text="Coordonnées &amp; pièces" Style="{StaticResource LocationsBwFormSectionTitle}" Margin="0"/>
                                </StackPanel>
                                <UniformGrid Columns="2">
                                    <TextBox Margin="0,0,6,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Adresse actuelle" Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="6,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Nationalité" Text="{Binding FormNationality, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="0,0,6,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="N° pièce d'identité" Text="{Binding FormNationalId, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="6,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Type de pièce" Text="{Binding FormIdDocumentType, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="0,0,6,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Expiration (jj/mm/aaaa)" Text="{Binding FormIdDocumentExpiryText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="6,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Tél. secondaire" Text="{Binding FormSecondaryPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="0,0,6,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Profession" Text="{Binding FormProfession, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="6,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Employeur" Text="{Binding FormEmployer, UpdateSourceTrigger=PropertyChanged}"/>
                                </UniformGrid>
                                <UniformGrid Columns="2" Margin="0,0,0,10">
                                    <TextBox Margin="0,0,6,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Urgence (nom)" Text="{Binding FormEmergencyName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Margin="6,0,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                             materialDesign:HintAssist.Hint="Urgence (tél.)" Text="{Binding FormEmergencyPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                </UniformGrid>
                                <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" AcceptsReturn="True" MinHeight="64"
                                         materialDesign:HintAssist.Hint="Remarques" Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Margin="16,14,16,0" Style="{StaticResource LocationsBwFormSection}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="HomeHeart" Foreground="#2D6A4F" Margin="0,0,8,0"/>
                                <TextBlock Text="Situation familiale" Style="{StaticResource LocationsBwFormSectionTitle}" Margin="0"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource LocationsBwFormSubtitle}" Margin="0,0,0,12"
                                       Text="Renseignez ces champs si le locataire a une famille (conjoint, enfants, taille du foyer)."/>
                            <UniformGrid Columns="3">
                                <ComboBox Margin="0,0,6,10" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="Genre"
                                          ItemsSource="{Binding GenderChoices}" SelectedItem="{Binding FormGender}"/>
                                <ComboBox Margin="6,0,6,10" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          materialDesign:HintAssist.Hint="État civil"
                                          ItemsSource="{Binding MaritalStatusChoices}" SelectedItem="{Binding FormMaritalStatus}"/>
                                <TextBox Margin="6,0,0,10" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Nombre d'enfants"
                                         Text="{Binding FormChildrenCountText, UpdateSourceTrigger=PropertyChanged}"/>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,10">
                                <TextBox Margin="0,0,6,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Conjoint(e) — nom"
                                         Text="{Binding FormSpouseName, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding ShowSpouseName, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBox Margin="6,0,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Activité / composition du foyer"
                                         Text="{Binding FormBusinessActivity, UpdateSourceTrigger=PropertyChanged}"/>
                            </UniformGrid>
                            <TextBox Style="{StaticResource MaterialDesignOutlinedTextBox}" MaxWidth="220" HorizontalAlignment="Left"
                                     materialDesign:HintAssist.Hint="Personnes au foyer (total)"
                                     Text="{Binding FormPersonCountText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border Margin="16,14,16,0" Style="{StaticResource LocationsBwFormSection}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="AccountHeart" Foreground="#2D6A4F" Margin="0,0,8,0"/>
                                    <TextBlock Text="Foyer — personnes à charge" Style="{StaticResource LocationsBwFormSectionTitle}" Margin="0"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding AddDependentCommand}" Style="{StaticResource LocationsPrimaryButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Ajouter une personne"/>
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10"
                                    Padding="16,12" Margin="0,0,0,10"
                                    Visibility="{Binding HasFamilyMembers, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AccountGroupOutline" Foreground="#94A3B8" Margin="0,0,10,0"/>
                                    <TextBlock Foreground="#64748B" TextWrapping="Wrap"
                                               Text="Aucune personne à charge renseignée. Cliquez sur « Ajouter une personne » si le locataire vit avec conjoint, enfants ou autres membres du foyer."/>
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Dependents}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DependentRowCard}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="110"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Grid.Column="0" Margin="0,0,8,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         materialDesign:HintAssist.Hint="Nom complet"
                                                         Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>
                                                <ComboBox Grid.Column="1" Margin="0,0,8,0" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                                          materialDesign:HintAssist.Hint="Lien"
                                                          ItemsSource="{Binding DataContext.DependentRelationshipChoices, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Relationship}"/>
                                                <TextBox Grid.Column="2" Margin="0,0,8,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         materialDesign:HintAssist.Hint="Naissance"
                                                         Text="{Binding DateOfBirthText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBox Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         materialDesign:HintAssist.Hint="N° pièce"
                                                         Text="{Binding NationalId, UpdateSourceTrigger=PropertyChanged}"/>
                                                <Button Grid.Column="4" Command="{Binding DataContext.RemoveDependentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Style="{StaticResource LocationsIconActionButton}" ToolTip="Retirer">
                                                    <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Foreground="#DC2626"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource LocationsBwFormSubtitle}"
                                       Text="Les contrats et paiements se gèrent dans Voir et Paiement loyer."/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource LocationsFormFooterBar}" Margin="0,8,0,0">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Command="{Binding GoBackCommand}" Style="{StaticResource LocationsToolbarButton}"
                                    Padding="18,10" Content="Annuler"/>
                            <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" Style="{StaticResource LocationsPrimaryButton}" Padding="22,11">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="18" Height="18" Margin="0,0,8,0"/>
                                    <TextBlock Text="Enregistrer le locataire" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="#2D6A4F"/>
    </Grid>
</UserControl>
