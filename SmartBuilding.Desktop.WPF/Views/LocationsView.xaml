<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.LocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="#F5F7FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:WizardStepCircleBrushConverter x:Key="WizardStepCircleBrushConverter"/>
            <conv:WizardStepTitleBrushConverter x:Key="WizardStepTitleBrushConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="22,14" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Nouveau contrat de location" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Locations  ›  Contrats  ›  Nouveau contrat" FontSize="12" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding LoadCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualiser"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddPremiseCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PlusBoxOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Ajouter espace"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding AddTenantCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlusOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Ajouter locataire"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding NextStepCommand}" Style="{StaticResource LocationsPrimaryButton}" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NextButtonLabel}"/>
                            <materialDesign:PackIcon Kind="ArrowRight" Width="15" Height="15" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="22,16,22,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="310"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                        <ItemsControl ItemsSource="{Binding WizardSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Index}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource WizardStepCircleBrushConverter}">
                                                        <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="Index"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource WizardStepTitleBrushConverter}">
                                                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            <Binding Path="Index"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#7A8699"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Étape 1 : Locataire -->
                    <Border Style="{StaticResource LocationPageCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                        <StackPanel>
                            <TextBlock Text="Informations du locataire" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                    <Border Width="96" Height="96" CornerRadius="48" Background="#EEF2F7" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Account" Width="42" Height="42" Foreground="#9AA6B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Command="{Binding AddTenantCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,12,0,0" Padding="8,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="AccountEditOutline" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Créer / modifier" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="Sélection du locataire" FontSize="13" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,10"/>
                                    <TextBlock Text="Nom complet *" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Tenants}" SelectedItem="{Binding SelectedTenant}" DisplayMemberPath="Name" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Grid.ColumnSpan="2" Margin="0,0,0,0"
                                            Visibility="{Binding SelectedTenant, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Informations du locataire sélectionné" FontSize="13" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="Dossier" Style="{StaticResource LocationFieldLabel}"/>
                                            <TextBox Text="{Binding SelectedTenant.DossierNumber, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Téléphone" Style="{StaticResource LocationFieldLabel}"/>
                                            <TextBox Text="{Binding SelectedTenant.Phone, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Email" Style="{StaticResource LocationFieldLabel}"/>
                                            <TextBox Text="{Binding SelectedTenant.Email, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Statut" Style="{StaticResource LocationFieldLabel}"/>
                                            <TextBox Text="{Binding SelectedTenant.RentalStatus, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                                            <TextBlock Text="Entreprise" Style="{StaticResource LocationFieldLabel}"/>
                                            <TextBox Text="{Binding SelectedTenant.Company, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <Border Grid.Column="2" Grid.ColumnSpan="2" Background="#F8FAFC" CornerRadius="8" Padding="16"
                                        Visibility="{Binding SelectedTenant, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <TextBlock Text="Sélectionnez un locataire pour afficher ses informations." Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Étape 2 : Appartement -->
                    <Border Style="{StaticResource LocationPageCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                        <StackPanel>
                            <TextBlock Text="Sélection de l'appartement / espace" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Filtres rapides" FontWeight="SemiBold" Foreground="#172033" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock Text="Bâtiment" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Buildings}" SelectedItem="{Binding FilterBuilding}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Type d'espace" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Types}" SelectedItem="{Binding FilterType}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,8"/>
                                    <TextBlock Text="Statut" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>
                                    <Button Command="{Binding LoadCommand}" Style="{StaticResource LocationsToolbarButton}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Réinitialiser"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <ListBox ItemsSource="{Binding Premises}" SelectedItem="{Binding SelectedPremise}" BorderThickness="0" Background="Transparent">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,12,12"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="165" Background="White" CornerRadius="12" Padding="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#DCE4EF"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#0B63F6"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Border Height="76" CornerRadius="9" Background="#E8EEF7" Margin="0,0,0,8">
                                                            <materialDesign:PackIcon Kind="OfficeBuilding" Width="34" Height="34" Foreground="#9AA6B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBackground}" CornerRadius="8" Padding="6,2">
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="{Binding StatusBadgeForeground}" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#172033" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Building}" FontSize="10" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Floor}" FontSize="10" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AreaDisplay}" FontSize="10" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding RentDisplay}" FontSize="11" FontWeight="Bold" Foreground="#0B63F6" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Background="#EEF5FF" BorderBrush="#BBD7FF" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Information" Width="16" Height="16" Foreground="#0B63F6" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SelectedPremiseSelectionSummary, Mode=OneWay}"
                                                       Foreground="#0B63F6" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Étape 3 : Contrat -->
                    <Border Style="{StaticResource LocationPageCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                        <StackPanel>
                            <TextBlock Text="Informations contrat" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="N° contrat (automatique)" Style="{StaticResource LocationFieldLabel}"/>
                                    <TextBox Text="{Binding FormContractNumber, Mode=OneWay}"
                                             IsReadOnly="True"
                                             IsTabStop="False"
                                             materialDesign:HintAssist.Hint="Attribué à l'enregistrement"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,10">
                                    <TextBlock Text="Date début *" Style="{StaticResource LocationFieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding ContractStart}" materialDesign:HintAssist.Hint="Date début"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,10">
                                    <TextBlock Text="Date fin *" Style="{StaticResource LocationFieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding ContractEnd}" materialDesign:HintAssist.Hint="Date fin"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,0,10">
                                    <TextBlock Text="Durée *" Style="{StaticResource LocationFieldLabel}"/>
                                    <TextBox Text="{Binding ContractDurationDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Type de contrat *" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding ContractType}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                                    <TextBlock Text="Loyer mensuel *" Style="{StaticResource LocationFieldLabel}"/>
                                    <TextBox Text="{Binding ContractRentText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4">
                                    <TextBlock Text="Clauses spéciales" Style="{StaticResource LocationFieldLabel}"/>
                                    <TextBox Text="{Binding ContractClauses, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" MinHeight="80" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Étape 4 : Garantie & Paiement -->
                    <Border Style="{StaticResource LocationPageCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                        <StackPanel>
                            <TextBlock Text="Garantie &amp; paiement" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Caution / garantie (USD)" Style="{StaticResource LocationFieldLabel}"/>
                                    <TextBox Text="{Binding ContractDepositText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Fréquence paiement *" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PaymentFrequencies}" SelectedItem="{Binding PaymentFrequency}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Mode paiement *" Style="{StaticResource LocationFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding PaymentMethod}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>
                                    <ToggleButton IsChecked="{Binding AutomaticRenewal}" Content="Renouvellement automatique" Margin="0,0,0,10"/>
                                    <TextBlock Text="Prochain paiement" Style="{StaticResource LocationFieldLabel}"/>
                                    <TextBox Text="{Binding NextPaymentDateDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Étape 5 : Documents — tout visible -->
                    <Border Style="{StaticResource LocationPageCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=4}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="720">
                            <StackPanel>
                                <TextBlock Text="Documents &amp; récapitulatif complet" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,14"/>
                                <TextBlock Text="Vérifiez l'ensemble des informations avant de créer le contrat." Foreground="#64748B" FontSize="12" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Locataire" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Nom"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding SelectedTenantName}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Téléphone"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding SelectedTenantPhone}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Email"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding SelectedTenantEmail}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Entreprise"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding SelectedTenantCompany}" Margin="0,0,0,16"/>
                                        <TextBlock Text="Espace" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Local"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding SelectedPremiseName}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Emplacement"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding SelectedPremiseSubtitle}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Surface"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding SelectedPremiseArea}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Contrat &amp; finances" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="N° contrat"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding FormContractNumber}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Type"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding ContractType}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Période"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Margin="0,0,0,8">
                                            <Run Text="{Binding ContractStart, StringFormat={}{0:dd/MM/yyyy}}"/>
                                            <Run Text=" → "/>
                                            <Run Text="{Binding ContractEnd, StringFormat={}{0:dd/MM/yyyy}}"/>
                                            <Run Text=" ("/><Run Text="{Binding ContractDurationDisplay, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Loyer mensuel"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding RentSummaryDisplay}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Garantie"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding DepositSummaryDisplay}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Fréquence / mode"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Margin="0,0,0,8">
                                            <Run Text="{Binding PaymentFrequency}"/><Run Text=" — "/><Run Text="{Binding PaymentMethod}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Renouvellement auto."/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding AutomaticRenewalDisplay}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource LocationSummaryLabel}" Text="Clauses spéciales"/>
                                        <TextBlock Style="{StaticResource LocationSummaryValue}" Text="{Binding ContractClauses}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <Border Background="#F8FAFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,8,0,0">
                                            <DockPanel>
                                                <TextBlock Text="Total mensuel" FontWeight="SemiBold"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding RentSummaryDisplay}" FontSize="18" FontWeight="Bold" Foreground="#0B63F6"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="16" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Résumé du contrat" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,18"/>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Locataire" FontWeight="Bold" Foreground="#172033"/>
                            <Button DockPanel.Dock="Right" Command="{Binding AddTenantCommand}" Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Content="Éditer"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="54" Height="54" CornerRadius="27" Background="#EEF2F7" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="Account" Width="26" Height="26" Foreground="#9AA6B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTenantName}" FontWeight="Bold" Foreground="#172033"/>
                                <TextBlock Text="{Binding SelectedTenantEmail}" Foreground="#667085" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTenantPhone}" Foreground="#667085" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Appartement" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="54" Height="48" CornerRadius="8" Background="#EEF2F7" Margin="0,0,12,0">
                                <materialDesign:PackIcon Kind="OfficeBuilding" Width="24" Height="24" Foreground="#9AA6B6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPremiseName}" FontWeight="Bold" Foreground="#172033"/>
                                <TextBlock Text="{Binding SelectedPremiseSubtitle}" Foreground="#667085" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedPremiseArea}" Foreground="#667085" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Contrat" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Type de contrat" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding ContractType}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Date début" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding ContractStart, StringFormat={}{0:dd/MM/yyyy}}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,8,10">
                                <TextBlock Text="Date fin" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding ContractEnd, StringFormat={}{0:dd/MM/yyyy}}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Durée" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding ContractDurationDisplay}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Text="Loyer mensuel" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding RentSummaryDisplay}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Garantie" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Montant garantie" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding DepositSummaryDisplay}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Statut" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="À payer" Foreground="#F59E0B" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Paiement mensuel" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Fréquence" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding PaymentFrequency}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Mode paiement" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding PaymentMethod}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                <TextBlock Text="Prochain paiement" Style="{StaticResource LocationSummaryLabel}"/>
                                <TextBlock Text="{Binding NextPaymentDateDisplay}" Style="{StaticResource LocationSummaryValue}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,4,0,16">
                            <DockPanel>
                                <TextBlock Text="Total mensuel" FontSize="13" FontWeight="SemiBold" Foreground="#172033"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RentSummaryDisplay}" FontSize="20" FontWeight="Bold" Foreground="#0B63F6"/>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding PreviousStepCommand}" Style="{StaticResource LocationsToolbarButton}" Padding="14,10" Margin="0,0,8,0" MinWidth="150"
                                    IsEnabled="{Binding IsFirstStep, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ArrowLeft" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Précédent"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding NextStepCommand}" Style="{StaticResource LocationsPrimaryButton}" Padding="12,10" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding NextButtonLabel}"/>
                                    <materialDesign:PackIcon Kind="ArrowRight" Width="14" Height="14" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="#2D6A4F"/>

        <Grid Grid.Row="0" Grid.RowSpan="2" Visibility="{Binding IsAddFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#80000000"/>
            <Border Style="{StaticResource LocationsBwFormCard}" MaxWidth="720" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" Padding="0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Style="{StaticResource LocationsBwFormHeader}">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding CancelAddFormCommand}"
                                        Style="{StaticResource LocationsBwFormResetButton}">
                                    <materialDesign:PackIcon Kind="Close" Foreground="White"/>
                                </Button>
                                <StackPanel>
                                    <TextBlock Text="Nouvel espace" FontSize="20" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="Bureau, appartement ou local disponible" Foreground="#D1D5DB" FontSize="12" Margin="0,4,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <StackPanel Margin="20,16,20,20">
                        <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8"
                                Padding="12,8" Margin="0,0,0,16"
                                Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Code *" Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="8,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Nom *" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Bâtiment" Text="{Binding FormBuilding, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="8,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Étage" Text="{Binding FormFloor, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="2" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Type (Bureau, Appartement...)" Text="{Binding FormType, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="8,0,0,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Surface (m²)" Text="{Binding FormAreaText, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="3" Grid.Column="0" Margin="0,0,8,12" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Loyer mensuel (USD)" Text="{Binding FormRentText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Command="{Binding CancelAddFormCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Padding="20,10" Margin="0,0,10,0" Content="Annuler" Foreground="#111827" BorderBrush="#111827"/>
                            <Button Command="{Binding SavePremiseCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" Padding="24,10">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSaveOutline" Margin="0,0,8,0"/>
                                    <TextBlock Text="Enregistrer"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>

