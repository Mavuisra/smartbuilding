<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.ModulePageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E0E8E6" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompanyName}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource SbmsTextMutedBrush}"
                               FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>

                <TextBox Grid.Column="1" materialDesign:HintAssist.Hint="Rechercher dans la liste..."
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         VerticalAlignment="Center" Margin="16,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource SbmsAccentGreenBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,12,0">
                        <TextBlock Text="{Binding TotalCount, StringFormat={}{0} enregistrement(s)}"
                                   Foreground="White" FontWeight="SemiBold"/>
                    </Border>
                    <Button Command="{Binding RefreshCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            ToolTip="Actualiser">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18,12">
            <Border Background="White" CornerRadius="8" Padding="0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.06" Color="#0F172A"/>
                </Border.Effect>

                <Grid>
                    <DataGrid x:Name="ModuleGrid" ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" Background="White"
                              RowBackground="White" AlternatingRowBackground="#F8FAF9"
                              HorizontalGridLinesBrush="#E8EFED"
                              materialDesign:DataGridAssist.CellPadding="12,10"
                              materialDesign:DataGridAssist.ColumnHeaderPadding="12,10">
                        <DataGrid.Style>
                            <Style TargetType="DataGrid" BasedOn="{StaticResource SbmsDataGrid}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                     Foreground="{StaticResource SbmsAccentGreenBrush}"/>
                        <TextBlock Text="Chargement des données..." Margin="0,12,0,0"
                                   Foreground="{StaticResource SbmsTextMutedBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626"
                               HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
