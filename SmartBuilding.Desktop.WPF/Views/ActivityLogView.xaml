<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.ActivityLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             xmlns:models="clr-namespace:SmartBuilding.Desktop.WPF.Models"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ActivityLogStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <conv:StringToPackIconKindConverter x:Key="StringToPackIconKindConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E0E8E6" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Journal d'activité" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Suivi et historique de toutes les activités du système"
                               Foreground="{StaticResource SbmsTextMutedBrush}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,0" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Background="White" VerticalAlignment="Center" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#94A3B8"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Rechercher dans les activités..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border Grid.Column="2" Background="#F1F5F9" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl + K" FontSize="10" Foreground="#64748B"/>
                        </Border>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8"
                            Padding="12,8" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarRange" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DateRangeDisplay}" FontSize="12" Foreground="#1B3D3B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource ActivityLogPrimaryButton}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Margin="0,0,6,0"/>
                            <TextBlock Text="Exporter les logs"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40">
                        <materialDesign:PackIcon Kind="BellOutline"/>
                    </Button>
                    <Border Background="#E63946" CornerRadius="9" MinWidth="18" Height="18" Margin="-14,-8,8,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- KPI -->
        <UniformGrid Grid.Row="1" Columns="6" Margin="12,8,12,4">
            <Border Style="{StaticResource ActivityLogKpiCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#DBEAFE" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="History" Foreground="#2563EB" Width="16" Height="16"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Activités aujourd'hui" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="{Binding ActivitiesToday}" FontSize="20" FontWeight="Bold" Foreground="#2563EB"/>
                        <TextBlock Text="{Binding ActivitiesTodayTrend}" FontSize="9" Foreground="#2563EB"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="2" Series="{Binding ActivitiesSparkline}" Height="32"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ActivityLogKpiCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#DCFCE7" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Login" Foreground="#2D6A4F" Width="16" Height="16"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Connexions" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="{Binding LoginsCount}" FontSize="20" FontWeight="Bold" Foreground="#2D6A4F"/>
                        <TextBlock Text="{Binding LoginsTrend}" FontSize="9" Foreground="#2D6A4F"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="2" Series="{Binding LoginsSparkline}" Height="32"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ActivityLogKpiCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#FFEDD5" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="FileEdit" Foreground="#EA580C" Width="16" Height="16"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Modifications" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="{Binding ModificationsCount}" FontSize="20" FontWeight="Bold" Foreground="#EA580C"/>
                        <TextBlock Text="{Binding ModificationsTrend}" FontSize="9" Foreground="#EA580C"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="2" Series="{Binding ModificationsSparkline}" Height="32"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ActivityLogKpiCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#FEE2E2" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="ShieldAlert" Foreground="#DC2626" Width="16" Height="16"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Alertes sécurité" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SecurityAlertsCount}" FontSize="20" FontWeight="Bold" Foreground="#DC2626"/>
                        <TextBlock Text="{Binding SecurityAlertsTrend}" FontSize="9" Foreground="#DC2626"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="2" Series="{Binding SecuritySparkline}" Height="32"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ActivityLogKpiCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#EDE9FE" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="AlertCircle" Foreground="#6D28D9" Width="16" Height="16"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Erreurs système" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SystemErrorsCount}" FontSize="20" FontWeight="Bold" Foreground="#6D28D9"/>
                        <TextBlock Text="{Binding SystemErrorsTrend}" FontSize="9" Foreground="#6D28D9"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="2" Series="{Binding ErrorsSparkline}" Height="32"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource ActivityLogKpiCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="32"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="#E0F2FE" Margin="0,0,8,0">
                            <materialDesign:PackIcon Kind="Sync" Foreground="#0EA5E9" Width="16" Height="16"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Synchronisations" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,6,0,0">
                        <TextBlock Text="{Binding SyncCount}" FontSize="20" FontWeight="Bold" Foreground="#0EA5E9"/>
                        <TextBlock Text="{Binding SyncTrend}" FontSize="9" Foreground="#0EA5E9"/>
                    </StackPanel>
                    <lvc:CartesianChart Grid.Row="2" Series="{Binding SyncSparkline}" Height="32"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- LISTE + DÉTAIL -->
        <Grid Grid.Row="2" Margin="12,4,12,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1" Margin="0,0,8,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Padding="12,8" BorderBrush="#E8EFED" BorderThickness="0,1,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}"
                                          Style="{StaticResource ActivityLogFilterCombo}" Width="70" Margin="0,0,8,0"/>
                                <TextBlock Text="/ page" VerticalAlignment="Center" FontSize="11" Foreground="#64748B" Margin="0,0,8,0"/>
                                <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource ActivityLogToolbarButton}" Padding="6,4">
                                    <materialDesign:PackIcon Kind="ChevronLeft"/>
                                </Button>
                                <ItemsControl ItemsSource="{Binding PageNumbers}" Margin="4,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Command="{Binding DataContext.GoToPageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource ActivityLogToolbarButton}" MinWidth="28" Margin="2,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Command="{Binding NextPageCommand}" Style="{StaticResource ActivityLogToolbarButton}" Padding="6,4">
                                    <materialDesign:PackIcon Kind="ChevronRight"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{Binding PaginationDisplay}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="#E8EFED" BorderThickness="0,0,0,1" Background="#FAFBFC">
                        <WrapPanel>
                            <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding FilterType}"
                                      Style="{StaticResource ActivityLogFilterCombo}" Width="120" Margin="0,0,4,4"/>
                            <ComboBox ItemsSource="{Binding ModuleFilters}" SelectedItem="{Binding FilterModule}"
                                      Style="{StaticResource ActivityLogFilterCombo}" Width="130" Margin="0,0,4,4"/>
                            <ComboBox ItemsSource="{Binding UserFilters}" SelectedItem="{Binding FilterUser}"
                                      Style="{StaticResource ActivityLogFilterCombo}" Width="150" Margin="0,0,4,4"/>
                            <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}"
                                      Style="{StaticResource ActivityLogFilterCombo}" Width="120" Margin="0,0,4,4"/>
                            <Button Style="{StaticResource ActivityLogToolbarButton}" Margin="0,0,4,4" Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Calendar" Margin="0,0,4,0"/>
                                    <TextBlock Text="Période personnalisée" FontSize="11"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ResetFiltersCommand}" Style="{StaticResource ActivityLogToolbarButton}" Margin="0,0,4,4" Padding="8,4">
                                <TextBlock Text="Réinitialiser" FontSize="11"/>
                            </Button>
                        </WrapPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding PagedActivities}" SelectedItem="{Binding SelectedActivity}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="RowBd" Padding="12,8" BorderBrush="#E8EFED" BorderThickness="0,0,0,1" Background="White"
                                                        Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="RowBd" Property="Background" Value="#F8FAFF"/>
                                                        <Setter TargetName="RowBd" Property="BorderBrush" Value="#2563EB"/>
                                                        <Setter TargetName="RowBd" Property="BorderThickness" Value="0,0,0,2"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ActivityLogListItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="160"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="50"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16" Background="#F1F5F9">
                                                <materialDesign:PackIcon Kind="{Binding IconKind, Converter={StaticResource StringToPackIconKindConverter}}"
                                                                         Foreground="{Binding IconColor, Converter={StaticResource HexToBrushConverter}}"
                                                                         Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <Border Width="2" Height="20" Background="#E2E8F0" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TimeDisplay}" FontWeight="SemiBold" FontSize="12"/>
                                            <TextBlock Text="{Binding DateDisplay}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="32" Height="32" CornerRadius="16"
                                                    Background="{Binding AvatarBackground, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding UserInitials}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{Binding AvatarForeground, Converter={StaticResource HexToBrushConverter}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Text="{Binding UserRole}" FontSize="10" Foreground="#64748B"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding ActionTitle}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{Binding TitleForeground}"/>
                                            <TextBlock Text="{Binding ActionDescription}" FontSize="10" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="4" Background="{Binding ModuleBadgeBackground, Converter={StaticResource HexToBrushConverter}}"
                                                CornerRadius="6" Padding="8,3" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Module}" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{Binding ModuleBadgeForeground, Converter={StaticResource HexToBrushConverter}}"/>
                                        </Border>
                                        <TextBlock Grid.Column="5" Text="{Binding Details}" FontSize="10" Foreground="#64748B"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="10" Foreground="#94A3B8">
                                            <Run Text="{Binding DeviceInfo}"/><LineBreak/>
                                            <Run Text="{Binding IpAddress}"/>
                                        </TextBlock>
                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="11"/>
                                        </StackPanel>
                                        <Button Grid.Column="8" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32"
                                                Command="{Binding DataContext.SelectActivityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="DotsVertical"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- DÉTAIL -->
            <Border Grid.Column="1" Style="{StaticResource ActivityLogDetailCard}"
                    Visibility="{Binding SelectedActivity, Converter={StaticResource NullToVisibilityConverter}}">
                <DockPanel DataContext="{Binding SelectedActivity}">
                    <Button DockPanel.Dock="Bottom" Style="{StaticResource ActivityLogToolbarButton}" HorizontalAlignment="Left" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Flag" Foreground="#DC2626" Margin="0,0,6,0"/>
                            <TextBlock Text="Signaler cette activité" Foreground="#DC2626"/>
                        </StackPanel>
                    </Button>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource MaterialDesignIconButton}"
                                    Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <materialDesign:PackIcon Kind="Close"/>
                            </Button>
                            <StackPanel>
                                <TextBlock Text="{Binding ActionTitle}" FontWeight="Bold" FontSize="15"
                                           Foreground="{Binding TitleForeground}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Background="#DCFCE7" CornerRadius="6" Padding="8,3" Margin="0,0,8,0"
                                            Visibility="{Binding StatusLabel, Converter={StaticResource NullToVisibilityConverter}}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="#166534"/>
                                    </Border>
                                    <TextBlock Text="{Binding ActivityCode}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#64748B">
                                    <Run Text="{Binding DateDisplay}"/><Run Text=" — "/><Run Text="{Binding TimeDisplay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="#E8EFED" BorderThickness="0,0,0,1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Informations" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="0" Style="{StaticResource ActivityLogToolbarButton}" Padding="8,6"/>
                            <Button Content="Anciennes valeurs" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="1" Style="{StaticResource ActivityLogToolbarButton}" Padding="8,6"/>
                            <Button Content="Nouvelles valeurs" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="2" Style="{StaticResource ActivityLogToolbarButton}" Padding="8,6"/>
                        </StackPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <StackPanel Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                                <Grid DataContext="{Binding SelectedActivity}" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Utilisateur" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding UserName}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Text="Module" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Module}" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Text="Action" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActionTitle}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Text="Description" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ActionDescription}" FontSize="11" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="4" Text="Fichier" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FileName}" FontSize="11"/>
                                    <TextBlock Grid.Row="5" Text="Chemin" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FilePath}" FontSize="10" Foreground="#64748B" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="6" Text="Adresse IP" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding IpAddress}" FontSize="11"/>
                                    <TextBlock Grid.Row="7" Text="Appareil" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding DeviceInfo}" FontSize="11"/>
                                    <TextBlock Grid.Row="8" Text="Navigateur" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding Browser}" FontSize="11"/>
                                    <TextBlock Grid.Row="9" Text="Localisation" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding Location}" FontSize="11"/>
                                </Grid>
                                <TextBlock Text="Activités liées" FontWeight="SemiBold" FontSize="12" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding RelatedActivities}" Margin="0,0,0,12">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ActivityLogRelatedItem}">
                                            <DockPanel Margin="0,0,0,6">
                                                <materialDesign:PackIcon Kind="{Binding IconKind, Converter={StaticResource StringToPackIconKindConverter}}"
                                                                         Width="16" Height="16" Foreground="#64748B" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding TimeDisplay}" DockPanel.Dock="Right" FontSize="9" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding Title}" FontSize="11"/>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Appareil" FontWeight="SemiBold" FontSize="12" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                <Border Background="#F8FAFC" CornerRadius="8" Padding="12" DataContext="{Binding SelectedActivity}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DeviceInfo}" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="{Binding Browser}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Location}" FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}"
                                        DataContext="{Binding SelectedActivity}" Margin="4">
                                <TextBlock Text="Anciennes valeurs" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding OldValues}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         MinHeight="200" BorderBrush="#E2E8F0" Background="#FAFBFC"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding SelectedDetailTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}"
                                        DataContext="{Binding SelectedActivity}" Margin="4">
                                <TextBlock Text="Nouvelles valeurs" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding NewValues}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         MinHeight="200" BorderBrush="#E2E8F0" Background="#FAFBFC"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <ProgressBar Grid.Row="0" Grid.RowSpan="3" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="#2563EB"/>
    </Grid>
</UserControl>
