<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.ConsumptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/ConsumptionsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Accueil › Consommations" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    <TextBlock Text="Consommations" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Suivi des dépenses de consommation par période" FontSize="13"
                               Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,0" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Background="White" VerticalAlignment="Center" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#94A3B8"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Rechercher type, équipement, responsable..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#E8F5EE" CornerRadius="8" Padding="10,6" Margin="0,0,12,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sync" Width="16" Height="16" Foreground="#2D6A4F" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding SyncStatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                <TextBlock Text="{Binding LastSyncDisplay}" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40">
                        <materialDesign:PackIcon Kind="BellOutline"/>
                    </Button>
                    <Border Background="#E63946" CornerRadius="9" MinWidth="18" Height="18" Margin="-14,-8,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
                    <Border Style="{StaticResource ConsumptionsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Flash" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Électricité (montant)" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ElectricityDisplay}" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                                <TextBlock Text="Période courante" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E0F2FE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Water" Foreground="#0EA5E9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Facture eau du mois" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding WaterBillDisplay}" FontSize="14" FontWeight="Bold" Foreground="#0369A1"/>
                                <TextBlock Text="Réseau eau potable" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FFEDD5" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="GasStation" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Carburant générateur" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding FuelCostDisplay}" FontSize="14" FontWeight="Bold" Foreground="#EA580C"/>
                                <TextBlock Text="Diesel / groupe" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#EDE9FE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Web" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Dépenses Internet" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding InternetCostDisplay}" FontSize="14" FontWeight="Bold" Foreground="#6D28D9"/>
                                <TextBlock Text="Fibre &amp; data" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E8F5EE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="LightningBolt" Foreground="#2D6A4F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Coût énergétique global" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding TotalEnergyCostDisplay}" FontSize="14" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Plafonné par les loyers" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DCFCE7" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="WalletOutline" Foreground="#166534" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Disponible (loyers − dépenses)" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding AvailableBalanceDisplay}" FontSize="14" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="Seule source : loyers Locations" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FEF3C7" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="TrendingUp" Foreground="#B45309" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Variation mensuelle" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding MonthlyVariationDisplay}" FontSize="16" FontWeight="Bold" Foreground="#B45309"/>
                                <TextBlock Text="{Binding MonthlyVariationTrend}" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E8EFED" BorderThickness="1"
                        Padding="10,8" Margin="0,0,0,8">
                    <WrapPanel>
                        <Button Command="{Binding OpenAddFormCommand}" Style="{StaticResource ConsumptionsPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,6,0"/>
                                <TextBlock Text="Nouvelle consommation"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenRecordHistoryCommand}" Style="{StaticResource ConsumptionsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Margin="0,0,6,0"/>
                                <TextBlock Text="Historique"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource ConsumptionsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileChart" Margin="0,0,6,0"/>
                                <TextBlock Text="Générer rapport"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource ConsumptionsToolbarButton}" ToolTip="Exporter le détail en PDF">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,6,0"/>
                                <TextBlock Text="PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource ConsumptionsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MicrosoftExcel" Margin="0,0,6,0"/>
                                <TextBlock Text="Export Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SyncCommand}" Style="{StaticResource ConsumptionsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Margin="0,0,6,0"/>
                                <TextBlock Text="Synchroniser"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
                    <Border Style="{StaticResource ConsumptionsAnalyticsCard}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Évolution consommation (12 mois)" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding MonthlyTrendSeries}" Height="120"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsAnalyticsCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Répartition énergétique" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:PieChart Series="{Binding EnergyPieSeries}" Height="120"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsAnalyticsCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Coûts par type" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding CostBarSeries}" Height="120"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ConsumptionsAnalyticsCard}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Comparaison mois N / N-1" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding CompareSeries}" Height="120"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="3" MinHeight="400">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="720"/>
                        <ColumnDefinition Width="272"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="12" BorderBrush="#BFDBFE" BorderThickness="1"
                            Margin="0,0,8,0" Padding="12,10">
                        <DockPanel>
                            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding PeriodFilters}" SelectedItem="{Binding FilterPeriod}" Style="{StaticResource ConsumptionsFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding FilterType}" Style="{StaticResource ConsumptionsFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding BuildingFilters}" SelectedItem="{Binding FilterBuilding}" Style="{StaticResource ConsumptionsFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding EquipmentFilters}" SelectedItem="{Binding FilterEquipment}" Style="{StaticResource ConsumptionsFilterCombo}" MinWidth="140"/>
                                    <ComboBox ItemsSource="{Binding AnomalyFilters}" SelectedItem="{Binding FilterAnomaly}" Style="{StaticResource ConsumptionsFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource ConsumptionsFilterCombo}"/>
                                    <TextBox Style="{StaticResource ConsumptionsFilterSearch}" materialDesign:HintAssist.Hint="Rechercher..."
                                             Text="{Binding TableSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </ScrollViewer>

                            <DataGrid ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                                      Style="{StaticResource ConsumptionsDataGrid}" MinHeight="300">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="DATE" MinWidth="100" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DateDisplay}" Style="{StaticResource ConsumptionsCellText}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="TYPE" MinWidth="130" Width="140">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Top" Margin="0,6,8,0"
                                                            Background="{Binding TypeIconColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                    <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource ConsumptionsCellText}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ÉQUIPEMENT" MinWidth="150" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding EquipmentSource}" Style="{StaticResource ConsumptionsCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="MOTIF" MinWidth="140" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ExpenseMotif}" Style="{StaticResource ConsumptionsCellText}" Foreground="#475569"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="PAYÉ PAR" MinWidth="120" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding PaidBy}" Style="{StaticResource ConsumptionsCellText}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="COÛT" MinWidth="90" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CostDisplay}" Style="{StaticResource ConsumptionsCellText}" FontWeight="Bold" Foreground="#2563EB"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="VARIATION" MinWidth="90" Width="95">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding VariationDisplay}" Style="{StaticResource ConsumptionsCellText}"
                                                           Foreground="{Binding VariationColor}" FontWeight="SemiBold"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="REMBOURSEMENT" MinWidth="150" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Border CornerRadius="8" Padding="8,4"
                                                            Background="{Binding ReimbursementBadgeBackground}"
                                                            Visibility="{Binding HasReimbursementInfo, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding ReimbursementDisplay}"
                                                                   Foreground="{Binding ReimbursementBadgeForeground}"
                                                                   FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    </Border>
                                                    <TextBlock Text="—" Style="{StaticResource ConsumptionsCellText}"
                                                               Visibility="{Binding HasReimbursementInfo, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="STATUT" MinWidth="100" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="8,4" Background="{Binding StatusBadgeBackground}">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBadgeForeground}"
                                                               FontSize="11" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="ACTIONS" MinWidth="100" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Voir détail"
                                                            Command="{Binding DataContext.OpenRecordDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Width="36" Height="36">
                                                        <materialDesign:PackIcon Kind="EyeOutline" Width="18" Height="18"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modifier"
                                                            Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}" Width="36" Height="36" Foreground="#2563EB">
                                                        <materialDesign:PackIcon Kind="PencilOutline" Width="18" Height="18"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <TextBlock Text="{Binding PaginationText}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="{StaticResource SbmsTextMutedBrush}" FontSize="11"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="Par page :" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                                    <ComboBox Width="70" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Margin="0,0,16,0"/>
                                    <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="ChevronLeft"/>
                                    </Button>
                                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="/" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="8,0" Foreground="#94A3B8"/>
                                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="ChevronRight"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource ConsumptionsSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Alertes énergétiques" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="20" Height="20"
                                                                             Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                                                                             VerticalAlignment="Top" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#1B3D3B"/>
                                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ConsumptionsSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Analyse intelligente" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Insights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#94A3B8"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Accent}" TextWrapping="Wrap" MaxWidth="160" TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="12" BorderBrush="#E8EFED" BorderThickness="1"
                                Visibility="{Binding IsDetailPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid MaxHeight="400">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="14,12,14,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDetailPanelCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="Close"/>
                                    </Button>
                                    <TextBlock Text="Détail consommation" FontSize="14" FontWeight="Bold" Foreground="#1B3D3B" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,14,10">
                                    <StackPanel DataContext="{Binding SelectedRecord}">
                                        <Border CornerRadius="10" Padding="12" Background="#DBEAFE" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TypeLabel}" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
                                                <TextBlock Text="{Binding EquipmentSource}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                                <Border Background="{Binding StatusBadgeBackground}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Left" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBadgeForeground}" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="Résumé" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="0" Style="{StaticResource PersonnelDetailTabButton}"/>
                                            <Button Content="Historique" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="1" Style="{StaticResource PersonnelDetailTabButton}"/>
                                        </WrapPanel>

                                        <StackPanel Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                                            <TextBlock Text="Coût total relevé" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding CostDisplay}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" Margin="0,2,0,8"/>
                                            <TextBlock Text="Montant période" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Margin="0,2,0,6"><Run Text="{Binding CostDisplay}"/></TextBlock>
                                            <TextBlock Text="Variation vs N-1" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding VariationDisplay}" Foreground="{Binding VariationColor}" FontWeight="SemiBold" Margin="0,2,0,6"/>
                                            <TextBlock Text="Motif" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding ExpenseMotif}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                            <TextBlock Text="Payé par" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding PaidBy}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Remboursement" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding ReimbursementDisplay}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                            <TextBlock Text="Période" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding PeriodType}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Bâtiment" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Building}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Responsable" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Responsible}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Compteur" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding MeterReference}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding MonthlyHistory}"
                                                      Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#E8EFED" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding CostDisplay}" FontSize="10" Foreground="#64748B"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding CostDisplay}" FontWeight="SemiBold" Foreground="#2563EB" VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Grid.Row="2" Padding="14,10,14,12" BorderBrush="#E8EFED" BorderThickness="0,1,0,0">
                                    <UniformGrid Columns="2">
                                        <Button Command="{Binding OpenEditFormCommand}" Style="{StaticResource ConsumptionsToolbarButton}" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="PencilOutline" Width="14" Height="14" Margin="0,0,4,0"/>
                                                <TextBlock Text="Modifier" FontSize="11"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Command="{Binding GenerateReportCommand}" Style="{StaticResource ConsumptionsPrimaryButton}" Margin="4,0,0,0">
                                            <TextBlock Text="Rapport" FontSize="11"/>
                                        </Button>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsAddFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="14" Padding="28" MaxWidth="520" MaxHeight="640"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="580">
                <StackPanel>
                    <TextBlock Text="{Binding FormDialogTitle}" FontSize="20" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <TextBlock Text="Saisissez une rubrique librement ou choisissez une suggestion." FontSize="12" Foreground="#64748B" Margin="0,0,0,16"/>
                    <TextBlock Text="Rubrique" FontSize="12" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <ComboBox IsEditable="True" ItemsSource="{Binding ConsumptionTypes}"
                              Text="{Binding FormRubrique, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ConsumptionsFilterCombo}" Margin="0,0,0,12"/>
                    <TextBlock Text="Poste / source" FontSize="12" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <TextBox materialDesign:HintAssist.Hint="Ex. Compteur principal, Générateur bloc B…"
                             Text="{Binding FormEquipment, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <TextBlock Text="Motif de dépense" FontSize="12" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <TextBox materialDesign:HintAssist.Hint="Ex. Réparation urgente, achat carburant…"
                             Text="{Binding FormMotif, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <TextBlock Text="Payé par" FontSize="12" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <TextBox materialDesign:HintAssist.Hint="Nom de la personne"
                             Text="{Binding FormPaidBy, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <CheckBox Content="Avance personnelle — à rembourser par l'entreprise"
                              IsChecked="{Binding FormRequiresReimbursement}" Margin="0,0,0,12"/>
                    <TextBlock Text="Montant (USD)" FontSize="12" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <TextBox materialDesign:HintAssist.Hint="0,00"
                             Text="{Binding FormCostText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>
                    <TextBlock Text="Période" FontSize="12" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding PeriodTypes}" SelectedItem="{Binding FormPeriodType}" Style="{StaticResource ConsumptionsFilterCombo}" Margin="0,0,0,12"/>
                    <TextBlock Text="Statut" FontSize="12" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding FormStatusOptions}" SelectedItem="{Binding FormStatus}" Style="{StaticResource ConsumptionsFilterCombo}" Margin="0,0,0,12"/>
                    <TextBlock Text="Notes (optionnel)" FontSize="12" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                    <TextBox materialDesign:HintAssist.Hint="Commentaire interne…"
                             Text="{Binding FormNotes, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,0,0,12"/>
                    <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CloseAddFormCommand}" Style="{StaticResource ConsumptionsToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="{Binding FormSaveButtonLabel}" Command="{Binding SaveRecordCommand}" Style="{StaticResource ConsumptionsPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>

        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsRecordDetailsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel DataContext="{Binding SelectedRecord}">
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Command="{Binding DataContext.CloseRecordDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                        <TextBlock Text="Détail complet consommation" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                    </DockPanel>

                    <Border Background="#F8FAFC" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding TypeLabel}" FontSize="16" FontWeight="Bold" Foreground="#1D4ED8"/>
                            <TextBlock Text="{Binding EquipmentSource}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding DateDisplay}" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Coût" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding CostDisplay}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Variation" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding VariationDisplay}" FontWeight="SemiBold" Foreground="{Binding VariationColor}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Statut" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Période" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding PeriodType}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Bâtiment" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding Building}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Motif" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding ExpenseMotif}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock Text="Payé par" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding PaidBy}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Remboursement" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding ReimbursementDisplay}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Compteur" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding MeterReference}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Notes" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding DataContext.MarkReimbursedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="Marquer remboursé"
                                Style="{StaticResource ConsumptionsToolbarButton}" Margin="0,0,8,0"
                                Visibility="{Binding CanMarkReimbursed, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        <Button Command="{Binding DataContext.OpenEditFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Content="Modifier" Style="{StaticResource ConsumptionsToolbarButton}" Margin="0,0,8,0"/>
                        <Button Command="{Binding DataContext.GenerateReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Exporter PDF" Style="{StaticResource ConsumptionsToolbarButton}" Margin="0,0,8,0"/>
                        <Button Command="{Binding DataContext.CloseRecordDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Fermer" Style="{StaticResource ConsumptionsPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="#2563EB"/>
    </Grid>
</UserControl>

