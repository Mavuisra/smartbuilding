<Window x:Class="SmartBuilding.Desktop.WPF.Views.PrerequisitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
        Title="Prérequis système — Smart Building MS"
        Width="920" Height="700"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F8F6">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>

        <Style x:Key="PrereqSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1B3D3B"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrereqPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2D6A4F"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1B4332"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B3D3B" CornerRadius="14" Padding="22,18" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Configuration requise sur ce PC"
                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Smart Building MS a besoin des composants ci-dessous pour fonctionner correctement."
                           Foreground="#D1FAE5" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Border Background="#2D6A4F" CornerRadius="8" Padding="10,6" Margin="0,12,0,0" HorizontalAlignment="Left">
                    <TextBlock Foreground="#F0FDF4" FontSize="12">
                        <Run Text="Mode déployé : "/><Run Text="{Binding DeploymentModeLabel}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F0FDF4" CornerRadius="8" Padding="12,10" Margin="0,0,0,14">
                    <TextBlock Text="{Binding StatusHeadline}" FontWeight="SemiBold" Foreground="#14532D" TextWrapping="Wrap"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" CornerRadius="10"
                                        BorderBrush="#E2E8F0" BorderThickness="1" Background="#FAFAFA">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{Binding StatusBackground}" Margin="0,0,12,0"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding IconGlyph}" FontWeight="Bold" FontSize="16"
                                                       Foreground="{Binding StatusForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"
                                                           Foreground="#0F172A" VerticalAlignment="Center"/>
                                                <Border Margin="10,0,0,0" Padding="8,3" CornerRadius="6"
                                                        Background="{Binding StatusBackground}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusForeground}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Foreground="#475569" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Instructions}" Foreground="#64748B" FontSize="12"
                                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <Button Margin="0,12,0,0" HorizontalAlignment="Left"
                                                    Visibility="{Binding HasDownload, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.OpenDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource PrereqPrimaryButton}"
                                                    Content="{Binding DownloadLabel}"
                                                    MinWidth="0" Padding="16,10"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="18,14"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="160"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Foreground="#64748B"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,20,0"
                           Text="Après installation, démarrez MySQL dans XAMPP puis cliquez sur « Vérifier à nouveau »."/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Content="Quitter"
                            Margin="0,0,10,0"
                            Command="{Binding QuitApplicationCommand}"
                            Style="{StaticResource PrereqSecondaryButton}"/>
                    <Button Content="Vérifier à nouveau"
                            Command="{Binding RecheckCommand}"
                            Style="{StaticResource PrereqPrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
