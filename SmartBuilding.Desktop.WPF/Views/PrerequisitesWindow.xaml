<Window x:Class="SmartBuilding.Desktop.WPF.Views.PrerequisitesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
        Title="Prérequis système — Smart Building MS"
        Width="920" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F5F8F6">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolVis"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#1B3D3B" CornerRadius="14" Padding="20" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Configuration requise sur ce PC"
                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Smart Building MS a besoin des composants ci-dessous pour fonctionner correctement."
                           Foreground="#D1FAE5" FontSize="13" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Border Background="#2D6A4F" CornerRadius="8" Padding="10,6" Margin="0,12,0,0" HorizontalAlignment="Left">
                    <TextBlock Foreground="#F0FDF4" FontSize="12">
                        <Run Text="Mode déployé : "/><Run Text="{Binding DeploymentModeLabel}" FontWeight="SemiBold"/>
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#F0FDF4" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                    <TextBlock Text="{Binding StatusHeadline}" FontWeight="SemiBold" Foreground="#14532D" TextWrapping="Wrap"/>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14" CornerRadius="10"
                                        BorderBrush="#E2E8F0" BorderThickness="1" Background="#FAFAFA">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="36" Height="36" CornerRadius="18"
                                                Background="{Binding StatusBackground}" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding IconGlyph}" FontWeight="Bold" FontSize="16"
                                                       Foreground="{Binding StatusForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                                <Border Margin="10,0,0,0" Padding="8,2" CornerRadius="6"
                                                        Background="{Binding StatusBackground}">
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{Binding StatusForeground}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Foreground="#475569" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Instructions}" Foreground="#64748B" FontSize="12"
                                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <Button Margin="0,10,0,0" Padding="14,8" HorizontalAlignment="Left"
                                                    Visibility="{Binding HasDownload, Converter={StaticResource BoolVis}}"
                                                    Command="{Binding DataContext.OpenDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="#2D6A4F" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="⬇ " FontSize="12"/>
                                                    <TextBlock Text="{Binding DownloadLabel}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"
                       Text="Après installation, démarrez MySQL dans XAMPP puis cliquez sur « Vérifier à nouveau »."/>

            <Button Grid.Column="1" Margin="0,0,10,0" Padding="18,10" MinWidth="140"
                    Command="{Binding QuitApplicationCommand}"
                    Background="Transparent" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand">
                <TextBlock Text="Quitter" FontWeight="SemiBold"/>
            </Button>

            <Button Grid.Column="2" Padding="18,10" MinWidth="180"
                    Command="{Binding RecheckCommand}"
                    Background="#2D6A4F" Foreground="White" BorderThickness="0" Cursor="Hand">
                <TextBlock Text="Vérifier à nouveau" FontWeight="SemiBold"/>
            </Button>
        </Grid>
    </Grid>
</Window>
