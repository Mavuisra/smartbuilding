<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.LocationsTenantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="#F5F7FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>

            <Style x:Key="StatusBadgeBorder" TargetType="Border" BasedOn="{StaticResource LocationsStatusBadge}"/>
            <Style x:Key="RowActionsPanel" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1"
                Padding="20,16" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="48" Height="48" CornerRadius="12" Background="#E8F5EE" Margin="0,0,14,0">
                        <materialDesign:PackIcon Kind="AccountGroup" Width="26" Height="26" Foreground="#2D6A4F"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Locateur" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                        <TextBlock Text="Personnes qui louent un local — fiches, contrats et historique"
                                   FontSize="12" Foreground="#7A8699" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="520"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Command="{Binding CreateCommand}" Style="{StaticResource LocationsPrimaryButton}"
                        Padding="16,10" VerticalAlignment="Center"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Nouveau locataire" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- KPI -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,10">
            <Border Style="{StaticResource LocationsTenantKpiCard}" Margin="0,0,6,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource LocationsKpiIconBox}" Background="#F1F5F9">
                        <materialDesign:PackIcon Kind="AccountMultiple" Foreground="#475569"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Total" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TotalTenants}" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource LocationsTenantKpiCard}" Margin="3,0,3,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource LocationsKpiIconBox}" Background="#DCFCE7">
                        <materialDesign:PackIcon Kind="AccountCheck" Foreground="#166534"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Actifs" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding ActiveTenants}" FontSize="24" FontWeight="Bold" Foreground="#166534"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource LocationsTenantKpiCard}" Margin="3,0,3,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource LocationsKpiIconBox}" Background="#DBEAFE">
                        <materialDesign:PackIcon Kind="FileDocumentOutline" Foreground="#1D4ED8"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Contrat actif" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding TenantsWithContract}" FontSize="24" FontWeight="Bold" Foreground="#1D4ED8"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource LocationsTenantKpiCard}" Margin="6,0,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource LocationsKpiIconBox}" Background="#FEE2E2">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#DC2626"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Retards" FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding LatePaymentsCount}" FontSize="24" FontWeight="Bold" Foreground="#DC2626"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Tableau -->
        <Border Grid.Row="2" Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="14,12" BorderBrush="#E8EFED" BorderThickness="0,0,0,1" Background="#FAFBFC">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="#64748B" Margin="0,0,12,0">
                                    <Run Text="{Binding DisplayedCount, Mode=OneWay}"/>
                                    <Run Text=" affiché(s)"/>
                                </TextBlock>
                                <Button Command="{Binding LoadCommand}" Style="{StaticResource LocationsToolbarButton}" ToolTip="Actualiser">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" Margin="0,0,6,0"/>
                                        <TextBlock Text="Actualiser"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Width="260" Style="{StaticResource LocationsFilterSearch}"
                                         materialDesign:HintAssist.Hint="Nom, dossier, téléphone, email…"
                                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Width="170" Style="{StaticResource LocationsFilterCombo}"
                                          materialDesign:HintAssist.Hint="Statut"
                                          ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Margin="0,10,0,0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,8"
                                Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertCircle" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Tenants}" Style="{StaticResource LocationsDataGrid}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          SelectionMode="Single" GridLinesVisibility="Horizontal"
                          materialDesign:DataGridAssist.CellPadding="10,8"
                          MouseDoubleClick="TenantsGrid_OnMouseDoubleClick" MinHeight="280">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="LOCATAIRE" Width="2*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="18" Background="#E8F5EE" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="12" Foreground="#2D6A4F"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#111827"/>
                                            <TextBlock Text="{Binding DossierNumber}" FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding TenantCategory}" Width="110"/>
                        <DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Phone}" Width="120"/>
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="1.4*" MinWidth="140"/>
                        <DataGridTextColumn Header="PROFESSION" Binding="{Binding Profession}" Width="120"/>
                        <DataGridTextColumn Header="CONTRATS" Binding="{Binding ActiveContracts}" Width="80"/>
                        <DataGridTemplateColumn Header="STATUT" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource StatusBadgeBorder}"
                                            Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrushConverter}}">
                                        <TextBlock Text="{Binding RentalStatus}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{Binding StatusBadgeForeground, Converter={StaticResource HexToBrushConverter}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Style="{StaticResource RowActionsPanel}">
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Fiche détail"
                                                Command="{Binding DataContext.OpenDetailCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Modifier"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource LocationsIconActionButton}" ToolTip="Archiver"
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="ArchiveOutline" Width="16" Height="16" Foreground="#DC2626"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="*" MinWidth="8" IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><Border/></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellStyle>
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource LocationsDataGridFillerCell}"/>
                            </DataGridTemplateColumn.CellStyle>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2" Padding="12,8" BorderBrush="#E8EFED" BorderThickness="0,1,0,0" Background="#FAFBFC">
                    <TextBlock FontSize="11" Foreground="#94A3B8">
                        <Run Text="Astuce : double-cliquez sur une ligne pour ouvrir la fiche complète du locataire."/>
                    </TextBlock>
                </Border>

                <Border Grid.RowSpan="3" Background="#80FFFFFF"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#2D6A4F"/>
                        <TextBlock Text="Chargement…" Margin="0,10,0,0" Foreground="#64748B" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
