<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SuppliersStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Accueil › Fournisseurs" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    <TextBlock Text="Fournisseurs" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Gestion des partenaires, contrats et factures fournisseurs" FontSize="13"
                               Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,0" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Background="White" VerticalAlignment="Center" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#94A3B8"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Rechercher un fournisseur, une catégorie..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40">
                        <materialDesign:PackIcon Kind="BellOutline"/>
                    </Button>
                    <Border Background="#E63946" CornerRadius="9" MinWidth="18" Height="18" Margin="-14,-8,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 6 KPI -->
                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
                    <Border Style="{StaticResource SuppliersKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E8F5EE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="TruckDelivery" Foreground="#2D6A4F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Total fournisseurs" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding TotalSuppliers}" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Partenaires enregistrés" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SuppliersKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="CheckDecagram" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Fournisseurs actifs" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ActiveSuppliers}" FontSize="18" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="{Binding ActivePercent}" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SuppliersKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FEE2E2" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="FileAlert" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Factures impayées" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding UnpaidInvoices}" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                                <TextBlock Text="À régler" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SuppliersKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#EDE9FE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="CashMultiple" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Dépenses fournisseurs" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding MonthlyExpensesDisplay}" FontSize="14" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Ce mois · plafond loyers" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SuppliersKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DCFCE7" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="WalletOutline" Foreground="#166534" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Disponible" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding AvailableBalanceDisplay}" FontSize="14" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="Loyers encaissés − dépenses" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SuppliersKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FFEDD5" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="FileClock" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Contrats expirent" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ContractsExpiringSoon}" FontSize="18" FontWeight="Bold" Foreground="#EA580C"/>
                                <TextBlock Text="Sous 30 jours" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SuppliersKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E0F2FE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="HammerWrench" Foreground="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Interventions ce mois" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding InterventionsThisMonth}" FontSize="18" FontWeight="Bold" Foreground="#0369A1"/>
                                <TextBlock Text="Factures / prestations" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Actions -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E8EFED" BorderThickness="1"
                        Padding="10,8" Margin="0,0,0,8">
                    <WrapPanel>
                        <Button Command="{Binding OpenAddFormCommand}" Style="{StaticResource SuppliersPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,6,0"/>
                                <TextBlock Text="Ajouter fournisseur"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenContractFormCommand}" Style="{StaticResource SuppliersToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentEdit" Margin="0,0,6,0"/>
                                <TextBlock Text="Nouveau contrat"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenInvoiceFormCommand}" Style="{StaticResource SuppliersToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Receipt" Margin="0,0,6,0"/>
                                <TextBlock Text="Nouvelle facture"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenInterventionFormCommand}" Style="{StaticResource SuppliersToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarPlus" Margin="0,0,6,0"/>
                                <TextBlock Text="Planifier intervention"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource SuppliersToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MicrosoftExcel" Margin="0,0,6,0"/>
                                <TextBlock Text="Export Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportContractPdfCommand}" Style="{StaticResource SuppliersToolbarButton}" ToolTip="Exporter le contrat sélectionné en PDF">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,6,0"/>
                                <TextBlock Text="Contrat PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SyncCommand}" Style="{StaticResource SuppliersToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Margin="0,0,6,0"/>
                                <TextBlock Text="Synchroniser"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ViewContractDetailsCommand}" Style="{StaticResource SuppliersToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FileDocumentOutline" Margin="0,0,6,0"/>
                                <TextBlock Text="Voir contrat"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <!-- Tableau + panneau droit -->
                <Grid Grid.Row="2" MinHeight="340">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="300"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1"
                            Margin="0,0,8,0" Padding="10,8">
                        <DockPanel>
                            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding FilterCategory}" Style="{StaticResource SuppliersFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource SuppliersFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding ServiceTypeFilters}" SelectedItem="{Binding FilterServiceType}" Style="{StaticResource SuppliersFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding ContractFilters}" SelectedItem="{Binding FilterContract}" Style="{StaticResource SuppliersFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding BuildingFilters}" SelectedItem="{Binding FilterBuilding}" Style="{StaticResource SuppliersFilterCombo}"/>
                                    <TextBox Style="{StaticResource SuppliersFilterSearch}" materialDesign:HintAssist.Hint="Rechercher fournisseur..."
                                             Text="{Binding TableSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </ScrollViewer>

                            <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                      Style="{StaticResource SuppliersDataGrid}" materialDesign:DataGridAssist.CellPadding="8,4" MinHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="48">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="36" Height="36" CornerRadius="18"
                                                        Background="{Binding LogoBackground, Converter={StaticResource HexToBrushConverter}}">
                                                    <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="12"
                                                               Foreground="{Binding LogoForeground, Converter={StaticResource HexToBrushConverter}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Code}" Width="95"/>
                                    <DataGridTextColumn Header="ENTREPRISE" Binding="{Binding Name}" Width="*"/>
                                    <DataGridTextColumn Header="CATÉGORIE" Binding="{Binding Category}" Width="100"/>
                                    <DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Phone}" Width="105"/>
                                    <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="*"/>
                                    <DataGridTextColumn Header="CONTRAT" Binding="{Binding ContractDisplay}" Width="90"/>
                                    <DataGridTextColumn Header="DÉPENSES" Binding="{Binding TotalExpensesDisplay}" Width="95"/>
                                    <DataGridTextColumn Header="DERN. INTERV." Binding="{Binding LastInterventionDisplay}" Width="90"/>
                                    <DataGridTemplateColumn Header="STATUT" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="6,2" Background="{Binding StatusBadgeBackground}">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBadgeForeground}"
                                                               FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Voir" Command="{Binding DataContext.OpenSupplierDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="EyeOutline"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Voir contrat" Command="{Binding DataContext.ViewContractDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="FileDocumentOutline"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modifier">
                                                        <materialDesign:PackIcon Kind="PencilOutline"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Plus">
                                                        <materialDesign:PackIcon Kind="DotsVertical"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <TextBlock Text="{Binding PaginationText}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="{StaticResource SbmsTextMutedBrush}" FontSize="11"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="Par page :" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                                    <ComboBox Width="70" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Margin="0,0,16,0"/>
                                    <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="ChevronLeft"/>
                                    </Button>
                                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="/" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="8,0" Foreground="#94A3B8"/>
                                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="ChevronRight"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <!-- Colonne droite : alertes + détail -->
                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource SuppliersSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Alertes fournisseurs" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#1B3D3B"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="12" BorderBrush="#E8EFED" BorderThickness="1"
                                Visibility="{Binding IsDetailPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid MaxHeight="520">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="14,12,14,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDetailPanelCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="Close"/>
                                    </Button>
                                    <TextBlock Text="Détail fournisseur" FontSize="14" FontWeight="Bold" Foreground="#1B3D3B" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,14,10">
                                    <StackPanel DataContext="{Binding SelectedSupplier}">
                                        <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                                                Background="{Binding LogoBackground, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Initials}" FontSize="20" FontWeight="Bold"
                                                       Foreground="{Binding LogoForeground, Converter={StaticResource HexToBrushConverter}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#94A3B8" TextAlignment="Center" Margin="0,2,0,8"/>
                                        <Border Background="{Binding StatusBadgeBackground}" CornerRadius="10" Padding="10,4"
                                                HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBadgeForeground}" FontWeight="SemiBold"/>
                                        </Border>

                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="Infos" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="0" Style="{StaticResource PersonnelDetailTabButton}"/>
                                            <Button Content="Factures" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="1" Style="{StaticResource PersonnelDetailTabButton}"/>
                                            <Button Content="Interventions" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="2" Style="{StaticResource PersonnelDetailTabButton}"/>
                                        </WrapPanel>

                                        <StackPanel Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                                            <TextBlock Text="Informations générales" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                            <TextBlock Text="Catégorie" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Category}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Type de service" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding ServiceType}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Bâtiment" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Building}" Margin="0,2,0,6"/>
                                            <TextBlock Text="N° fiscal" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding TaxId}" Margin="0,2,0,10"/>
                                            <TextBlock Text="Contact" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                            <TextBlock Text="Responsable" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding ContactName}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Téléphone" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Phone}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Email" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Email}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                                            <TextBlock Text="Adresse" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Address}" TextWrapping="Wrap" Margin="0,2,0,10"/>
                                            <TextBlock Text="Contrat" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                            <TextBlock Text="N° contrat" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding ContractDisplay}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Fin contrat" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding ContractEndDisplay}" Margin="0,2,0,6"/>
                                            <TextBlock Text="État" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding ContractStatus}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Dépenses totales" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding TotalExpensesDisplay}" FontSize="18" FontWeight="Bold" Foreground="#2D6A4F"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Invoices}"
                                                      Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#E8EFED" BorderThickness="1">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Reference}" FontWeight="SemiBold" FontSize="12"/>
                                                                <TextBlock Text="{Binding DateDisplay}" FontSize="10" Foreground="#94A3B8"/>
                                                                <TextBlock Text="{Binding AmountDisplay}" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,4,0,0"/>
                                                            </StackPanel>
                                                            <Border Grid.Column="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Top"
                                                                    Background="{Binding StatusBadgeBackground}">
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="10" Foreground="{Binding StatusBadgeForeground}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Interventions}"
                                                      Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#E8EFED" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DateDisplay}" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                                            <TextBlock Text="{Binding AmountDisplay}" FontWeight="SemiBold" Foreground="#2D6A4F"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Grid.Row="2" Padding="14,10,14,12" BorderBrush="#E8EFED" BorderThickness="0,1,0,0">
                                    <Button Command="{Binding ViewContractDetailsCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" HorizontalAlignment="Stretch" Padding="12,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="FileDocumentOutline" Margin="0,0,8,0"/>
                                            <TextBlock Text="Voir contrat détaillé"/>
                                        </StackPanel>
                                    </Button>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Graphiques -->
                <UniformGrid Grid.Row="3" Columns="3" Margin="0,8,0,0">
                    <Border Style="{StaticResource SuppliersAnalyticsCard}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Dépenses par catégorie" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:PieChart Series="{Binding ExpensePieSeries}" Height="130"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SuppliersAnalyticsCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Évolution des dépenses (6 mois)" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding ExpenseTrendSeries}" Height="130"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SuppliersAnalyticsCard}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Top fournisseurs coûteux" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding TopSuppliersSeries}" Height="130"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>

        <!-- Modal ajout -->
        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsAddFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nouveau fournisseur" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="Code fournisseur" Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Nom entreprise *" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding SupplierCategories}" SelectedItem="{Binding FormCategory}" Style="{StaticResource SuppliersFilterCombo}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Téléphone" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Email" Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Contact" Text="{Binding FormContact, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CloseAddFormCommand}" Style="{StaticResource SuppliersToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Enregistrer" Command="{Binding SaveSupplierCommand}" Style="{StaticResource SuppliersPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal contrat -->
        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsContractFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nouveau contrat fournisseur" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,16"/>
                    <TextBlock Text="Fournisseur *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SupplierChoices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding ContractSupplierId}" Style="{StaticResource SuppliersFilterCombo}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" materialDesign:HintAssist.Hint="N° contrat (auto si vide)" Text="{Binding ContractNumber, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ContractStatuses}" SelectedItem="{Binding ContractStatus}" Style="{StaticResource SuppliersFilterCombo}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" Margin="0,0,8,0" SelectedDate="{Binding ContractStartDate}"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding ContractEndDate}"/>
                    </Grid>
                    <TextBox materialDesign:HintAssist.Hint="Bâtiment concerné" Text="{Binding ContractBuilding, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Description contrat *" Text="{Binding ContractDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Montant total (USD) *" Text="{Binding ContractAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding ContractError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding ContractError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CloseContractFormCommand}" Style="{StaticResource SuppliersToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Enregistrer" Command="{Binding SaveContractCommand}" Style="{StaticResource SbmsLoginPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal facture -->
        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsInvoiceFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nouvelle facture fournisseur" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,16"/>
                    <TextBlock Text="Fournisseur *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SupplierChoices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding InvoiceSupplierId}" Style="{StaticResource SuppliersFilterCombo}" Margin="0,0,0,8"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0" Margin="0,0,8,0" SelectedDate="{Binding InvoiceDate}"/>
                        <DatePicker Grid.Column="1" SelectedDate="{Binding InvoiceDueDate}"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,8,0" materialDesign:HintAssist.Hint="Réf facture (auto si vide)" Text="{Binding InvoiceReference, UpdateSourceTrigger=PropertyChanged}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding InvoiceCategories}" SelectedItem="{Binding InvoiceCategory}"
                                  Style="{StaticResource SuppliersFilterCombo}" />
                    </Grid>
                    <TextBox materialDesign:HintAssist.Hint="Nouveau type de dépense (si absent du select)"
                             Text="{Binding InvoiceNewCategory, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Description facture *" Text="{Binding InvoiceDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Montant facture (USD) *" Text="{Binding InvoiceAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <CheckBox Content="Facture déjà payée (soumettre validation PDG)" IsChecked="{Binding InvoiceIsPaid}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding InvoiceError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding InvoiceError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CloseInvoiceFormCommand}" Style="{StaticResource SuppliersToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Enregistrer" Command="{Binding SaveInvoiceCommand}" Style="{StaticResource SbmsLoginPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal intervention -->
        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsInterventionFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="520" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Planifier intervention fournisseur" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,16"/>
                    <TextBlock Text="Fournisseur *" FontSize="11" Foreground="#64748B" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding SupplierChoices}" DisplayMemberPath="Name" SelectedValuePath="Id"
                              SelectedValue="{Binding InterventionSupplierId}" Style="{StaticResource SuppliersFilterCombo}" Margin="0,0,0,8"/>
                    <DatePicker SelectedDate="{Binding InterventionDate}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Description intervention *" Text="{Binding InterventionDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Budget estimé (USD) *" Text="{Binding InterventionAmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding InterventionError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding InterventionError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CloseInterventionFormCommand}" Style="{StaticResource SuppliersToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Planifier" Command="{Binding SaveInterventionCommand}" Style="{StaticResource SbmsLoginPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Modal détail contrat -->
        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsContractDetailsOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel DataContext="{Binding SelectedSupplier}">
                    <DockPanel Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Command="{Binding DataContext.CloseContractDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                        <TextBlock Text="Contrat fournisseur - détail complet" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                    </DockPanel>

                    <Border Background="#F8FAFC" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" Foreground="#1B3D3B"/>
                            <TextBlock Text="{Binding Code}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding ContactName}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="N° contrat" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding ContractDisplay}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Statut contrat" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding ContractStatus}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Début contrat" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding ContractStartDisplay}" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Fin contrat" FontSize="11" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding ContractEndDisplay}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Bâtiment" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding Building}" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBlock Text="Montant contrat" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding ContractAmountDisplay}" FontSize="18" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,6"/>
                    <TextBlock Text="Description" FontSize="11" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding ContractDescription}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding DataContext.ExportContractPdfCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Exporter PDF" Style="{StaticResource SuppliersToolbarButton}" Margin="0,0,8,0"/>
                        <Button Command="{Binding DataContext.CloseContractDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Fermer" Style="{StaticResource SbmsLoginPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="{StaticResource SbmsAccentGreenBrush}"/>
    </Grid>
</UserControl>
