<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.VisitsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             xmlns:helpers="clr-namespace:SmartBuilding.Desktop.WPF.Helpers"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/VisitsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Accueil › Visites &amp; Accès" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    <TextBlock Text="Visites &amp; Accès" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Gestion des visiteurs, contrôle d'accès et badges" FontSize="13"
                               Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,0" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Background="White" VerticalAlignment="Center" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#94A3B8"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Rechercher visiteur, code, hôte..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="8" Padding="10,6" Margin="0,0,10,0"
                            Background="{Binding SecurityStatusColor, Converter={StaticResource HexToBrushConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ShieldCheck" Width="16" Height="16" Foreground="White" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding SecurityStatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#E8F5EE" CornerRadius="8" Padding="10,6" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sync" Width="16" Height="16" Foreground="#2D6A4F" Margin="0,0,6,0"/>
                            <StackPanel>
                                <TextBlock Text="{Binding SyncStatusLabel}" FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                                <TextBlock Text="{Binding LastSyncDisplay}" FontSize="9" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40"
                            Command="{Binding ShowAlertsCommand}" ToolTip="Alertes accès">
                        <materialDesign:PackIcon Kind="BellOutline"/>
                    </Button>
                    <Border Background="#E63946" CornerRadius="9" MinWidth="18" Height="18" Margin="-14,-8,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
                    <Border Style="{StaticResource VisitsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="AccountGroup" Foreground="#2563EB" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Visiteurs aujourd'hui" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding VisitorsToday}" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Entrées du jour" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisitsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E0F2FE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="AccountClock" Foreground="#0284C7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Visites en cours" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ActiveVisits}" FontSize="18" FontWeight="Bold" Foreground="#0284C7"/>
                                <TextBlock Text="Présents sur site" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisitsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DCFCE7" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="DoorOpen" Foreground="#166534" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Accès accordés" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding AccessGranted}" FontSize="18" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="Validations réussies" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisitsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FEE2E2" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="DoorClosedLock" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Accès refusés" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding AccessDenied}" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                                <TextBlock Text="Tentatives bloquées" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisitsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#EDE9FE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="CalendarClock" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Rendez-vous planifiés" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding ScheduledAppointments}" FontSize="18" FontWeight="Bold" Foreground="#6D28D9"/>
                                <TextBlock Text="À accueillir" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisitsKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FFEDD5" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Logout" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Sorties en attente" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding PendingCheckouts}" FontSize="18" FontWeight="Bold" Foreground="#EA580C"/>
                                <TextBlock Text="Check-out à valider" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E8EFED" BorderThickness="1"
                        Padding="10,8" Margin="0,0,0,8">
                    <WrapPanel>
                        <Button Command="{Binding OpenAddFormCommand}" Style="{StaticResource VisitsPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,6,0"/>
                                <TextBlock Text="Nouveau visiteur"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenAppointmentFormCommand}" Style="{StaticResource VisitsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CalendarPlus" Margin="0,0,6,0"/>
                                <TextBlock Text="Nouveau rendez-vous"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenBadgeScannerCommand}" Style="{StaticResource VisitsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CardAccountDetails" Margin="0,0,6,0"/>
                                <TextBlock Text="Scanner badge"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenHistoryCommand}" Style="{StaticResource VisitsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Margin="0,0,6,0"/>
                                <TextBlock Text="Historique accès"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource VisitsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FilePdfBox" Margin="0,0,6,0"/>
                                <TextBlock Text="Export PDF"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource VisitsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MicrosoftExcel" Margin="0,0,6,0"/>
                                <TextBlock Text="Export Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SyncCommand}" Style="{StaticResource VisitsToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Margin="0,0,6,0"/>
                                <TextBlock Text="Synchroniser"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,8">
                    <Border Style="{StaticResource VisitsAnalyticsCard}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Visites quotidiennes" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding DailyTrendSeries}" Height="115"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisitsAnalyticsCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Types visiteurs" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:PieChart Series="{Binding TypePieSeries}" Height="115"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisitsAnalyticsCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Accès validés/refusés" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding AccessBarSeries}" Height="115"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource VisitsAnalyticsCard}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Heures de fréquentation" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding HourlySeries}" Height="115"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Grid Grid.Row="3" MinHeight="420">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <Border Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1" Padding="10,8">
                            <DockPanel>
                                <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <ComboBox ItemsSource="{Binding TypeFilters}" SelectedItem="{Binding FilterType}" Style="{StaticResource VisitsFilterCombo}"/>
                                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource VisitsFilterCombo}"/>
                                        <ComboBox ItemsSource="{Binding BuildingFilters}" SelectedItem="{Binding FilterBuilding}" Style="{StaticResource VisitsFilterCombo}"/>
                                        <ComboBox ItemsSource="{Binding PeriodFilters}" SelectedItem="{Binding FilterPeriod}" Style="{StaticResource VisitsFilterCombo}"/>
                                        <ComboBox ItemsSource="{Binding HostFilters}" SelectedItem="{Binding FilterHost}" Style="{StaticResource VisitsFilterCombo}"/>
                                        <TextBox Style="{StaticResource VisitsFilterSearch}" materialDesign:HintAssist.Hint="Rechercher..."
                                                 Text="{Binding TableSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </ScrollViewer>

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              CanContentScroll="False"
                                              PanningMode="Both"
                                              Margin="0,0,0,6"
                                              MinHeight="220"
                                              MaxHeight="420">
                                <DataGrid x:Name="VisitsGrid"
                                          ItemsSource="{Binding Visits}"
                                          SelectedItem="{Binding SelectedVisit}"
                                          Style="{StaticResource VisitsDataGrid}"
                                          helpers:DataGridScrollHelper.IsEnabled="True"
                                          materialDesign:DataGridAssist.CellPadding="8,6"
                                          MinHeight="200"
                                          MinWidth="1280"
                                          MouseDoubleClick="VisitsGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="" Width="52" CanUserResize="False">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Width="36" Height="36" CornerRadius="8"
                                                            Background="{Binding LogoBackground, Converter={StaticResource HexToBrushConverter}}">
                                                        <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="11"
                                                                   Foreground="{Binding LogoForeground, Converter={StaticResource HexToBrushConverter}}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="CODE" Binding="{Binding VisitCode}" Width="90"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="VISITEUR" Binding="{Binding FullName}" Width="130"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Phone}" Width="105"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="HÔTE" Binding="{Binding HostName}" Width="110"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="TYPE" Binding="{Binding VisitType}" Width="100"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="ZONE" Binding="{Binding Zone}" Width="110"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="MOTIF" Binding="{Binding Purpose}" Width="200" MinWidth="160"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="ENTRÉE" Binding="{Binding CheckInDisplay}" Width="110"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="SORTIE" Binding="{Binding CheckOutDisplay}" Width="95"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTemplateColumn Header="ACCÈS" Width="130" MinWidth="120">
                                            <DataGridTemplateColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource VisitsDataGridCell}">
                                                    <Setter Property="Padding" Value="12,10"/>
                                                </Style>
                                            </DataGridTemplateColumn.CellStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="10" Padding="12,7" MinWidth="96" HorizontalAlignment="Left"
                                                            Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrushConverter}}"
                                                            BorderBrush="#CBD5E1" BorderThickness="1">
                                                        <TextBlock Text="{Binding AccessStatus}"
                                                                   Foreground="{Binding StatusBadgeForeground, Converter={StaticResource HexToBrushConverter}}"
                                                                   FontSize="13" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="BADGE" Binding="{Binding BadgeNumber}" Width="120" MinWidth="100"
                                                            ElementStyle="{StaticResource VisitsBadgeText}"/>
                                        <DataGridTemplateColumn Header="ACTIONS" Width="120" MinWidth="110">
                                            <DataGridTemplateColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource VisitsDataGridCell}">
                                                    <Setter Property="Padding" Value="10,8"/>
                                                </Style>
                                            </DataGridTemplateColumn.CellStyle>
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Command="{Binding DataContext.SelectVisitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource VisitsIconActionButton}" ToolTip="Voir le détail">
                                                            <materialDesign:PackIcon Kind="EyeOutline" Width="20" Height="20"/>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.OpenBadgeScannerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource VisitsIconActionButton}" Margin="0"
                                                                ToolTip="Scanner le badge">
                                                            <materialDesign:PackIcon Kind="CardAccountDetails" Width="20" Height="20"/>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </ScrollViewer>

                                <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,8"
                                        Visibility="{Binding HasVisitsInGrid, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <TextBlock Text="Aucun visiteur pour ces filtres. Cliquez sur « Nouveau visiteur » pour enregistrer une entrée."
                                               Foreground="#64748B" FontSize="12" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                                </Border>

                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding PaginationText}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Foreground="{StaticResource SbmsTextMutedBrush}" FontSize="11"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <ComboBox Width="70" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Margin="0,0,16,0"/>
                                        <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                            <materialDesign:PackIcon Kind="ChevronLeft"/>
                                        </Button>
                                        <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
                                        <TextBlock Text="/" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                        <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="8,0" Foreground="#94A3B8"/>
                                        <Button Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                            <materialDesign:PackIcon Kind="ChevronRight"/>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource VisitsSubTableCard}">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Rendez-vous planifiés" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="160">
                                <DataGrid ItemsSource="{Binding Appointments}" Style="{StaticResource VisitsDataGrid}"
                                          helpers:DataGridScrollHelper.IsEnabled="True"
                                          materialDesign:DataGridAssist.CellPadding="6,3" MinWidth="700" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="VISITEUR" Binding="{Binding VisitorName}" Width="140" MinWidth="120"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="HÔTE" Binding="{Binding HostName}" Width="110"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="HORAIRE" Binding="{Binding ScheduledDisplay}" Width="120"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTextColumn Header="SALLE" Binding="{Binding Room}" Width="100"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                        <DataGridTemplateColumn Header="STATUT" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="8" Padding="6,2" Background="{Binding StatusBadgeBackground}">
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBadgeForeground}"
                                                                   FontSize="10" FontWeight="SemiBold"/>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="DURÉE" Binding="{Binding DurationDisplay}" Width="80"
                                                            ElementStyle="{StaticResource VisitsCellText}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <!-- 1. Détail visiteur (en haut, toujours visible) -->
                        <Border Style="{StaticResource VisitsSidebarCard}" BorderBrush="#2D6A4F" BorderThickness="2" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDetailPanelCommand}"
                                            Style="{StaticResource MaterialDesignIconButton}" ToolTip="Effacer la sélection">
                                        <materialDesign:PackIcon Kind="Close"/>
                                    </Button>
                                    <TextBlock Text="Détail visiteur" FontSize="16" FontWeight="Bold" Foreground="#1B3D3B"/>
                                </DockPanel>

                                <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="10" Padding="16" MinHeight="120"
                                        Visibility="{Binding SelectedVisit, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                                    <TextBlock Text="Sélectionnez un visiteur dans le tableau pour afficher le détail et agir sur l'accès."
                                               Foreground="#64748B" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Row="1" DataContext="{Binding SelectedVisit}"
                                            Visibility="{Binding SelectedVisit, Converter={StaticResource NullToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                        <Border Width="56" Height="56" CornerRadius="12" Margin="0,0,12,0"
                                                Background="{Binding LogoBackground, Converter={StaticResource HexToBrushConverter}}">
                                            <TextBlock Text="{Binding Initials}" FontSize="18" FontWeight="Bold"
                                                       Foreground="{Binding LogoForeground, Converter={StaticResource HexToBrushConverter}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontSize="17" FontWeight="Bold" Foreground="#1B3D3B"/>
                                            <TextBlock Text="{Binding VisitCode}" FontSize="12" Foreground="#64748B" Margin="0,2,0,6"/>
                                            <WrapPanel>
                                                <Border CornerRadius="8" Padding="8,4" Margin="0,0,6,0"
                                                        Background="{Binding StatusBadgeBackground, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderBrush="#CBD5E1" BorderThickness="1">
                                                    <TextBlock Text="{Binding AccessStatus}"
                                                               Foreground="{Binding StatusBadgeForeground, Converter={StaticResource HexToBrushConverter}}"
                                                               FontWeight="Bold" FontSize="12"/>
                                                </Border>
                                                <Border Background="#F1F5F9" CornerRadius="8" Padding="8,4" BorderBrush="#E2E8F0" BorderThickness="1">
                                                    <TextBlock Text="{Binding VisitType}" Foreground="#475569" FontWeight="SemiBold" FontSize="12"/>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Téléphone" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding Phone}" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="Hôte" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,2"/>
                                            <TextBlock Text="{Binding HostName}" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="Badge" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,2"/>
                                            <TextBlock Text="{Binding BadgeNumber}" FontSize="14" FontWeight="SemiBold" FontFamily="Consolas"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Entrée" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding CheckInDisplay}" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="Sortie" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,2"/>
                                            <TextBlock Text="{Binding CheckOutDisplay}" FontSize="13" Foreground="#1E293B"/>
                                            <TextBlock Text="Durée" FontSize="11" Foreground="#94A3B8" Margin="0,8,0,2"/>
                                            <TextBlock Text="{Binding PresenceDurationDisplay}" FontSize="13" FontWeight="SemiBold" Foreground="#1E293B"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Motif" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding Purpose}" FontSize="13" TextWrapping="Wrap" Foreground="#1E293B" Margin="0,0,0,8"/>
                                    <TextBlock Text="Zones autorisées" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding AllowedZones}" FontSize="13" TextWrapping="Wrap" Foreground="#1E293B"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Margin="0,12,0,0"
                                            Visibility="{Binding SelectedVisit, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Button Command="{Binding GrantAccessCommand}" Style="{StaticResource VisitsToolbarButton}"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="12,10">
                                        <TextBlock Text="Accorder l'accès" HorizontalAlignment="Center" FontSize="13"/>
                                    </Button>
                                    <Button Command="{Binding DenyAccessCommand}" Style="{StaticResource VisitsToolbarButton}"
                                            HorizontalAlignment="Stretch" Margin="0,0,0,8" Padding="12,10">
                                        <TextBlock Text="Refuser l'accès" Foreground="#DC2626" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button Command="{Binding ValidateCheckoutCommand}" Style="{StaticResource VisitsPrimaryButton}"
                                            HorizontalAlignment="Stretch" Padding="12,10">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Logout" Margin="0,0,8,0"/>
                                            <TextBlock Text="Valider la sortie" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                        <StackPanel>
                        <!-- 2. Alertes accès (juste après le détail) -->
                        <Border Style="{StaticResource VisitsSidebarCard}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Alertes accès" FontWeight="SemiBold" FontSize="14" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon Kind="ShieldAlert" Width="20" Height="20"
                                                                             Foreground="{Binding AccentColor, Converter={StaticResource HexToBrushConverter}}"
                                                                             VerticalAlignment="Top" Margin="0,0,10,0"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#1B3D3B"/>
                                                        <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource VisitsSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Zones d'accès" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding AccessZones}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,6" BorderBrush="#E8EFED" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ZoneName}" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#64748B" Margin="0,2,0,0"/>
                                                        <TextBlock FontSize="10" Foreground="#94A3B8" Margin="0,2,0,0"
                                                                   Text="{Binding ActiveCount, StringFormat={}{0} visiteur(s) actif(s)}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Top"
                                                            Background="{Binding StatusBackground}">
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                                   Foreground="{Binding StatusColor, Converter={StaticResource HexToBrushConverter}}"
                                                                   FontWeight="SemiBold"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource VisitsSidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Indicateurs" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Insights}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#94A3B8"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding Accent}" TextWrapping="Wrap" MaxWidth="150" TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsAddFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nouveau visiteur" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="Nom complet *" Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Téléphone" Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Hôte / Contact *" Text="{Binding FormHost, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Motif de visite" Text="{Binding FormPurpose, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding VisitTypes}" SelectedItem="{Binding FormVisitType}" Style="{StaticResource VisitsFilterCombo}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding VisitZones}" SelectedItem="{Binding FormZone}" Style="{StaticResource VisitsFilterCombo}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CloseAddFormCommand}" Style="{StaticResource VisitsToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Enregistrer" Command="{Binding SaveVisitorCommand}" Style="{StaticResource VisitsPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsAppointmentFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nouveau rendez-vous" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="Nom du visiteur *" Text="{Binding FormApptVisitorName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Hôte *" Text="{Binding FormApptHost, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Motif" Text="{Binding FormApptPurpose, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Salle / Lieu" Text="{Binding FormApptRoom, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <DatePicker SelectedDate="{Binding FormApptDate}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Heure (HH:mm)" Text="{Binding FormApptTime, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Durée (minutes)" Text="{Binding FormApptDuration, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CloseAppointmentFormCommand}" Style="{StaticResource VisitsToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Planifier" Command="{Binding SaveAppointmentCommand}" Style="{StaticResource VisitsPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsBadgeScannerOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Scanner badge / code" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,12"/>
                    <TextBox materialDesign:HintAssist.Hint="Badge ou code visite (ex. B-1001)"
                             Text="{Binding FormBadgeQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding BadgeScanResult}" Foreground="#166534" FontWeight="SemiBold" Margin="0,0,0,8"
                               Visibility="{Binding BadgeScanResult, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Fermer" Command="{Binding CloseBadgeScannerCommand}" Style="{StaticResource VisitsToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Rechercher" Command="{Binding ScanBadgeCommand}" Style="{StaticResource VisitsToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Valider entrée" Command="{Binding CheckInBadgeCommand}" Style="{StaticResource VisitsPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsHistoryPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="16" MaxWidth="900" MaxHeight="520"
                    VerticalAlignment="Center" HorizontalAlignment="Center" Width="860">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Command="{Binding CloseHistoryCommand}" Style="{StaticResource MaterialDesignIconButton}">
                            <materialDesign:PackIcon Kind="Close"/>
                        </Button>
                        <TextBlock Text="Historique des accès" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding HistoryVisits}" Style="{StaticResource VisitsDataGrid}" IsReadOnly="True"
                              MaxHeight="420" materialDesign:DataGridAssist.CellPadding="6,3">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="CODE" Binding="{Binding VisitCode}" Width="90"/>
                            <DataGridTextColumn Header="VISITEUR" Binding="{Binding FullName}" Width="130"/>
                            <DataGridTextColumn Header="HÔTE" Binding="{Binding HostName}" Width="110"/>
                            <DataGridTextColumn Header="ENTRÉE" Binding="{Binding CheckInDisplay}" Width="120"/>
                            <DataGridTextColumn Header="SORTIE" Binding="{Binding CheckOutDisplay}" Width="100"/>
                            <DataGridTextColumn Header="ACCÈS" Binding="{Binding AccessStatus}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Border>

        <Border Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                Background="#1B3D3B" CornerRadius="8" Padding="12,6"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding StatusMessage}" Foreground="White" FontSize="12"/>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="#023E8A"/>
    </Grid>
</UserControl>
