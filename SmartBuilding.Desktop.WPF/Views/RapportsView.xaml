<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.RapportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/RapportsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:TabIndexActiveConverter x:Key="TabIndexActiveConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête premium -->
        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Rapports &amp; Statistiques" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Vue consolidée — direction, gestion et audit" FontSize="13"
                               Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,0" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Background="#FAFCFB" VerticalAlignment="Center" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20"
                                                 Foreground="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Recherche instantanée dans la section active..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <StackPanel>
                <!-- Barre d'actions globale -->
                <Border Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,10"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Période" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#64748B"/>
                            <DatePicker SelectedDate="{Binding DateFrom}" Width="130" Margin="0,0,8,0"/>
                            <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#94A3B8"/>
                            <DatePicker SelectedDate="{Binding DateTo}" Width="130" Margin="0,0,16,0"/>
                            <Button Content="Actualiser" Command="{Binding LoadCommand}"
                                    Style="{StaticResource FinancesActionButton}" Margin="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource FinancesActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FilePdfBox" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="PDF"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ExportExcelCommand}" Style="{StaticResource FinancesActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="MicrosoftExcel" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Excel"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding PrintReportCommand}" Style="{StaticResource FinancesActionButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Imprimer"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SaveFiltersCommand}" Style="{StaticResource FinancesActionHeroButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ContentSave" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="Sauver filtres"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Onglets sections -->
                <Border Background="White" CornerRadius="10" Padding="8,6" Margin="0,0,0,10"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SectionTabs}" AlternationCount="99">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SetSectionTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}}"
                                            Content="{Binding}" Margin="2,0">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FinancesMainTabButton}">
                                                <Style.Triggers>
                                                    <DataTrigger Value="True">
                                                        <DataTrigger.Binding>
                                                            <MultiBinding Converter="{StaticResource TabIndexActiveConverter}">
                                                                <Binding Path="DataContext.SelectedSectionTab" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                <Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource AncestorType=ContentPresenter}"/>
                                                            </MultiBinding>
                                                        </DataTrigger.Binding>
                                                        <Setter Property="Foreground" Value="#1B3D3B"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="BorderBrush" Value="#2D6A4F"/>
                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- KPI Cards -->
                <UniformGrid Columns="5" Margin="0,0,0,10">
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Kpi1Label}" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Kpi1Value}" FontSize="16" FontWeight="Bold" Foreground="#1B3D3B"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Kpi2Label}" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Kpi2Value}" FontSize="16" FontWeight="Bold" Foreground="#166534"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Kpi3Label}" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Kpi3Value}" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Kpi4Label}" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Kpi4Value}" FontSize="16" FontWeight="Bold" Foreground="#2563EB"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource FinancesKpiCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Kpi5Label}" FontSize="10" Foreground="#94A3B8"/>
                            <TextBlock Text="{Binding Kpi5Value}" FontSize="16" FontWeight="Bold" Foreground="#7C3AED"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Filtres contextuels -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                            <ComboBox ItemsSource="{Binding DepartementFilters}" SelectedItem="{Binding FilterDepartement}" Style="{StaticResource FinancesFilterCombo}" MinWidth="140" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding StatutPersonnelFilters}" SelectedItem="{Binding FilterStatutPersonnel}" Style="{StaticResource FinancesFilterCombo}" MinWidth="120" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding PresenceFilters}" SelectedItem="{Binding FilterPresence}" Style="{StaticResource FinancesFilterCombo}" MinWidth="120"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                            <ComboBox ItemsSource="{Binding StatutLoyerFilters}" SelectedItem="{Binding FilterStatutLoyer}" Style="{StaticResource FinancesFilterCombo}" MinWidth="160"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                            <ComboBox ItemsSource="{Binding CategorieDepenseFilters}" SelectedItem="{Binding FilterCategorieDepense}" Style="{StaticResource FinancesFilterCombo}" MinWidth="180"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                            <ComboBox ItemsSource="{Binding CategorieConsoFilters}" SelectedItem="{Binding FilterCategorieConso}" Style="{StaticResource FinancesFilterCombo}" MinWidth="180"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=5}">
                            <ComboBox ItemsSource="{Binding TypeContratFilters}" SelectedItem="{Binding FilterTypeContrat}" Style="{StaticResource FinancesFilterCombo}" MinWidth="140" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding StatutContratFilters}" SelectedItem="{Binding FilterStatutContrat}" Style="{StaticResource FinancesFilterCombo}" MinWidth="140"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=6}">
                            <ComboBox ItemsSource="{Binding StatutIncidentFilters}" SelectedItem="{Binding FilterStatutIncident}" Style="{StaticResource FinancesFilterCombo}" MinWidth="160"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=8}">
                            <ComboBox ItemsSource="{Binding ModuleActiviteFilters}" SelectedItem="{Binding FilterModuleActivite}" Style="{StaticResource FinancesFilterCombo}" MinWidth="160" Margin="0,0,8,0"/>
                            <ComboBox ItemsSource="{Binding UtilisateurActiviteFilters}" SelectedItem="{Binding FilterUtilisateurActivite}" Style="{StaticResource FinancesFilterCombo}" MinWidth="160"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Section Financier : graphiques + synthèse -->
                <Grid Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=4}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="280"/>
                    </Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                        <Border Background="White" CornerRadius="10" Padding="16" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="REVENUS" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Loyers encaissés" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FinancierSummary.LoyersEncaissesDisplay}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="Garanties" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FinancierSummary.GarantiesDisplay}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Text="Services" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FinancierSummary.ServicesDisplay}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Text="Revenus divers" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FinancierSummary.RevenusDiversDisplay}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="16" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DÉPENSES" FontWeight="Bold" Foreground="#DC2626" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Salaires" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FinancierSummary.SalairesDisplay}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Text="Consommations" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FinancierSummary.ConsommationsDisplay}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Text="Maintenance" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FinancierSummary.MaintenanceDisplay}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="3" Text="Fournisseurs" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FinancierSummary.FournisseursDisplay}" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="4" Text="Charges diverses" Foreground="#64748B"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FinancierSummary.ChargesDiversesDisplay}" FontWeight="SemiBold"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <UniformGrid Grid.Row="1" Columns="2" Rows="2">
                        <Border Background="White" CornerRadius="10" Padding="8" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Revenus mensuels" FontWeight="SemiBold" Margin="8,4"/>
                                <lvc:CartesianChart Series="{Binding RevenueSeries}" Height="110" Margin="4"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="8" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Dépenses mensuelles" FontWeight="SemiBold" Margin="8,4"/>
                                <lvc:CartesianChart Series="{Binding ExpenseSeries}" Height="110" Margin="4"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="8" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Trésorerie" FontWeight="SemiBold" Margin="8,4"/>
                                <lvc:CartesianChart Series="{Binding TreasurySeries}" Height="110" Margin="4"/>
                            </StackPanel>
                        </Border>
                        <Border Background="White" CornerRadius="10" Padding="8" Margin="4" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Flux consommations" FontWeight="SemiBold" Margin="8,4"/>
                                <lvc:CartesianChart Series="{Binding ConsumptionSeries}" Height="110" Margin="4"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- Graphique consommations (section 3) -->
                <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,10"
                        BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                    <StackPanel>
                        <TextBlock Text="Évolution des coûts (12 mois)" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                        <lvc:CartesianChart Series="{Binding ConsumptionSeries}" Height="160"/>
                    </StackPanel>
                </Border>

                <!-- Tableaux -->
                <Border Style="{StaticResource RapportsTableContainer}"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                    <DataGrid ItemsSource="{Binding PersonnelRows}" Style="{StaticResource RapportsDataGrid}"
                              CanUserSortColumns="True" MinWidth="1680"
                              materialDesign:DataGridAssist.CellPadding="14,10">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RapportsCellText}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="MATRICULE" Binding="{Binding Matricule}" Width="110" MinWidth="90"/>
                            <DataGridTextColumn Header="NOM COMPLET" Binding="{Binding NomComplet}" Width="200" MinWidth="140"/>
                            <DataGridTextColumn Header="FONCTION" Binding="{Binding Fonction}" Width="150" MinWidth="110"/>
                            <DataGridTextColumn Header="DÉPARTEMENT" Binding="{Binding Departement}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn Header="EMBAUCHE" Binding="{Binding DateEmbaucheDisplay}" Width="110" MinWidth="95"/>
                            <DataGridTextColumn Header="ANCIENNETÉ" Binding="{Binding Anciennete}" Width="120" MinWidth="90"/>
                            <DataGridTextColumn Header="PRÉSENCES" Binding="{Binding Presences}" Width="85" MinWidth="70"/>
                            <DataGridTextColumn Header="ABSENCES" Binding="{Binding Absences}" Width="85" MinWidth="70"/>
                            <DataGridTextColumn Header="RETARDS" Binding="{Binding Retards}" Width="80" MinWidth="65"/>
                            <DataGridTextColumn Header="SALAIRE" Binding="{Binding SalaireDisplay}" Width="120" MinWidth="100"/>
                            <DataGridTextColumn Header="STATUT PAIEMENT" Binding="{Binding StatutPaiement}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn Header="DERNIER PAIEMENT" Binding="{Binding DernierPaiement}" Width="140" MinWidth="110"/>
                            <DataGridTextColumn Header="STATUT" Binding="{Binding Statut}" Width="100" MinWidth="80"/>
                            <DataGridTextColumn Header="OBSERVATIONS" Binding="{Binding Observations}" Width="280" MinWidth="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource RapportsTableContainer}"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                    <DataGrid ItemsSource="{Binding LoyerRows}" Style="{StaticResource RapportsDataGrid}"
                              CanUserSortColumns="True" MinWidth="1580"
                              materialDesign:DataGridAssist.CellPadding="14,10">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RapportsCellText}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="LOCATAIRE" Binding="{Binding NomComplet}" Width="180" MinWidth="130"/>
                            <DataGridTextColumn Header="PROFESSION" Binding="{Binding Profession}" Width="140" MinWidth="100"/>
                            <DataGridTextColumn Header="TÉLÉPHONE" Binding="{Binding Telephone}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn Header="APPARTEMENT" Binding="{Binding Appartement}" Width="140" MinWidth="100"/>
                            <DataGridTextColumn Header="BÂTIMENT" Binding="{Binding Batiment}" Width="120" MinWidth="90"/>
                            <DataGridTextColumn Header="TYPE CONTRAT" Binding="{Binding TypeContrat}" Width="120" MinWidth="90"/>
                            <DataGridTextColumn Header="MONTANT LOYER" Binding="{Binding MontantLoyerDisplay}" Width="130" MinWidth="110"/>
                            <DataGridTextColumn Header="GARANTIE" Binding="{Binding GarantieDisplay}" Width="120" MinWidth="100"/>
                            <DataGridTextColumn Header="DATE ÉCHÉANCE" Binding="{Binding DateEcheance}" Width="120" MinWidth="100"/>
                            <DataGridTextColumn Header="DERNIER PAIEMENT" Binding="{Binding DernierPaiement}" Width="140" MinWidth="110"/>
                            <DataGridTemplateColumn Header="STATUT PAIEMENT" Width="160" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="10,6" Margin="4,2" Background="{Binding StatutBadgeBackground}">
                                            <TextBlock Text="{Binding StatutPaiement}" Foreground="{Binding StatutBadgeForeground}"
                                                       FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource RapportsTableContainer}"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                    <DataGrid ItemsSource="{Binding DepenseRows}" Style="{StaticResource RapportsDataGrid}"
                              CanUserSortColumns="True" MinWidth="1760"
                              materialDesign:DataGridAssist.CellPadding="14,10">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RapportsCellText}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="110" MinWidth="95"/>
                            <DataGridTextColumn Header="CATÉGORIE" Binding="{Binding Categorie}" Width="140" MinWidth="110"/>
                            <DataGridTextColumn Header="MONTANT" Binding="{Binding MontantDisplay}" Width="120" MinWidth="100"/>
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="280" MinWidth="180"/>
                            <DataGridTextColumn Header="RESPONSABLE" Binding="{Binding Responsable}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn Header="SERVICE" Binding="{Binding Service}" Width="120" MinWidth="90"/>
                            <DataGridTextColumn Header="JUSTIFICATIF" Binding="{Binding Justificatif}" Width="130" MinWidth="90"/>
                            <DataGridTextColumn Header="STATUT VALIDATION" Binding="{Binding StatutValidation}" Width="150" MinWidth="110"/>
                            <DataGridTextColumn Header="CRÉÉ PAR" Binding="{Binding CreePar}" Width="120" MinWidth="90"/>
                            <DataGridTextColumn Header="VALIDÉ PAR" Binding="{Binding ValidePar}" Width="120" MinWidth="90"/>
                            <DataGridTextColumn Header="DATE VALIDATION" Binding="{Binding DateValidation}" Width="140" MinWidth="110"/>
                            <DataGridTextColumn Header="HISTORIQUE" Binding="{Binding Historique}" Width="220" MinWidth="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource RapportsTableContainer}"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                    <DataGrid ItemsSource="{Binding ConsommationRows}" Style="{StaticResource RapportsDataGrid}"
                              CanUserSortColumns="True" MinWidth="1100"
                              materialDesign:DataGridAssist.CellPadding="14,10">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RapportsCellText}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="115" MinWidth="95"/>
                            <DataGridTextColumn Header="CATÉGORIE" Binding="{Binding Categorie}" Width="160" MinWidth="120"/>
                            <DataGridTextColumn Header="QUANTITÉ" Binding="{Binding Quantite}" Width="100" MinWidth="80"/>
                            <DataGridTextColumn Header="UNITÉ" Binding="{Binding Unite}" Width="90" MinWidth="70"/>
                            <DataGridTextColumn Header="COÛT UNITAIRE" Binding="{Binding CoutUnitaireDisplay}" Width="130" MinWidth="110"/>
                            <DataGridTextColumn Header="COÛT TOTAL" Binding="{Binding CoutTotalDisplay}" Width="130" MinWidth="110"/>
                            <DataGridTextColumn Header="RESPONSABLE" Binding="{Binding Responsable}" Width="200" MinWidth="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource RapportsTableContainer}"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=5}">
                    <DataGrid ItemsSource="{Binding ContratRows}" Style="{StaticResource RapportsDataGrid}"
                              CanUserSortColumns="True" MinWidth="1200"
                              materialDesign:DataGridAssist.CellPadding="14,10">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RapportsCellText}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="N° CONTRAT" Binding="{Binding NumeroContrat}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn Header="LOCATAIRE" Binding="{Binding Locataire}" Width="180" MinWidth="130"/>
                            <DataGridTextColumn Header="APPARTEMENT" Binding="{Binding Appartement}" Width="140" MinWidth="100"/>
                            <DataGridTextColumn Header="DATE DÉBUT" Binding="{Binding DateDebut}" Width="115" MinWidth="95"/>
                            <DataGridTextColumn Header="DATE FIN" Binding="{Binding DateFin}" Width="115" MinWidth="95"/>
                            <DataGridTextColumn Header="TYPE CONTRAT" Binding="{Binding TypeContrat}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn Header="STATUT" Binding="{Binding Statut}" Width="150" MinWidth="110"/>
                            <DataGridTextColumn Header="RESPONSABLE VALIDATION" Binding="{Binding ResponsableValidation}" Width="200" MinWidth="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource RapportsTableContainer}"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=6}">
                    <DataGrid ItemsSource="{Binding IncidentRows}" Style="{StaticResource RapportsDataGrid}"
                              CanUserSortColumns="True" MinWidth="1280"
                              materialDesign:DataGridAssist.CellPadding="14,10">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RapportsCellText}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding DateDisplay}" Width="115" MinWidth="95"/>
                            <DataGridTextColumn Header="INCIDENT" Binding="{Binding Incident}" Width="180" MinWidth="120"/>
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="300" MinWidth="180"/>
                            <DataGridTextColumn Header="RESPONSABLE" Binding="{Binding Responsable}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn Header="COÛT INTERVENTION" Binding="{Binding CoutInterventionDisplay}" Width="140" MinWidth="110"/>
                            <DataGridTextColumn Header="STATUT" Binding="{Binding Statut}" Width="120" MinWidth="90"/>
                            <DataGridTextColumn Header="DATE RÉSOLUTION" Binding="{Binding DateResolution}" Width="140" MinWidth="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource RapportsTableContainer}"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=7}">
                    <DataGrid ItemsSource="{Binding VisiteRows}" Style="{StaticResource RapportsDataGrid}"
                              CanUserSortColumns="True" MinWidth="1000"
                              materialDesign:DataGridAssist.CellPadding="14,10">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RapportsCellText}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NOM VISITEUR" Binding="{Binding NomVisiteur}" Width="180" MinWidth="130"/>
                            <DataGridTextColumn Header="MOTIF" Binding="{Binding Motif}" Width="220" MinWidth="150"/>
                            <DataGridTextColumn Header="PERSONNE VISITÉE" Binding="{Binding PersonneVisitee}" Width="180" MinWidth="130"/>
                            <DataGridTextColumn Header="HEURE ENTRÉE" Binding="{Binding HeureEntree}" Width="110" MinWidth="85"/>
                            <DataGridTextColumn Header="HEURE SORTIE" Binding="{Binding HeureSortie}" Width="110" MinWidth="85"/>
                            <DataGridTextColumn Header="DURÉE PRÉSENCE" Binding="{Binding DureePresence}" Width="140" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Style="{StaticResource RapportsTableContainer}"
                        Visibility="{Binding SelectedSectionTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=8}">
                    <DataGrid ItemsSource="{Binding ActiviteRows}" Style="{StaticResource RapportsDataGrid}"
                              CanUserSortColumns="True" MinWidth="1280"
                              materialDesign:DataGridAssist.CellPadding="14,10">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource RapportsCellText}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="UTILISATEUR" Binding="{Binding Utilisateur}" Width="150" MinWidth="110"/>
                            <DataGridTextColumn Header="ACTION" Binding="{Binding Action}" Width="260" MinWidth="160"/>
                            <DataGridTextColumn Header="MODULE" Binding="{Binding Module}" Width="140" MinWidth="100"/>
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="115" MinWidth="95"/>
                            <DataGridTextColumn Header="HEURE" Binding="{Binding Heure}" Width="90" MinWidth="70"/>
                            <DataGridTextColumn Header="ADRESSE IP" Binding="{Binding AdresseIp}" Width="130" MinWidth="100"/>
                            <DataGridTextColumn Header="APPAREIL" Binding="{Binding Appareil}" Width="180" MinWidth="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="11" Margin="4,8,0,0"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" FontSize="11" Margin="4,4,0,16"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.RowSpan="2" Background="#80FFFFFF"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                <TextBlock Text="Chargement des rapports..." Margin="0,12,0,0" Foreground="#64748B"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
