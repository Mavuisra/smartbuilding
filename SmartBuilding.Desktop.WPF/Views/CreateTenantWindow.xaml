<Window x:Class="SmartBuilding.Desktop.WPF.Views.CreateTenantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
        Title="Créer un nouveau tenant"
        Width="460" Height="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Nouveau tenant" FontSize="22" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Seuls le nom du tenant et les identifiants administrateur sont requis. Vous compléterez le profil entreprise après la première connexion."
                       TextWrapping="Wrap" Foreground="#64748B" Margin="0,8,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                <TextBlock Text="Nom du tenant *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding TenantName, UpdateSourceTrigger=PropertyChanged}" Height="36" Margin="0,0,0,14"/>

                <TextBlock Text="Identifiant administrateur *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBox Text="{Binding AdminUsername, UpdateSourceTrigger=PropertyChanged}" Height="36"/>
                <TextBlock Text="Doit être unique sur ce poste (ex. admin.monentreprise)."
                           FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,14"/>

                <TextBlock Text="Mot de passe administrateur *" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <PasswordBox x:Name="AdminPasswordBox" Height="36" Margin="0,0,0,8" PasswordChanged="AdminPasswordBox_OnPasswordChanged"/>
                <TextBlock Text="Minimum 6 caractères." FontSize="11" Foreground="#64748B" Margin="0,0,0,8"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="#059669" TextWrapping="Wrap" Margin="0,4,0,0"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC2626" TextWrapping="Wrap" Margin="0,8,0,0"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,10"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Width="100" Height="36" Margin="0,0,8,0" Click="Cancel_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
                <Button x:Name="CreateButton" Content="Créer le tenant" Width="140" Height="36"
                        Background="#059669" Foreground="White" FontWeight="SemiBold"
                        Click="Create_Click"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
