<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/InventoryStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Accueil › Inventaire Technique" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    <TextBlock Text="Inventaire Technique" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Parc équipements, matériels techniques et maintenance facility" FontSize="13"
                               Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Margin="24,0" BorderBrush="#E2E8F0" BorderThickness="1"
                        CornerRadius="8" Background="White" VerticalAlignment="Center" Height="44">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Width="20" Height="20" Foreground="#94A3B8"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="Rechercher équipement, code, catégorie..."
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40">
                        <materialDesign:PackIcon Kind="BellOutline"/>
                    </Button>
                    <Border Background="#E63946" CornerRadius="9" MinWidth="18" Height="18" Margin="-14,-8,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,8">
                    <Border Style="{StaticResource InventoryKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E8F5EE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Foreground="#2D6A4F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Total équipements" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding TotalItems}" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Articles inventoriés" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DCFCE7" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="CheckCircleOutline" Foreground="#166534" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Équipements opérationnels" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding OperationalCount}" FontSize="18" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="{Binding OperationalPercent}" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FFEDD5" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="Wrench" Foreground="#EA580C" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="En maintenance" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding MaintenanceCount}" FontSize="18" FontWeight="Bold" Foreground="#EA580C"/>
                                <TextBlock Text="Interventions en cours" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#FEE2E2" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Hors service" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding OutOfServiceCount}" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                                <TextBlock Text="Pannes / indisponibles" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#EDE9FE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="CashMultiple" Foreground="#6D28D9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Valeur totale équipements" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding TotalValueDisplay}" FontSize="14" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Actif comptable (hors trésorerie)" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#DCFCE7" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="WalletOutline" Foreground="#166534" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Disponible" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding AvailableBalanceDisplay}" FontSize="14" FontWeight="Bold" Foreground="#166534"/>
                                <TextBlock Text="Loyers − dépenses" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryKpiCard}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="#E0F2FE" Margin="0,0,8,0">
                                <materialDesign:PackIcon Kind="HammerWrench" Foreground="#0369A1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="Interventions ce mois" FontSize="10" Foreground="#94A3B8"/>
                                <TextBlock Text="{Binding InterventionsThisMonth}" FontSize="18" FontWeight="Bold" Foreground="#0369A1"/>
                                <TextBlock Text="Maintenances &amp; interventions" FontSize="10" Foreground="#64748B"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Background="White" CornerRadius="8" BorderBrush="#E8EFED" BorderThickness="1"
                        Padding="10,8" Margin="0,0,0,8">
                    <WrapPanel>
                        <Button Command="{Binding OpenAddFormCommand}" Style="{StaticResource InventoryPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Margin="0,0,6,0"/>
                                <TextBlock Text="Ajouter équipement"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InventoryToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Wrench" Margin="0,0,6,0"/>
                                <TextBlock Text="Nouvelle maintenance"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InventoryToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertOctagonOutline" Margin="0,0,6,0"/>
                                <TextBlock Text="Signaler panne"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InventoryToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="History" Margin="0,0,6,0"/>
                                <TextBlock Text="Historique interventions"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource InventoryToolbarButton}">
                            <materialDesign:PackIcon Kind="FilePdfBox"/>
                        </Button>
                        <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource InventoryToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="MicrosoftExcel" Margin="0,0,6,0"/>
                                <TextBlock Text="Export Excel"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SyncCommand}" Style="{StaticResource InventoryToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sync" Margin="0,0,6,0"/>
                                <TextBlock Text="Synchroniser"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Border>

                <Grid Grid.Row="2" MinHeight="340">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="280"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1"
                            Margin="0,0,8,0" Padding="10,8">
                        <DockPanel>
                            <ScrollViewer DockPanel.Dock="Top" HorizontalScrollBarVisibility="Auto" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding FilterCategory}" Style="{StaticResource InventoryFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding LocationFilters}" SelectedItem="{Binding FilterLocation}" Style="{StaticResource InventoryFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding FilterStatus}" Style="{StaticResource InventoryFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding MaintenanceFilters}" SelectedItem="{Binding FilterMaintenance}" Style="{StaticResource InventoryFilterCombo}"/>
                                    <ComboBox ItemsSource="{Binding BuildingFilters}" SelectedItem="{Binding FilterBuilding}" Style="{StaticResource InventoryFilterCombo}"/>
                                    <TextBox Style="{StaticResource InventoryFilterSearch}" materialDesign:HintAssist.Hint="Rechercher équipement..."
                                             Text="{Binding TableSearchQuery, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </ScrollViewer>

                            <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                                      Style="{StaticResource InventoryDataGrid}" materialDesign:DataGridAssist.CellPadding="10,6" MinHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="" Width="52" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Width="36" Height="36" CornerRadius="8"
                                                        Background="{Binding LogoBackground, Converter={StaticResource HexToBrushConverter}}">
                                                    <TextBlock Text="{Binding Initials}" FontWeight="Bold" FontSize="11"
                                                               Foreground="{Binding LogoForeground, Converter={StaticResource HexToBrushConverter}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="96" MinWidth="96"
                                                        ElementStyle="{StaticResource InventoryCellText}"/>
                                    <DataGridTextColumn Header="Équipement" Binding="{Binding Name}" Width="2*" MinWidth="160"
                                                        ElementStyle="{StaticResource InventoryCellText}"/>
                                    <DataGridTextColumn Header="Catégorie" Binding="{Binding Category}" Width="150" MinWidth="130"
                                                        ElementStyle="{StaticResource InventoryCellText}"/>
                                    <DataGridTextColumn Header="Emplacement" Binding="{Binding Location}" Width="130" MinWidth="115"
                                                        ElementStyle="{StaticResource InventoryCellText}"/>
                                    <DataGridTextColumn Header="Responsable" Binding="{Binding Responsible}" Width="140" MinWidth="125"
                                                        ElementStyle="{StaticResource InventoryCellText}"/>
                                    <DataGridTextColumn Header="Dernière maint." Binding="{Binding LastMaintenanceDisplay}" Width="108" MinWidth="108"
                                                        ElementStyle="{StaticResource InventoryCellText}"/>
                                    <DataGridTextColumn Header="Prochaine maint." Binding="{Binding NextMaintenanceDisplay}" Width="108" MinWidth="108"
                                                        ElementStyle="{StaticResource InventoryCellText}"/>
                                    <DataGridTextColumn Header="Valeur estimée" Binding="{Binding EstimatedValueDisplay}" Width="130" MinWidth="120"
                                                        ElementStyle="{StaticResource InventoryCellText}"/>
                                    <DataGridTemplateColumn Header="Statut" Width="130" MinWidth="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="8" Padding="8,3" HorizontalAlignment="Left"
                                                        Background="{Binding StatusBadgeBackground}">
                                                    <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBadgeForeground}"
                                                               FontSize="11" FontWeight="SemiBold" TextTrimming="None"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Actions" Width="96" MinWidth="96" CanUserResize="False">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Voir">
                                                        <materialDesign:PackIcon Kind="EyeOutline"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Modifier">
                                                        <materialDesign:PackIcon Kind="PencilOutline"/>
                                                    </Button>
                                                    <Button Style="{StaticResource MaterialDesignIconButton}" ToolTip="Plus">
                                                        <materialDesign:PackIcon Kind="DotsVertical"/>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                <TextBlock Text="{Binding PaginationText}" DockPanel.Dock="Left" VerticalAlignment="Center"
                                           Foreground="{StaticResource SbmsTextMutedBrush}" FontSize="11"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="Par page :" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" Margin="0,0,8,0"/>
                                    <ComboBox Width="70" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}" Margin="0,0,16,0"/>
                                    <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="ChevronLeft"/>
                                    </Button>
                                    <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="8,0" FontWeight="SemiBold"/>
                                    <TextBlock Text="/" VerticalAlignment="Center" Foreground="#94A3B8"/>
                                    <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" Margin="8,0" Foreground="#94A3B8"/>
                                    <Button Command="{Binding NextPageCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="ChevronRight"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <Border Style="{StaticResource InventorySidebarCard}">
                            <StackPanel>
                                <TextBlock Text="Alertes inventaire" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <ItemsControl ItemsSource="{Binding Alerts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="#1B3D3B"/>
                                                    <TextBlock Text="{Binding Message}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="White" CornerRadius="12" BorderBrush="#E8EFED" BorderThickness="1"
                                Visibility="{Binding IsDetailPanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid MaxHeight="520">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="14,12,14,8">
                                    <Button DockPanel.Dock="Right" Command="{Binding CloseDetailPanelCommand}" Style="{StaticResource MaterialDesignIconButton}">
                                        <materialDesign:PackIcon Kind="Close"/>
                                    </Button>
                                    <TextBlock Text="Détail équipement" FontSize="14" FontWeight="Bold" Foreground="#1B3D3B" VerticalAlignment="Center"/>
                                </DockPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="14,0,14,10">
                                    <StackPanel DataContext="{Binding SelectedItem}">
                                        <Border Width="64" Height="64" CornerRadius="12" HorizontalAlignment="Center"
                                                Background="{Binding LogoBackground, Converter={StaticResource HexToBrushConverter}}" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Initials}" FontSize="20" FontWeight="Bold"
                                                       Foreground="{Binding LogoForeground, Converter={StaticResource HexToBrushConverter}}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" TextAlignment="Center" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Code}" FontSize="11" Foreground="#94A3B8" TextAlignment="Center" Margin="0,2,0,8"/>
                                        <Border Background="{Binding StatusBadgeBackground}" CornerRadius="10" Padding="10,4"
                                                HorizontalAlignment="Center" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBadgeForeground}" FontWeight="SemiBold"/>
                                        </Border>

                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="Infos" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="0" Style="{StaticResource PersonnelDetailTabButton}"/>
                                            <Button Content="Maintenances" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="1" Style="{StaticResource PersonnelDetailTabButton}"/>
                                            <Button Content="Interventions" Command="{Binding DataContext.SetDetailTabCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="2" Style="{StaticResource PersonnelDetailTabButton}"/>
                                        </WrapPanel>

                                        <StackPanel Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                                            <TextBlock Text="Informations générales" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                            <TextBlock Text="Catégorie" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Category}" Margin="0,2,0,6"/>
                                            <TextBlock Text="N° série" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding SerialNumber}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Marque / Modèle" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Margin="0,2,0,6"><Run Text="{Binding Brand}"/><Run Text=" — "/><Run Text="{Binding Model}"/></TextBlock>
                                            <TextBlock Text="Responsable" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Responsible}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Emplacement" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Location}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Bâtiment" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding Building}" Margin="0,2,0,10"/>
                                            <TextBlock Text="État actuel" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,8"/>
                                            <TextBlock Text="Dernière maintenance" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding LastMaintenanceDisplay}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Prochaine maintenance" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding NextMaintenanceDisplay}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Durée utilisation" FontSize="10" Foreground="#94A3B8"/><TextBlock Text="{Binding UsageDuration}" Margin="0,2,0,6"/>
                                            <TextBlock Text="Coûts maintenance (année)" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding YearMaintenanceCostDisplay}" FontSize="16" FontWeight="Bold" Foreground="#2D6A4F" Margin="0,2,0,6"/>
                                            <TextBlock Text="Valeur estimée" FontSize="10" Foreground="#94A3B8"/>
                                            <TextBlock Text="{Binding EstimatedValueDisplay}" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B"/>
                                        </StackPanel>

                                        <ItemsControl ItemsSource="{Binding Maintenances}"
                                                      Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#E8EFED" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DateDisplay}" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                                            <TextBlock Text="{Binding CostDisplay}" FontWeight="SemiBold" Foreground="#2D6A4F"/>
                                                            <TextBlock Text="{Binding Technician}" FontSize="10" Foreground="#94A3B8"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Interventions}"
                                                      Visibility="{Binding DataContext.SelectedDetailTab, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="10" Margin="0,0,0,8" BorderBrush="#E8EFED" BorderThickness="1">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DateDisplay}" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="11" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                                            <TextBlock Text="{Binding CostDisplay}" FontWeight="SemiBold" Foreground="#2563EB"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Grid.Row="2" Padding="14,10,14,12" BorderBrush="#E8EFED" BorderThickness="0,1,0,0">
                                    <UniformGrid Columns="2">
                                        <Button Style="{StaticResource InventoryToolbarButton}" Margin="0,0,4,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="PencilOutline" Margin="0,0,4,0"/>
                                                <TextBlock Text="Modifier"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource InventoryPrimaryButton}" Margin="4,0,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <materialDesign:PackIcon Kind="Wrench" Margin="0,0,4,0"/>
                                                <TextBlock Text="Maintenance"/>
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                </Border>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>

                <UniformGrid Grid.Row="3" Columns="4" Margin="0,8,0,0">
                    <Border Style="{StaticResource InventoryAnalyticsCard}" Margin="0,0,4,0">
                        <StackPanel>
                            <TextBlock Text="Équipements par catégorie" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:PieChart Series="{Binding CategoryPieSeries}" Height="120"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryAnalyticsCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Coûts maintenance (6 mois)" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding MaintenanceCostSeries}" Height="120"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryAnalyticsCard}" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="Équipements critiques" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding CriticalBarSeries}" Height="120"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource InventoryAnalyticsCard}" Margin="4,0,0,0">
                        <StackPanel>
                            <TextBlock Text="Historique interventions" FontWeight="SemiBold" FontSize="11" Foreground="#1B3D3B" Margin="0,0,0,4"/>
                            <lvc:CartesianChart Series="{Binding InterventionHistorySeries}" Height="120"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </ScrollViewer>

        <Border Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsAddFormOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="White" CornerRadius="12" Padding="24" MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Nouvel équipement" FontSize="18" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="Code équipement" Text="{Binding FormCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Nom équipement *" Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding ItemCategories}" SelectedItem="{Binding FormCategory}" Style="{StaticResource InventoryFilterCombo}" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding ItemLocations}" SelectedItem="{Binding FormLocation}" Style="{StaticResource InventoryFilterCombo}" Margin="0,0,0,8"/>
                    <TextBox materialDesign:HintAssist.Hint="Responsable" Text="{Binding FormResponsible, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding FormError}" Foreground="#DC2626" FontSize="12" Margin="0,0,0,8"
                               Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Annuler" Command="{Binding CloseAddFormCommand}" Style="{StaticResource InventoryToolbarButton}" Margin="0,0,8,0"/>
                        <Button Content="Enregistrer" Command="{Binding SaveItemCommand}" Style="{StaticResource InventoryPrimaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="{StaticResource SbmsAccentGreenBrush}"/>
    </Grid>
</UserControl>
