<Window x:Class="SmartBuilding.Desktop.WPF.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SBMS"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        Width="480" Height="340"
        Background="#0D1F1E">
    <Window.Resources>
        <SolidColorBrush x:Key="SplashGlassCardBrush" Color="#55B8E6CF"/>
        <SolidColorBrush x:Key="SplashGlassBorderBrush" Color="#88FFFFFF"/>

        <Storyboard x:Key="LogoPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.08" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.08" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="RingRotateStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.15"/>
        </Storyboard>

        <Storyboard x:Key="DotWaveStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.2"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.2"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.2"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.2"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.5"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.35"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="20" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.45" Color="#000000"/>
        </Border.Effect>

        <Grid x:Name="RootPanel" Opacity="0">
            <Grid.Background>
                <RadialGradientBrush GradientOrigin="0.5,0.42" Center="0.5,0.42" RadiusX="0.95" RadiusY="0.95">
                    <GradientStop Color="#3D8B6E" Offset="0"/>
                    <GradientStop Color="#2D6A4F" Offset="0.35"/>
                    <GradientStop Color="#1B4332" Offset="0.7"/>
                    <GradientStop Color="#0D1F1E" Offset="1"/>
                </RadialGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="36,28">
                <!-- Carte logo vert léger transparent -->
                <Border Width="80" Height="80" CornerRadius="18"
                        Background="{StaticResource SplashGlassCardBrush}"
                        BorderBrush="{StaticResource SplashGlassBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.25" Color="#000000"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1" CenterX="40" CenterY="40"/>
                    </Border.RenderTransform>
                    <materialDesign:PackIcon Kind="OfficeBuilding" Width="42" Height="42"
                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="SBMS" FontSize="30" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Smart Building Management" FontSize="13" Foreground="#D1FAE5"
                           HorizontalAlignment="Center" Margin="0,4,0,28"/>

                <!-- Anneau de chargement -->
                <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Ellipse Width="56" Height="56" Stroke="#44FFFFFF" StrokeThickness="3" Opacity="0.35"/>
                    <Ellipse Width="56" Height="56" Stroke="White" StrokeThickness="3"
                             StrokeDashArray="10 46" StrokeDashCap="Round" Opacity="0.95">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" CenterX="28" CenterY="28"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <TextBlock x:Name="StatusText" Text="Démarrage…" FontSize="13" Foreground="#E8F5F0"
                           HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="320" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Fill="White" Margin="5,0" Opacity="0.2"/>
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Fill="White" Margin="5,0" Opacity="0.2"/>
                    <Ellipse x:Name="Dot3" Width="8" Height="8" Fill="White" Margin="5,0" Opacity="0.2"/>
                </StackPanel>

                <ProgressBar x:Name="LoadProgress" Minimum="0" Maximum="100" Value="0" Height="3"
                             Margin="0,22,0,0" Width="260" Opacity="0.55"
                             Foreground="#FFFFFF" Background="#33FFFFFF"
                             BorderThickness="0"/>
            </StackPanel>

            <TextBlock Text="v1.0.0" FontSize="10" Foreground="#88FFFFFF"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18"/>
        </Grid>
    </Border>
</Window>
