<Window x:Class="SmartBuilding.Desktop.WPF.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="SBMS"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        Width="440" Height="300"
        Background="#1B3D3B">
    <Window.Resources>
        <Storyboard x:Key="LogoPulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="1.12" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="LogoScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="1.12" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction>
                    <SineEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="RingRotateStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360" Duration="0:0:1.2"/>
        </Storyboard>

        <Storyboard x:Key="DotWaveStoryboard" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot1" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.2" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.8" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot2" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.4" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.0" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Dot3" Storyboard.TargetProperty="Opacity" Duration="0:0:1.2">
                <DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0.25"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
                <DiscreteDoubleKeyFrame KeyTime="0:0:1.2" Value="0.25"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.35"/>
        </Storyboard>
    </Window.Resources>

    <Border CornerRadius="16" ClipToBounds="True" Background="#1B3D3B">
        <Border.Effect>
            <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.4" Color="#000000"/>
        </Border.Effect>

        <Grid x:Name="RootPanel" Opacity="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B3D3B" Offset="0"/>
                    <GradientStop Color="#2D6A4F" Offset="0.55"/>
                    <GradientStop Color="#1B4332" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32">
                <Border Width="72" Height="72" CornerRadius="16" Background="#2D6A4F"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="1" ScaleY="1" CenterX="36" CenterY="36"/>
                    </Border.RenderTransform>
                    <materialDesign:PackIcon Kind="OfficeBuilding" Width="40" Height="40"
                                             Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="SBMS" FontSize="28" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Smart Building Management" FontSize="12" Foreground="#A8C5C0"
                           HorizontalAlignment="Center" Margin="0,2,0,24"/>

                <Grid Width="52" Height="52" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Ellipse Width="52" Height="52" Stroke="#3D8B6E" StrokeThickness="4" Opacity="0.35"/>
                    <Ellipse Width="52" Height="52" Stroke="White" StrokeThickness="4"
                             StrokeDashArray="8 40" StrokeDashCap="Round">
                        <Ellipse.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" CenterX="26" CenterY="26"/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <TextBlock x:Name="StatusText" Text="Démarrage..." FontSize="13" Foreground="#D8E8E4"
                           HorizontalAlignment="Center" TextAlignment="Center"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <Ellipse x:Name="Dot1" Width="7" Height="7" Fill="White" Margin="4,0" Opacity="0.25"/>
                    <Ellipse x:Name="Dot2" Width="7" Height="7" Fill="White" Margin="4,0" Opacity="0.25"/>
                    <Ellipse x:Name="Dot3" Width="7" Height="7" Fill="White" Margin="4,0" Opacity="0.25"/>
                </StackPanel>

                <ProgressBar x:Name="LoadProgress" Minimum="0" Maximum="100" Value="0" Height="4"
                             Margin="0,20,0,0" Width="280"
                             Foreground="White" Background="#3D5A56"
                             BorderThickness="0"/>
            </StackPanel>

            <TextBlock Text="v1.0.0" FontSize="10" Foreground="#6B9080"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16"/>
        </Grid>
    </Border>
</Window>
