<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.LocationContractFormView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="#F5F7FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:FilePathToImageSourceConverter x:Key="FilePathToImageSourceConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:WizardStepCircleBrushConverter x:Key="WizardStepCircleBrushConverter"/>
            <conv:WizardStepTitleBrushConverter x:Key="WizardStepTitleBrushConverter"/>
            <conv:WizardStepNumberBrushConverter x:Key="WizardStepNumberBrushConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>

            <Style x:Key="ContractSectionCard" TargetType="Border">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="#E5EAF2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="14"/>
                <Setter Property="Padding" Value="18"/>
                <Setter Property="Margin" Value="0,0,0,14"/>
            </Style>

            <Style x:Key="ContractFieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#536173"/>
                <Setter Property="Margin" Value="0,0,0,4"/>
            </Style>

            <Style x:Key="ContractSummaryLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="#7A8699"/>
            </Style>

            <Style x:Key="ContractSummaryValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="#172033"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="22,14" BorderBrush="#E5EAF2" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Nouveau contrat de location" FontSize="24" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="{Binding Breadcrumb}" FontSize="12" Foreground="#7A8699" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding GoBackCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Annuler"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveDraftCommand}" Style="{StaticResource LocationsToolbarButton}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" Margin="0,0,6,0"/>
                            <TextBlock Text="Sauvegarder brouillon"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ToggleTenantQuickPanelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#111827" BorderBrush="#111827" Padding="12,7" Margin="0,0,8,0">
                        <TextBlock Text="Créer locataire"/>
                    </Button>
                    <Button Command="{Binding TogglePremiseQuickPanelCommand}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            Foreground="#111827" BorderBrush="#111827" Padding="12,7" Margin="0,0,8,0">
                        <TextBlock Text="Créer local"/>
                    </Button>
                    <Button Command="{Binding NextStepCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" Padding="16,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NextButtonLabel}"/>
                            <materialDesign:PackIcon Kind="ArrowRight" Width="15" Height="15" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="22,16,22,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <Border Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,14">
                        <UniformGrid Columns="5" Rows="1">
                            <Border Background="#F8FAFC" CornerRadius="10" Padding="12,10" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="Total locaux" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding StatsTotalPremises}" FontSize="22" FontWeight="Bold" Foreground="#172033"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#EFF6FF" CornerRadius="10" Padding="12,10" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="Disponibles" FontSize="10" Foreground="#2563EB"/>
                                    <TextBlock Text="{Binding StatsAvailablePremises}" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#F0FDF4" CornerRadius="10" Padding="12,10" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="Occupés" FontSize="10" Foreground="#16A34A"/>
                                    <TextBlock Text="{Binding StatsOccupiedPremises}" FontSize="22" FontWeight="Bold" Foreground="#15803D"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#FFFBEB" CornerRadius="10" Padding="12,10" Margin="3,0">
                                <StackPanel>
                                    <TextBlock Text="En attente" FontSize="10" Foreground="#D97706"/>
                                    <TextBlock Text="{Binding StatsPendingPremises}" FontSize="22" FontWeight="Bold" Foreground="#B45309"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#EEF2FF" CornerRadius="10" Padding="12,10" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="Taux d'occupation" FontSize="10" Foreground="#4F46E5"/>
                                    <TextBlock Text="{Binding StatsOccupancyRateDisplay}" FontSize="20" FontWeight="Bold" Foreground="#4338CA"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Border>

                    <Border Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,14">
                        <ItemsControl ItemsSource="{Binding WizardSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.GoToStepCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Index}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="17" Margin="0,0,10,0">
                                                <Border.Background>
                                                    <MultiBinding Converter="{StaticResource WizardStepCircleBrushConverter}">
                                                        <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="Index"/>
                                                    </MultiBinding>
                                                </Border.Background>
                                                <TextBlock Text="{Binding Number}" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource WizardStepNumberBrushConverter}">
                                                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            <Binding Path="Index"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                            </Border>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold">
                                                    <TextBlock.Foreground>
                                                        <MultiBinding Converter="{StaticResource WizardStepTitleBrushConverter}">
                                                            <Binding Path="DataContext.CurrentStep" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                            <Binding Path="Index"/>
                                                        </MultiBinding>
                                                    </TextBlock.Foreground>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#7A8699"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="{Binding StatusMessage}" Foreground="#111827" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>

                    <!-- Formulaire vif : locataire -->
                    <Border Style="{StaticResource LocationsBwFormCard}"
                            Visibility="{Binding IsTenantQuickPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Border Style="{StaticResource LocationsBwFormHeader}">
                                <TextBlock Text="Nouveau locataire" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <UniformGrid Columns="2" Margin="14,12,14,0">
                                <TextBox Margin="0,0,6,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="N° dossier" Text="{Binding FormQuickDossier, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Margin="6,0,0,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Nom complet *" Text="{Binding FormQuickTenantName, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Margin="0,0,6,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Téléphone *" Text="{Binding FormQuickTenantPhone, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Margin="6,0,0,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Email" Text="{Binding FormQuickTenantEmail, UpdateSourceTrigger=PropertyChanged}"/>
                            </UniformGrid>
                            <TextBox Margin="14,0,14,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Entreprise" Text="{Binding FormQuickTenantCompany, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,10,14,14">
                                <Button Command="{Binding ToggleTenantQuickPanelCommand}" Content="Fermer"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#111827" BorderBrush="#111827"
                                        Padding="16,8" Margin="0,0,8,0"/>
                                <Button Command="{Binding SaveQuickTenantCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" Padding="20,9">
                                    <TextBlock Text="Enregistrer le locataire" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Formulaire vif : local -->
                    <Border Style="{StaticResource LocationsBwFormCard}"
                            Visibility="{Binding IsPremiseQuickPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <Border Style="{StaticResource LocationsBwFormHeader}">
                                <TextBlock Text="Nouveau local" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            </Border>
                            <UniformGrid Columns="2" Margin="14,12,14,0">
                                <TextBox Margin="0,0,6,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Code *" Text="{Binding FormPremiseCode, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBox Margin="6,0,0,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Nom du local *" Text="{Binding FormPremiseName, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Margin="0,0,6,8" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          ItemsSource="{Binding QuickBuildings}" SelectedItem="{Binding FormPremiseBuilding}"
                                          materialDesign:HintAssist.Hint="Bâtiment"/>
                                <TextBox Margin="6,0,0,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Étage" Text="{Binding FormPremiseFloor, UpdateSourceTrigger=PropertyChanged}"/>
                                <ComboBox Margin="0,0,6,8" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding FormPremiseType}"
                                          materialDesign:HintAssist.Hint="Type"/>
                                <TextBox Margin="6,0,0,8" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:HintAssist.Hint="Surface m²" Text="{Binding FormPremiseAreaText, UpdateSourceTrigger=PropertyChanged}"/>
                            </UniformGrid>
                            <TextBox Margin="14,0,14,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     materialDesign:HintAssist.Hint="Loyer mensuel" Text="{Binding FormPremiseRentText, UpdateSourceTrigger=PropertyChanged}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="14,10,14,14">
                                <Button Command="{Binding TogglePremiseQuickPanelCommand}" Content="Fermer"
                                        Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#111827" BorderBrush="#111827"
                                        Padding="16,8" Margin="0,0,8,0"/>
                                <Button Command="{Binding SaveQuickPremiseCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" Padding="20,9">
                                    <TextBlock Text="Enregistrer le local" FontWeight="Bold"/>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ContractSectionCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                        <StackPanel>
                            <TextBlock Text="Informations du locataire" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,18,0"
                                            Visibility="{Binding FormSelectedTenant, Converter={StaticResource NullToVisibilityConverter}}">
                                    <Border Width="96" Height="96" CornerRadius="48" Background="#EEF2F7" HorizontalAlignment="Center">
                                        <Image Source="{Binding FormSelectedTenant.ProfilePhotoPath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="UniformToFill"/>
                                    </Border>
                                    <Button Style="{StaticResource LocationsToolbarButton}" Margin="0,12,0,0" Padding="8,6">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Camera" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Téléverser photo" FontSize="10"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                    <TextBlock Text="Informations personnelles" FontSize="13" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,10"/>
                                    <TextBlock Text="Nom complet *" Style="{StaticResource ContractFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding Tenants}" SelectedItem="{Binding FormSelectedTenant}" DisplayMemberPath="Label" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>
                                    <StackPanel Visibility="{Binding FormSelectedTenant, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Date de naissance" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.DateOfBirthDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Sexe" Style="{StaticResource ContractFieldLabel}"/>
                                            <TextBox Text="{Binding FormSelectedTenant.Gender, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Nationalité" Style="{StaticResource ContractFieldLabel}"/>
                                            <TextBox Text="{Binding FormSelectedTenant.Nationality, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,16,0"
                                            Visibility="{Binding FormSelectedTenant, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Contacts" FontSize="13" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,10"/>
                                    <TextBlock Text="Téléphone *" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.Phone, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Email" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.Email, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Adresse" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.Address, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Contact d'urgence" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.EmergencyContactDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3"
                                            Visibility="{Binding FormSelectedTenant, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="Informations professionnelles" FontSize="13" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,10"/>
                                    <TextBlock Text="Profession" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.Profession, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Entreprise" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.Company, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Type d'activité" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.BusinessActivity, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Nombre de personnes" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormSelectedTenant.PersonCountDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ContractSectionCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                        <StackPanel>
                            <TextBlock Text="Sélection de l'appartement / espace" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                    <TextBlock Text="Filtres rapides" FontWeight="SemiBold" Foreground="#172033" FontSize="12" Margin="0,0,0,8"/>
                                    <TextBlock Text="Bâtiment" Style="{StaticResource ContractFieldLabel}"/>
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectedIndex="0" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Tous les bâtiments"/>
                                    </ComboBox>
                                    <TextBlock Text="Type d'espace" Style="{StaticResource ContractFieldLabel}"/>
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectedIndex="0" Margin="0,0,0,8">
                                        <ComboBoxItem Content="Tous les types"/>
                                    </ComboBox>
                                    <TextBlock Text="Statut" Style="{StaticResource ContractFieldLabel}"/>
                                    <ComboBox Style="{StaticResource MaterialDesignOutlinedComboBox}" SelectedIndex="0" Margin="0,0,0,10">
                                        <ComboBoxItem Content="Disponibles"/>
                                    </ComboBox>
                                    <Button Style="{StaticResource LocationsToolbarButton}">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14" Margin="0,0,4,0"/>
                                            <TextBlock Text="Réinitialiser"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,0,0,12"
                                            Visibility="{Binding FormSelectedTenant, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Inverse}">
                                        <TextBlock Text="Sélectionnez d'abord un locataire pour afficher les locaux disponibles."
                                                   Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                                    </Border>
                                    <StackPanel Visibility="{Binding FormSelectedTenant, Converter={StaticResource NullToVisibilityConverter}}">
                                    <ListBox ItemsSource="{Binding AvailablePremises}" SelectedItem="{Binding FormSelectedPremise}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0"/>
                                                <Setter Property="Margin" Value="0,0,12,12"/>
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="165" Background="White" CornerRadius="12" Padding="8">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="BorderBrush" Value="#DCE4EF"/>
                                                            <Setter Property="BorderThickness" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="#0B63F6"/>
                                                                    <Setter Property="BorderThickness" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Border Height="76" CornerRadius="9" Background="#E8EEF7" Margin="0,0,0,8">
                                                            <Image Source="{Binding PhotoPath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="UniformToFill"/>
                                                        </Border>
                                                        <DockPanel Margin="0,0,0,4">
                                                            <Border DockPanel.Dock="Right" Background="#DCFCE7" CornerRadius="8" Padding="6,2">
                                                                <TextBlock Text="{Binding StatusLabel}" FontSize="9" Foreground="#16A34A" FontWeight="SemiBold"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" Foreground="#172033" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Building}" FontSize="10" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Floor}" FontSize="10" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding AreaDisplay}" FontSize="10" Foreground="#667085" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding RentDisplay}" FontSize="11" FontWeight="Bold" Foreground="#0B63F6" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border Background="#EEF5FF" BorderBrush="#BBD7FF" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Information" Width="16" Height="16" Foreground="#0B63F6" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding SelectedPremiseSelectionSummary, Mode=OneWay}"
                                                       Foreground="#0B63F6" FontSize="12" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ContractSectionCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                        <StackPanel>
                            <TextBlock Text="Informations contrat" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="N° contrat (automatique)" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormContractNumber, Mode=OneWay}"
                                             IsReadOnly="True"
                                             IsTabStop="False"
                                             materialDesign:HintAssist.Hint="Attribué à l'enregistrement"
                                             Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,10,10">
                                    <TextBlock Text="Date début *" Style="{StaticResource ContractFieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding FormStart}" materialDesign:HintAssist.Hint="Date début"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="0,0,10,10">
                                    <TextBlock Text="Date fin *" Style="{StaticResource ContractFieldLabel}"/>
                                    <DatePicker SelectedDate="{Binding FormEnd}" materialDesign:HintAssist.Hint="Date fin"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="0,0,0,10">
                                    <TextBlock Text="Durée *" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding ContractDurationDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                    <TextBlock Text="Type de contrat *" Style="{StaticResource ContractFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding ContractTypes}" SelectedItem="{Binding FormContractType}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3">
                                    <TextBlock Text="Loyer mensuel *" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormRentText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4">
                                    <TextBlock Text="Clauses spéciales" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormClauses, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" MinHeight="64" TextWrapping="Wrap" AcceptsReturn="True"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ContractSectionCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}">
                        <StackPanel>
                            <TextBlock Text="Garantie &amp; paiement" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,14"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Caution / garantie (USD)" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding FormDepositText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,10"/>
                                    <TextBlock Text="Fréquence paiement *" Style="{StaticResource ContractFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PaymentFrequencies}" SelectedItem="{Binding FormPaymentFrequency}" Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Mode paiement *" Style="{StaticResource ContractFieldLabel}"/>
                                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding FormPaymentMethod}" Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,10"/>
                                    <ToggleButton IsChecked="{Binding FormAutomaticRenewal}" Content="Renouvellement automatique" Margin="0,0,0,10"/>
                                    <TextBlock Text="Prochain paiement" Style="{StaticResource ContractFieldLabel}"/>
                                    <TextBox Text="{Binding NextPaymentDateDisplay, Mode=OneWay}" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ContractSectionCard}"
                            Visibility="{Binding CurrentStep, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=4}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
                            <StackPanel>
                                <TextBlock Text="Documents &amp; récapitulatif complet" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,14"/>
                                <TextBlock Text="Vérifiez l'ensemble des informations avant de créer le contrat." Foreground="#64748B" FontSize="12" Margin="0,0,0,16"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Locataire" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Nom"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding SelectedTenantName}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Téléphone"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding SelectedTenantPhone}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Email"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding SelectedTenantEmail}" Margin="0,0,0,16"/>
                                        <TextBlock Text="Espace" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Local"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding SelectedPremiseName}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Emplacement"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding SelectedPremiseSubtitle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Contrat &amp; finances" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="N° contrat"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding FormContractNumber}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Type"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding FormContractType}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Période"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Margin="0,0,0,8">
                                            <Run Text="{Binding FormStart, StringFormat={}{0:dd/MM/yyyy}}"/>
                                            <Run Text=" → "/>
                                            <Run Text="{Binding FormEnd, StringFormat={}{0:dd/MM/yyyy}}"/>
                                            <Run Text=" ("/><Run Text="{Binding ContractDurationDisplay, Mode=OneWay}"/><Run Text=")"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Loyer mensuel"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding RentSummaryDisplay}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Garantie"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding DepositSummaryDisplay}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Fréquence / mode"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Margin="0,0,0,8">
                                            <Run Text="{Binding FormPaymentFrequency}"/><Run Text=" — "/><Run Text="{Binding FormPaymentMethod}"/>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Renouvellement auto."/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding AutomaticRenewalDisplay}" Margin="0,0,0,8"/>
                                        <TextBlock Style="{StaticResource ContractSummaryLabel}" Text="Clauses spéciales"/>
                                        <TextBlock Style="{StaticResource ContractSummaryValue}" Text="{Binding FormClauses}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </StackPanel>

                <Border Grid.Column="1" Background="White" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="16" Padding="18" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Résumé du contrat" FontSize="16" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,18"/>

                        <Border Background="#F8FAFC" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                                Visibility="{Binding HasSelectedTenant, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
                            <TextBlock Text="Sélectionnez un locataire pour voir le résumé." Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                        </Border>

                        <StackPanel Visibility="{Binding HasSelectedTenant, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Locataire" FontWeight="Bold" Foreground="#172033"/>
                            <TextBlock DockPanel.Dock="Right" Text="Éditer" Foreground="#0B63F6" FontSize="11"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="54" Height="54" CornerRadius="27" Background="#EEF2F7" Margin="0,0,12,0">
                                <Image Source="{Binding FormSelectedTenant.ProfilePhotoPath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedTenantName}" FontWeight="Bold" Foreground="#172033"/>
                                <TextBlock Text="{Binding SelectedTenantEmail}" Foreground="#667085" FontSize="11"/>
                                <TextBlock Text="{Binding SelectedTenantPhone}" Foreground="#667085" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasSelectedPremise, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Appartement" FontWeight="Bold" Foreground="#172033"/>
                            <TextBlock DockPanel.Dock="Right" Text="Éditer" Foreground="#0B63F6" FontSize="11"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <Border Width="54" Height="48" CornerRadius="8" Background="#EEF2F7" Margin="0,0,12,0">
                                <Image Source="{Binding FormSelectedPremise.PhotoPath, Converter={StaticResource FilePathToImageSourceConverter}}" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedPremiseName}" FontWeight="Bold" Foreground="#172033"/>
                                <TextBlock Text="{Binding SelectedPremiseSubtitle}" Foreground="#667085" FontSize="11"/>
                                <TextBlock Text="{Binding FormSelectedPremise.AreaDisplay}" Foreground="#667085" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                        </StackPanel>

                        <StackPanel Visibility="{Binding CanShowContractDetails, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock Text="Contrat" FontWeight="Bold" Foreground="#172033"/>
                            <TextBlock DockPanel.Dock="Right" Text="Éditer" Foreground="#0B63F6" FontSize="11"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Type de contrat" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding FormContractType}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Date début" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding FormStart, StringFormat=dd/MM/yyyy}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,8,10">
                                <TextBlock Text="Date fin" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding FormEnd, StringFormat=dd/MM/yyyy}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Durée" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding ContractDurationDisplay}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Text="Loyer mensuel" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding RentSummaryDisplay}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Garantie" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Montant garantie" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding DepositSummaryDisplay}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="Statut" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="À payer" Foreground="#F59E0B" FontWeight="Bold" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Paiement mensuel" FontWeight="Bold" Foreground="#172033" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,8,10">
                                <TextBlock Text="Fréquence" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding FormPaymentFrequency}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,0,10">
                                <TextBlock Text="Mode paiement" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding FormPaymentMethod}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                                <TextBlock Text="Prochain paiement" Style="{StaticResource ContractSummaryLabel}"/>
                                <TextBlock Text="{Binding NextPaymentDateDisplay}" Style="{StaticResource ContractSummaryValue}"/>
                            </StackPanel>
                        </Grid>

                        <Border Background="#F8FAFF" BorderBrush="#E5EAF2" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,4,0,16">
                            <DockPanel>
                                <TextBlock Text="Total mensuel" FontSize="13" FontWeight="SemiBold" Foreground="#172033"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding RentSummaryDisplay}" FontSize="20" FontWeight="Bold" Foreground="#0B63F6"/>
                            </DockPanel>
                        </Border>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding PreviousStepCommand}" Style="{StaticResource LocationsToolbarButton}" Padding="14,10" Margin="0,0,8,0" MinWidth="150"
                                    IsEnabled="{Binding IsFirstStep, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ArrowLeft" Width="14" Height="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Précédent"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding NextStepCommand}" Style="{StaticResource SbmsLoginPrimaryButton}" Padding="16,10" Margin="8,0,0,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding NextButtonLabel}" FontWeight="SemiBold"/>
                                    <materialDesign:PackIcon Kind="ArrowRight" Width="15" Height="15" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="#0B63F6"/>
    </Grid>
</UserControl>

