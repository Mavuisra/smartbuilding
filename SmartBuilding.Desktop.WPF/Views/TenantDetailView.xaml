<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.TenantDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:TabIndexActiveConverter x:Key="TabIndexActiveConverter"/>
            <Style x:Key="TenantFieldLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="#94A3B8"/>
            </Style>
            <Style x:Key="TenantFieldValue" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="#1B3D3B"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Margin" Value="0,2,0,12"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête page -->
        <Border Grid.Row="0" Background="White" Padding="0" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#2D6A4F"/>
                <DockPanel Grid.Row="1" Margin="20,14">
                    <Button DockPanel.Dock="Left" Command="{Binding GoBackCommand}" Style="{StaticResource LocationsToolbarButton}"
                            Margin="0,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ArrowLeft" Margin="0,0,6,0"/>
                            <TextBlock Text="Retour aux locataires"/>
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Breadcrumb}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                        <TextBlock Text="{Binding PageTitle}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                        <TextBlock Text="{Binding SummaryLine}" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Button Command="{Binding EditCommand}" Style="{StaticResource LocationsPrimaryButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Modifier"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding DeleteCommand}" Style="{StaticResource LocationsDangerOutlineButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ArchiveOutline" Width="16" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="Archiver"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,12">
            <Grid MaxWidth="1200">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Carte profil -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <Border Background="White" CornerRadius="12" BorderBrush="#E8EFED" BorderThickness="1" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="92" Height="92" CornerRadius="46" Margin="0,0,0,12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#E8F5EE" Offset="0"/>
                                        <GradientStop Color="#D1FAE5" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="{Binding Initials}" FontSize="30" FontWeight="Bold" Foreground="#2D6A4F"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,12"/>
                            <Border Background="#DBEAFE" CornerRadius="8" Padding="10,4" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Company}" Foreground="#1D4ED8" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
                            </Border>
                            <TextBlock Text="{Binding TotalRentDisplay}" FontWeight="SemiBold" Foreground="#2D6A4F" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#64748B">
                                <Run Text="{Binding ActiveContracts}"/>
                                <Run Text=" contrat(s) actif(s)"/>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#DC2626" Margin="0,4,0,0"
                                       Visibility="{Binding HasLatePayments, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Run Text="{Binding LatePaymentsCount}"/>
                                <Run Text=" retard(s) de paiement"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1" Padding="16" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Contact rapide" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                            <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Téléphone"/>
                            <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Phone}"/>
                            <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Email"/>
                            <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Email}"/>
                            <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Adresse"/>
                            <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Address}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Contenu onglets -->
                <Border Grid.Column="1" Background="White" CornerRadius="10" BorderBrush="#E8EFED" BorderThickness="1" Padding="16">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Margin="0,0,0,12" BorderBrush="#E8EFED" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Identité" Command="{Binding SetTabCommand}" CommandParameter="0" Style="{StaticResource LocationsMainTabButton}"/>
                                <Button Content="Famille" Command="{Binding SetTabCommand}" CommandParameter="1" Style="{StaticResource LocationsMainTabButton}"/>
                                <Button Content="Contrats" Command="{Binding SetTabCommand}" CommandParameter="2" Style="{StaticResource LocationsMainTabButton}"/>
                                <Button Content="Paiements" Command="{Binding SetTabCommand}" CommandParameter="3" Style="{StaticResource LocationsMainTabButton}"/>
                                <Button Content="Garanties" Command="{Binding SetTabCommand}" CommandParameter="4" Style="{StaticResource LocationsMainTabButton}"/>
                                <Button Content="Historique" Command="{Binding SetTabCommand}" CommandParameter="5" Style="{StaticResource LocationsMainTabButton}"/>
                            </StackPanel>
                        </Border>

                        <!-- Identité -->
                        <Grid Visibility="{Binding SelectedTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Dossier locataire" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="N° dossier"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding DossierNumber}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Statut location"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding RentalStatus}"/>
                                <TextBlock Text="État civil" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,8,0,10"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Date de naissance"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding DateOfBirthDisplay}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Âge"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding AgeDisplay}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Genre"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Gender}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Pièce d'identité"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding NationalId}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Profession"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Profession}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Notes &amp; profil" FontWeight="SemiBold" Foreground="#1B3D3B" Margin="0,0,0,10"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Nationalité"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Nationality}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Activité / secteur"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding BusinessActivity}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Personnes au foyer"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding PersonCountDisplay}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Type de locataire"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Category}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Entreprise / employeur"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Company}"/>
                                <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Observations"/>
                                <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding Notes}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Famille -->
                        <StackPanel Visibility="{Binding SelectedTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                            <TextBlock Text="Situation familiale" FontWeight="SemiBold" FontSize="15" Foreground="#1B3D3B" Margin="0,0,0,12"/>
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0,0,12,0">
                                    <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Situation matrimoniale"/>
                                    <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding MaritalStatus}"/>
                                    <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Conjoint(e)"/>
                                    <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding SpouseName}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Nombre d'enfants"/>
                                    <TextBlock Text="{Binding ChildrenCount}" FontSize="28" FontWeight="Bold" Foreground="#2D6A4F" Margin="0,2,0,4"/>
                                    <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding ChildrenDisplay}"/>
                                    <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Contact d'urgence"/>
                                    <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding EmergencyContactName}"/>
                                    <TextBlock Style="{StaticResource TenantFieldLabel}" Text="Téléphone urgence"/>
                                    <TextBlock Style="{StaticResource TenantFieldValue}" Text="{Binding EmergencyContactPhone}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                        <!-- Contrats -->
                        <DataGrid ItemsSource="{Binding Contracts}" Style="{StaticResource LocationsDataGrid}"
                                  Visibility="{Binding SelectedTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}"
                                  materialDesign:DataGridAssist.CellPadding="8,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CONTRAT" Binding="{Binding ContractNumber}" Width="100"/>
                                <DataGridTextColumn Header="LOCAL" Binding="{Binding PremiseLabel}" Width="*"/>
                                <DataGridTextColumn Header="PÉRIODE" Binding="{Binding PeriodDisplay}" Width="*"/>
                                <DataGridTextColumn Header="LOYER" Binding="{Binding RentDisplay}" Width="100"/>
                                <DataGridTemplateColumn Header="STATUT" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="6,2" Background="#F1F5F9">
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusColor}" FontSize="10" FontWeight="SemiBold"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Paiements -->
                        <DataGrid ItemsSource="{Binding Payments}" Style="{StaticResource LocationsDataGrid}"
                                  Visibility="{Binding SelectedTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=3}"
                                  materialDesign:DataGridAssist.CellPadding="8,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="PÉRIODE" Binding="{Binding PeriodDisplay}" Width="90"/>
                                <DataGridTextColumn Header="LOCAL" Binding="{Binding PremiseLabel}" Width="*"/>
                                <DataGridTextColumn Header="MONTANT" Binding="{Binding AmountDisplay}" Width="*"/>
                                <DataGridTemplateColumn Header="STATUT" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusLabel}" FontWeight="SemiBold" FontSize="11"
                                                       Foreground="{Binding StatusColor}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Garanties -->
                        <DataGrid ItemsSource="{Binding Guarantees}" Style="{StaticResource LocationsDataGrid}"
                                  Visibility="{Binding SelectedTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=4}"
                                  materialDesign:DataGridAssist.CellPadding="8,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="CONTRAT" Binding="{Binding ContractNumber}" Width="*"/>
                                <DataGridTextColumn Header="MONTANT" Binding="{Binding AmountDisplay}" Width="120"/>
                                <DataGridTextColumn Header="REMBOURSÉ" Binding="{Binding RefundedDisplay}" Width="120"/>
                                <DataGridTextColumn Header="STATUT" Binding="{Binding Status}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Historique -->
                        <ItemsControl ItemsSource="{Binding Activities}"
                                      Visibility="{Binding SelectedTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=5}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#F8FAFC" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#E8EFED" BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8" Background="#E8F5EE" Margin="0,0,12,0">
                                                <materialDesign:PackIcon Kind="History" Width="18" Height="18"
                                                                         Foreground="#2D6A4F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#1B3D3B"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DateDisplay}" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Top"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                     Foreground="{StaticResource SbmsAccentGreenBrush}"/>
    </Grid>
</UserControl>
