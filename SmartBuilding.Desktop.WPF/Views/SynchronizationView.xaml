<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.SynchronizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             xmlns:models="clr-namespace:SmartBuilding.Desktop.WPF.Models"
             Background="{StaticResource SbmsPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/SynchronizationStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <conv:HexToBrushConverter x:Key="HexToBrushConverter"/>
            <conv:StringToPackIconKindConverter x:Key="StringToPackIconKindConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- En-tête page -->
        <Border Grid.Row="0" Background="White" Padding="24,16" BorderBrush="#E0E8E6" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Synchronisation" FontSize="26" FontWeight="Bold" Foreground="#1B3D3B"/>
                    <TextBlock Text="Contrôle et gestion de la synchronisation des données"
                               Foreground="{StaticResource SbmsTextMutedBrush}" FontSize="13" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Style="{StaticResource SyncHeaderBadge}" MinWidth="200">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#D1FAE5" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#2D6A4F"
                                                         Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Synchronisé" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="Toutes les données sont à jour" FontSize="11"
                                           Foreground="{StaticResource SbmsTextMutedBrush}"
                                           Visibility="{Binding IsSynchronized, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <TextBlock Text="Des éléments sont en attente" FontSize="11" Foreground="#D97706"
                                           Visibility="{Binding IsSynchronized, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SyncHeaderBadge}" MinWidth="240">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18" Background="#F1F5F9" Margin="0,0,10,0">
                                <materialDesign:PackIcon Kind="CalendarClock" Foreground="#64748B"
                                                         Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Dernière synchronisation" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding LastSyncBadgeText}" FontSize="11"
                                           Foreground="{StaticResource SbmsTextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SyncNowCommand}" Style="{StaticResource SyncPrimaryButton}" Margin="0,0,8,0"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Sync" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Synchroniser maintenant" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40" Margin="0,0,4,0">
                        <materialDesign:PackIcon Kind="CogOutline"/>
                    </Button>
                    <Button Style="{StaticResource MaterialDesignIconButton}" Width="40" Height="40">
                        <materialDesign:PackIcon Kind="BellOutline"/>
                    </Button>
                    <Border Background="#E63946" CornerRadius="9" MinWidth="18" Height="18"
                            Margin="-14,-8,12,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding NotificationCount}" Foreground="White" FontSize="10"
                                   FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource SbmsAccentGreenBrush}" Margin="0,0,10,0">
                        <TextBlock Text="{Binding UserInitials}" Foreground="White" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName}" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="{Binding UserRole}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel>
                <!-- 6 KPI -->
                <UniformGrid Columns="6" Margin="0,0,0,4">
                    <!-- Données synchronisées -->
                    <Border Style="{StaticResource SyncKpiCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Database" Foreground="#3B82F6" Width="18" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Données synchronisées" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding SyncedCountDisplay}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="{Binding SyncedTrend}" FontSize="10" Foreground="#2D6A4F" Margin="0,2,0,0"/>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="2" Series="{Binding SyncedSparkline}" Height="36" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                    <!-- Éléments en attente -->
                    <Border Style="{StaticResource SyncKpiCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#FFEDD5" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="PackageVariant" Foreground="#F59E0B" Width="18" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Éléments en attente" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding PendingCountDisplay}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="{Binding PendingTrend}" FontSize="10" Foreground="#F59E0B" Margin="0,2,0,0"/>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="2" Series="{Binding PendingSparkline}" Height="36" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                    <!-- Conflits -->
                    <Border Style="{StaticResource SyncKpiCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#EDE9FE" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Hexagon" Foreground="#8B5CF6" Width="18" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Conflits détectés" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding ConflictCountDisplay}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="{Binding ConflictTrend}" FontSize="10" Foreground="#8B5CF6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="2" Series="{Binding ConflictSparkline}" Height="36" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                    <!-- Taille données -->
                    <Border Style="{StaticResource SyncKpiCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#D1FAE5" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Harddisk" Foreground="#2D6A4F" Width="18" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Taille des données" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding DataSizeDisplay}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="Base locale SQLite" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="2" Series="{Binding SizeSparkline}" Height="36" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                    <!-- Stockage cloud -->
                    <Border Style="{StaticResource SyncKpiCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#DBEAFE" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Cloud" Foreground="#3B82F6" Width="18" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Stockage Cloud utilisé" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding CloudStoragePercent}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B" Margin="0,8,0,0"/>
                            <TextBlock Text="{Binding CloudStorageDetail}" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" Margin="0,2,0,6"/>
                            <ProgressBar Style="{StaticResource SyncProgressBar}" Value="{Binding CloudStorageProgress}" Maximum="100" Foreground="#3B82F6"/>
                        </StackPanel>
                    </Border>
                    <!-- Vitesse moyenne -->
                    <Border Style="{StaticResource SyncKpiCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="36"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="32" CornerRadius="8" Background="#CCFBF1" Margin="0,0,8,0">
                                    <materialDesign:PackIcon Kind="Speedometer" Foreground="#14B8A6" Width="18" Height="18"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Vitesse moyenne" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                <TextBlock Text="{Binding AverageSpeedDisplay}" FontSize="22" FontWeight="Bold" Foreground="#1B3D3B"/>
                                <TextBlock Text="{Binding SpeedTrend}" FontSize="10" Foreground="#14B8A6" Margin="0,2,0,0"/>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="2" Series="{Binding SpeedSparkline}" Height="36" Margin="0,4,0,0"/>
                        </Grid>
                    </Border>
                </UniformGrid>

                <!-- Ligne milieu : sources | progression | alertes -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="320"/>
                    </Grid.ColumnDefinitions>

                    <!-- État des sources -->
                    <Border Grid.Column="0" Style="{StaticResource SyncPanelCard}">
                        <StackPanel>
                            <TextBlock Text="État des sources de données" Style="{StaticResource SyncSectionTitle}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="#FAFBFC">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="Database" Foreground="#2D6A4F" Width="20" Height="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Base Locale (SQLite)" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LocalDbPath}" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,6,0,0" FontSize="11">
                                            <Run Text="Taille : "/><Run Text="{Binding LocalDbSize}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}">
                                            <Run Text="Modifié : "/><Run Text="{Binding LocalDbModified}"/>
                                        </TextBlock>
                                        <Border Style="{StaticResource SyncStatusPillOk}" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding LocalDbStatus}" Foreground="#059669" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" Width="120">
                                    <Border Width="64" Height="64" CornerRadius="32" Background="#E8F5EE" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Sync" Width="32" Height="32" Foreground="#2D6A4F"
                                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Background="#D1FAE5" CornerRadius="12" Padding="8,4" Margin="0,12,0,4" HorizontalAlignment="Center">
                                        <TextBlock Text="Mode de sync : Bidirectionnel" FontSize="10" Foreground="#059669" FontWeight="SemiBold"/>
                                    </Border>
                                    <TextBlock Text="{Binding SyncIntervalLabel, StringFormat=Intervalle automatique : {0}}"
                                               FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </StackPanel>

                                <Border Grid.Column="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Padding="12" Background="#FAFBFC">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <materialDesign:PackIcon Kind="Cloud" Foreground="#3B82F6" Width="20" Height="20" VerticalAlignment="Center"/>
                                            <TextBlock Text="Base Cloud (PostgreSQL)" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding CloudServerUrl}" FontSize="10" Foreground="{StaticResource SbmsTextMutedBrush}" TextWrapping="Wrap"/>
                                        <TextBlock Text="PostgreSQL" FontSize="11" Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding CloudDbStatus}" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                        <Border Margin="0,10,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource SyncStatusPillOk}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CloudDbOnline}" Value="False">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="OK"/>
                                                        <Setter Property="Foreground" Value="#059669"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CloudDbOnline}" Value="False">
                                                                <Setter Property="Text" Value="Hors ligne"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Progression -->
                    <Border Grid.Column="1" Style="{StaticResource SyncPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Progression de la synchronisation" Style="{StaticResource SyncSectionTitle}"/>
                            <TextBlock Text="Progression globale" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                            <Grid Margin="0,4,0,12">
                                <ProgressBar Style="{StaticResource SyncProgressBar}" Value="{Binding GlobalProgress}" Maximum="100"/>
                                <TextBlock Text="{Binding GlobalProgress, StringFormat={}{0:F0}%}" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Margin="0,0,4,0"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Durée" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DurationLabel}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Débit moyen" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ThroughputLabel}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Éléments traités" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProcessedLabel}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                            </Grid>
                            <TextBlock Text="Données transférées" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                            <TextBlock Text="{Binding TransferredLabel}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="Statut" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                            <TextBlock Text="{Binding SyncStatusText}" FontWeight="SemiBold" Foreground="#2D6A4F" Margin="0,0,0,12"/>

                            <TextBlock Text="Types de données" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding DataTypes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SyncDataTypeRow}">
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="24"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11"/>
                                            <TextBlock Grid.Column="1" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}">
                                                <Run Text="{Binding Synced}"/><Run Text="/"/><Run Text="{Binding Total}"/>
                                            </TextBlock>
                                            <materialDesign:PackIcon Grid.Column="2" Kind="CheckCircle" Foreground="#2D6A4F" Width="16" Height="16"
                                                                     Visibility="{Binding IsComplete, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Colonne droite -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SyncPanelCard}" Margin="6,6,6,4">
                            <StackPanel>
                                <TextBlock Text="Alertes &amp; notifications" Style="{StaticResource SyncSectionTitle}"/>
                                <ItemsControl ItemsSource="{Binding Alerts}" MaxHeight="200">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SyncAlertRow}">
                                            <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="16" Margin="0,0,10,0" Background="#F1F5F9">
                                                        <materialDesign:PackIcon Kind="{Binding IconKind, Converter={StaticResource StringToPackIconKindConverter}}"
                                                                                 Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                 Foreground="{Binding IconColor, Converter={StaticResource HexToBrushConverter}}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding TimeLabel}" DockPanel.Dock="Right" FontSize="10"
                                                                       Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                                        </DockPanel>
                                                        <TextBlock Text="{Binding Message}" FontSize="11"
                                                                   Foreground="{StaticResource SbmsTextMutedBrush}" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SyncPanelCard}" Margin="6,4,6,4">
                            <StackPanel>
                                <TextBlock Text="Informations système" Style="{StaticResource SyncSectionTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Mode de sync" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SyncModeLabel}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Row="1" Text="Version application" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppVersion}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Row="2" Text="Base locale" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SqliteVersion}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Row="3" Text="Base cloud" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PostgresVersion}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Row="4" Text="Connexion" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ConnectionSecurity}" FontWeight="SemiBold" FontSize="11"/>
                                    <TextBlock Grid.Row="5" Text="Environnement" FontSize="11" Foreground="{StaticResource SbmsTextMutedBrush}"/>
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding EnvironmentName}" FontWeight="SemiBold" FontSize="11"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SyncPanelCard}" Margin="6,4,6,6">
                            <StackPanel>
                                <TextBlock Text="Actions rapides" Style="{StaticResource SyncSectionTitle}"/>
                                <Button Style="{StaticResource SyncQuickActionButton}" Command="{Binding SyncNowCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Sync" Foreground="#2D6A4F" Margin="0,0,10,0"/>
                                        <TextBlock Text="Synchroniser maintenant"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SyncQuickActionButton}" Command="{Binding ForceFullSyncCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloudSync" Foreground="#3B82F6" Margin="0,0,10,0"/>
                                        <TextBlock Text="Forcer la synchronisation complète"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SyncQuickActionButton}" Command="{Binding ResetConflictsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Restore" Foreground="#8B5CF6" Margin="0,0,10,0"/>
                                        <TextBlock Text="Réinitialiser les conflits"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SyncQuickActionButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="History" Foreground="#64748B" Margin="0,0,10,0"/>
                                        <TextBlock Text="Voir l'historique complet"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource SyncQuickActionButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Cog" Foreground="#64748B" Margin="0,0,10,0"/>
                                        <TextBlock Text="Paramètres de synchronisation"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Tables en attente / conflits -->
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SyncPanelCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SyncSectionTitle}">
                                <Run Text="Éléments en attente ("/><Run Text="{Binding PendingCountDisplay}"/><Run Text=")"/>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding PendingItems}" Style="{StaticResource SyncDataGrid}" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Type" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="{Binding IconKind, Converter={StaticResource StringToPackIconKindConverter}}"
                                                                             Width="16" Height="16" Foreground="#64748B" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding TypeLabel}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Créé le" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="120"/>
                                    <DataGridTemplateColumn Header="Statut" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource SyncStatusPillWarn}">
                                                    <TextBlock Text="En attente" Foreground="#D97706" FontSize="10" FontWeight="SemiBold"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SyncPanelCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SyncSectionTitle}">
                                <Run Text="Conflits détectés ("/><Run Text="{Binding ConflictCountDisplay}"/><Run Text=")"/>
                            </TextBlock>
                            <DataGrid ItemsSource="{Binding Conflicts}" Style="{StaticResource SyncDataGrid}" MaxHeight="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Table" Binding="{Binding TableName}" Width="100"/>
                                    <DataGridTextColumn Header="Enregistrement" Binding="{Binding RecordLabel}" Width="100"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                                    <DataGridTextColumn Header="Date" Binding="{Binding ConflictAt, StringFormat=dd/MM/yyyy}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Button Content="Résoudre les conflits" Command="{Binding ResetConflictsCommand}"
                                    Style="{StaticResource SyncPrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                    Padding="16,8"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Historique + graphique 7 jours -->
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SyncPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Historique des synchronisations" Style="{StaticResource SyncSectionTitle}"/>
                            <DataGrid ItemsSource="{Binding History}" Style="{StaticResource SyncDataGrid}" MaxHeight="240">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date/Heure" Binding="{Binding StartedAt, StringFormat=dd/MM/yyyy HH:mm}" Width="130"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TypeLabel}" Width="90"/>
                                    <DataGridTemplateColumn Header="Statut" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:SyncHistoryRow}">
                                                <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#D1FAE5"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="Succès"/>
                                                                <Setter Property="Foreground" Value="#059669"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Success}" Value="False">
                                                                        <Setter Property="Text" Value="Échec"/>
                                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Éléments" Binding="{Binding ItemsCount}" Width="70"/>
                                    <DataGridTextColumn Header="Données" Binding="{Binding DataSizeLabel}" Width="80"/>
                                    <DataGridTextColumn Header="Durée" Binding="{Binding DurationLabel}" Width="70"/>
                                    <DataGridTextColumn Header="Utilisateur" Binding="{Binding UserName}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource SyncPanelCard}">
                        <StackPanel>
                            <TextBlock Text="Sync des 7 derniers jours" Style="{StaticResource SyncSectionTitle}"/>
                            <lvc:CartesianChart Series="{Binding WeeklySyncSeries}" Height="220"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
