<UserControl x:Class="SmartBuilding.Desktop.WPF.Views.LocationsPatrimoineView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SmartBuilding.Desktop.WPF.Converters"
             xmlns:views="clr-namespace:SmartBuilding.Desktop.WPF.Views"
             Background="#F5F7FB">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
                <ResourceDictionary Source="/Themes/SettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <conv:IntEqualsToVisibilityConverter x:Key="IntEqualsToVisibilityConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <Border Grid.Row="0" Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1"
                Padding="22,18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="14" Background="{StaticResource PatrimoineGelLightBrush}" Margin="0,0,16,0">
                        <materialDesign:PackIcon Kind="OfficeBuildingMarker" Width="28" Height="28" Foreground="{StaticResource PatrimoineGelBrush}"
                                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Patrimoine — Bloom Prosperity" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PatrimoineGelTextBrush}"/>
                        <TextBlock Text="Un seul immeuble : étages et locaux à louer (synchronisés avec les contrats)"
                                   FontSize="12" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"/>
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource PatrimoineGelLightBrush}" BorderBrush="#D4EDDC" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StructureSummaryLine}" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource PatrimoineGelTextBrush}" TextWrapping="Wrap" MaxWidth="220"/>
                </Border>
            </Grid>
        </Border>

        <!-- Sous-onglets : Bailleur | Bâtiment | Gestion -->
        <Border Grid.Row="1" Style="{StaticResource SettingsSubTabBar}" Margin="0,0,0,16">
            <UniformGrid Columns="3">
                <Button Command="{Binding SelectPatrimoineTabCommand}" CommandParameter="0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSubTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPatrimoineTab}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource PatrimoineGelBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountTie" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Bailleur"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SelectPatrimoineTabCommand}" CommandParameter="1">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSubTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPatrimoineTab}" Value="1">
                                    <Setter Property="Background" Value="{StaticResource PatrimoineGelBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="OfficeBuilding" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Bloom Prosperity"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SelectPatrimoineTabCommand}" CommandParameter="2">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SettingsSubTabButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPatrimoineTab}" Value="2">
                                    <Setter Property="Background" Value="{StaticResource PatrimoineGelBrush}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ViewDashboard" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Gestion"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Border>

        <Border Grid.Row="2" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="10"
                Padding="14,10" Margin="0,0,0,12"
                Visibility="{Binding FormError, Converter={StaticResource NullToVisibilityConverter}}">
            <TextBlock Text="{Binding FormError}" Foreground="#DC2626" TextWrapping="Wrap"/>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <!-- Locateur -->
            <Border Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1" Padding="24,22"
                    Visibility="{Binding SelectedPatrimoineTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=0}">
                <StackPanel>
                    <TextBlock Text="Bailleur / propriétaire" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PatrimoineGelTextBrush}" Margin="0,0,0,6"/>
                    <TextBlock Text="Coordonnées du propriétaire affichées sur les quittances PDF." FontSize="12"
                               Foreground="#64748B" Margin="0,0,0,20" TextWrapping="Wrap"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="Raison sociale" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,16">
                            <TextBlock Text="Type de bailleur" Style="{StaticResource SettingsFieldLabel}"/>
                            <ComboBox ItemsSource="{Binding OwnerTypeChoices}" SelectedItem="{Binding OwnerType}"
                                      Style="{StaticResource MaterialDesignOutlinedComboBox}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="Représentant légal" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding LegalRepresentative, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,16">
                            <TextBlock Text="ID National" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding BuildingNationalId, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="Adresse" Style="{StaticResource SettingsFieldLabel}"/>
                    <TextBox Text="{Binding BuildingAddress, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,16"/>
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Ville" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding BuildingCity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Pays" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding BuildingCountry, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,16,0,16">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Téléphone" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding BuildingPhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Email" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding BuildingEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </UniformGrid>
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Banque" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Compte bancaire" Style="{StaticResource SettingsFieldLabel}"/>
                            <TextBox Text="{Binding BankAccount, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Bloom Prosperity : étages / locaux -->
            <Border Background="White" CornerRadius="14" BorderBrush="#E5EAF2" BorderThickness="1" Padding="24,22"
                    Visibility="{Binding SelectedPatrimoineTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=1}">
                <StackPanel>
                    <Border Background="{StaticResource PatrimoineGelSoftBrush}" CornerRadius="12" Padding="18,16" Margin="0,0,0,20"
                            BorderBrush="#D4EDDC" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource PatrimoineGelLightBrush}" Margin="0,0,14,0">
                                <materialDesign:PackIcon Kind="OfficeBuilding" Width="28" Height="28" Foreground="{StaticResource PatrimoineGelBrush}"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SingleBuildingDisplayName}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource PatrimoineGelTextBrush}"/>
                                <TextBlock Text="{Binding StructureSummaryLine}" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                                <TextBlock Text="Ajoutez des étages, puis des locaux dans chaque étage."
                                           FontSize="12" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <views:SettingsBuildingsApartmentsPanel DataContext="{Binding}"/>
                </StackPanel>
            </Border>

            <!-- Gestion -->
            <Border Visibility="{Binding SelectedPatrimoineTab, Converter={StaticResource IntEqualsToVisibilityConverter}, ConverterParameter=2}">
                <views:LocationsPatrimoineGestionPanel DataContext="{Binding}"/>
            </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="4" Background="White" CornerRadius="12" BorderBrush="#E5EAF2" BorderThickness="1"
                Padding="16,14" Margin="0,14,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Left" Command="{Binding ReturnToContractCommand}" Style="{StaticResource LocationsToolbarButton}"
                        Padding="16,10" Margin="0,0,12,0"
                        Visibility="{Binding CanReturnToContract, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Retour au contrat" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource PatrimoineGelTextBrush}" FontWeight="SemiBold" VerticalAlignment="Center"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}"/>
                <Button DockPanel.Dock="Right" Command="{Binding SaveCommand}" Style="{StaticResource LocationsPrimaryButton}"
                        Padding="24,12" IsEnabled="{Binding CanManage}"
                        Visibility="{Binding CanManage, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="Enregistrer le patrimoine" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{StaticResource PatrimoineGelBrush}"/>
    </Grid>
</UserControl>
