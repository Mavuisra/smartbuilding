<Application x:Class="SmartBuilding.Desktop.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:helpers="clr-namespace:SmartBuilding.Desktop.WPF.Helpers">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Green" SecondaryColor="Teal"/>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
                <ResourceDictionary Source="Themes/SbmsTheme.xaml"/>
                <ResourceDictionary Source="DataTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Tous les DataGrid sans style explicite héritent du scroll horizontal responsive -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource SbmsDataGrid}">
                <Setter Property="helpers:DataGridScrollHelper.IsEnabled" Value="True"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
