<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SyncKpiCard" TargetType="Border" BasedOn="{StaticResource SbmsKpiCard}">
        <Setter Property="MinHeight" Value="118"/>
    </Style>

    <Style x:Key="SyncPanelCard" TargetType="Border" BasedOn="{StaticResource SbmsPanelCard}"/>

    <Style x:Key="SyncSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#1B3D3B"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SyncPrimaryButton" TargetType="Button" BasedOn="{StaticResource SbmsButtonPrimary}">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="20,10"/>
    </Style>

    <Style x:Key="SyncHeaderBadge" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="SyncStatusPillOk" TargetType="Border">
        <Setter Property="Background" Value="#D1FAE5"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SyncStatusPillWarn" TargetType="Border">
        <Setter Property="Background" Value="#FEF3C7"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SyncProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Foreground" Value="#2D6A4F"/>
        <Setter Property="Background" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="SyncDataGrid" TargetType="DataGrid" BasedOn="{StaticResource SbmsDataGrid}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="AlternatingRowBackground" Value="#FAFBFC"/>
        <Setter Property="IsReadOnly" Value="True"/>
    </Style>

    <Style x:Key="SyncQuickActionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="8,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F0F4F3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
