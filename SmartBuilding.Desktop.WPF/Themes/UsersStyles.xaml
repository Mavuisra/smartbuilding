<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/VisitsStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="UsersKpiCard" TargetType="Border" BasedOn="{StaticResource VisitsKpiCard}"/>
    <Style x:Key="UsersToolbarButton" TargetType="Button" BasedOn="{StaticResource VisitsToolbarButton}"/>
    <Style x:Key="UsersPrimaryButton" TargetType="Button" BasedOn="{StaticResource VisitsPrimaryButton}">
        <Setter Property="Background" Value="#2563EB"/>
    </Style>
    <Style x:Key="UsersFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource VisitsFilterCombo}"/>
    <Style x:Key="UsersAnalyticsCard" TargetType="Border" BasedOn="{StaticResource VisitsAnalyticsCard}"/>
    <Style x:Key="UsersDetailCard" TargetType="Border" BasedOn="{StaticResource VisitsSidebarCard}"/>

    <Style x:Key="UsersTabButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="FontSize" Value="12"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Foreground" Value="#2563EB"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
