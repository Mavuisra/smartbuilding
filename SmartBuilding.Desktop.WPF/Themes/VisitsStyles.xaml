<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:helpers="clr-namespace:SmartBuilding.Desktop.WPF.Helpers">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/IncidentsStyles.xaml"/>
        <ResourceDictionary Source="/Themes/SbmsTheme.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="VisitsKpiCard" TargetType="Border" BasedOn="{StaticResource IncidentsKpiCard}"/>
    <Style x:Key="VisitsToolbarButton" TargetType="Button" BasedOn="{StaticResource IncidentsToolbarButton}"/>
    <Style x:Key="VisitsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SbmsButtonPrimary}"/>
    <Style x:Key="VisitsFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource IncidentsFilterCombo}"/>
    <Style x:Key="VisitsFilterSearch" TargetType="TextBox" BasedOn="{StaticResource IncidentsFilterSearch}"/>
    <Style x:Key="VisitsDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F0F7F4"/>
        <Setter Property="Foreground" Value="#1B3D3B"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="BorderBrush" Value="#E8EFED"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <Style x:Key="VisitsDataGridCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VisitsDataGridRow" TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E8EFED"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F0FDF4"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DCFCE7"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="True"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#BBF7D0"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="VisitsDataGrid" TargetType="DataGrid" BasedOn="{StaticResource SbmsDataGrid}">
        <Setter Property="helpers:DataGridScrollHelper.IsEnabled" Value="True"/>
        <Setter Property="RowHeight" Value="56"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E8EFED"/>
        <Setter Property="SelectionUnit" Value="FullRow"/>
        <Setter Property="CanUserSortColumns" Value="True"/>
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource VisitsDataGridColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource VisitsDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource VisitsDataGridRow}"/>
    </Style>
    <Style x:Key="VisitsAnalyticsCard" TargetType="Border" BasedOn="{StaticResource IncidentsAnalyticsCard}"/>
    <Style x:Key="VisitsSidebarCard" TargetType="Border" BasedOn="{StaticResource IncidentsSidebarCard}"/>
    <Style x:Key="VisitsSubTableCard" TargetType="Border" BasedOn="{StaticResource IncidentsSubTableCard}"/>
    <Style x:Key="VisitsCellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="VisitsBadgeText" TargetType="TextBlock" BasedOn="{StaticResource VisitsCellText}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace"/>
        <Setter Property="Foreground" Value="#0F172A"/>
    </Style>

    <Style x:Key="VisitsIconActionButton" TargetType="Button">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#CBD5E1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="#2D6A4F"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#F0FDF4"/>
                            <Setter TargetName="Root" Property="BorderBrush" Value="#2D6A4F"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#DCFCE7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
