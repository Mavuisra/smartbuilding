<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="FinancesKpiCard" TargetType="Border" BasedOn="{StaticResource LocationsKpiCard}">
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="3,2"/>
    </Style>

    <Style x:Key="FinancesKpiIconBox" TargetType="Border" BasedOn="{StaticResource LocationsKpiIconBox}">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <Style x:Key="FinancesToolbarButton" TargetType="Button" BasedOn="{StaticResource LocationsToolbarButton}"/>
    <Style x:Key="FinancesPrimaryButton" TargetType="Button" BasedOn="{StaticResource LocationsPrimaryButton}"/>
    <Style x:Key="FinancesRevenueButton" TargetType="Button" BasedOn="{StaticResource LocationsPrimaryButton}">
        <Setter Property="Background" Value="#2D6A4F"/>
    </Style>
    <Style x:Key="FinancesExpenseButton" TargetType="Button" BasedOn="{StaticResource LocationsToolbarButton}">
        <Setter Property="Background" Value="#FEE2E2"/>
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
    </Style>
    <Style x:Key="FinancesRentButton" TargetType="Button" BasedOn="{StaticResource LocationsToolbarButton}">
        <Setter Property="Background" Value="#DBEAFE"/>
        <Setter Property="Foreground" Value="#1D4ED8"/>
        <Setter Property="BorderBrush" Value="#BFDBFE"/>
    </Style>
    <Style x:Key="FinancesFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource LocationsFilterCombo}"/>
    <Style x:Key="FinancesFilterSearch" TargetType="TextBox" BasedOn="{StaticResource LocationsFilterSearch}"/>
    <Style x:Key="FinancesMainTabButton" TargetType="Button" BasedOn="{StaticResource LocationsMainTabButton}"/>
    <Style x:Key="FinancesDataGrid" TargetType="DataGrid" BasedOn="{StaticResource LocationsDataGrid}"/>
    <Style x:Key="FinancesAnalyticsCard" TargetType="Border" BasedOn="{StaticResource LocationsAnalyticsCard}"/>
    <Style x:Key="FinancesSidebarCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="BorderBrush" Value="#E8EFED"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="FinancesCellText" TargetType="TextBlock" BasedOn="{StaticResource LocationsCellText}"/>
</ResourceDictionary>
