<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/VisitsStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="EmailsKpiCard" TargetType="Border" BasedOn="{StaticResource VisitsKpiCard}"/>
    <Style x:Key="EmailsToolbarButton" TargetType="Button" BasedOn="{StaticResource VisitsToolbarButton}"/>
    <Style x:Key="EmailsPrimaryButton" TargetType="Button" BasedOn="{StaticResource VisitsPrimaryButton}">
        <Setter Property="Background" Value="#2563EB"/>
    </Style>
    <Style x:Key="EmailsFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource VisitsFilterCombo}"/>
    <Style x:Key="EmailsSidebarCard" TargetType="Border" BasedOn="{StaticResource VisitsSidebarCard}"/>
    <Style x:Key="EmailsAnalyticsCard" TargetType="Border" BasedOn="{StaticResource VisitsAnalyticsCard}"/>

    <Style x:Key="EmailsFolderButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="#DBEAFE"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="EmailsListItemBorder" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E8EFED"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsRead}" Value="False">
                <Setter Property="Background" Value="#F8FAFF"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
