<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/FinancesStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ConsumptionsKpiCard" TargetType="Border" BasedOn="{StaticResource FinancesKpiCard}"/>
    <Style x:Key="ConsumptionsToolbarButton" TargetType="Button" BasedOn="{StaticResource FinancesToolbarButton}"/>
    <Style x:Key="ConsumptionsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SbmsButtonPrimary}"/>
    <Style x:Key="ConsumptionsFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource FinancesFilterCombo}"/>
    <Style x:Key="ConsumptionsFilterSearch" TargetType="TextBox" BasedOn="{StaticResource FinancesFilterSearch}"/>
    <Style x:Key="ConsumptionsAnalyticsCard" TargetType="Border" BasedOn="{StaticResource FinancesAnalyticsCard}"/>
    <Style x:Key="ConsumptionsSidebarCard" TargetType="Border" BasedOn="{StaticResource FinancesSidebarCard}"/>

    <Style x:Key="ConsumptionsCellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#1E293B"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Margin" Value="2,4"/>
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
    </Style>

    <Style x:Key="ConsumptionsDataGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource LocationsDataGridColumnHeader}">
        <Setter Property="Background" Value="#EFF6FF"/>
        <Setter Property="Foreground" Value="#1E3A5F"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="12,14"/>
        <Setter Property="MinHeight" Value="50"/>
        <Setter Property="BorderBrush" Value="#BFDBFE"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>

    <Style x:Key="ConsumptionsDataGridCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="12,12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#111827"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConsumptionsDataGridRow" TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EFF6FF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#DBEAFE"/>
                <Setter Property="Foreground" Value="#1E3A8A"/>
            </Trigger>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#F8FAFC"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="AlternationIndex" Value="1"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="#E0F2FE"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ConsumptionsDataGrid" TargetType="DataGrid" BasedOn="{StaticResource FinancesDataGrid}">
        <Setter Property="RowHeight" Value="56"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="ColumnHeaderHeight" Value="50"/>
        <Setter Property="MinHeight" Value="320"/>
        <Setter Property="CanUserResizeColumns" Value="True"/>
        <Setter Property="CanUserReorderColumns" Value="True"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E2E8F0"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource ConsumptionsDataGridColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource ConsumptionsDataGridCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource ConsumptionsDataGridRow}"/>
        <Setter Property="BorderBrush" Value="#BFDBFE"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>
</ResourceDictionary>
