<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/ConsumptionsStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>
    <Style x:Key="IncidentsKpiCard" TargetType="Border" BasedOn="{StaticResource ConsumptionsKpiCard}"/>
    <Style x:Key="IncidentsToolbarButton" TargetType="Button" BasedOn="{StaticResource ConsumptionsToolbarButton}"/>
    <Style x:Key="IncidentsPrimaryButton" TargetType="Button" BasedOn="{StaticResource SbmsButtonDanger}"/>
    <Style x:Key="IncidentsFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource ConsumptionsFilterCombo}"/>
    <Style x:Key="IncidentsFilterSearch" TargetType="TextBox" BasedOn="{StaticResource ConsumptionsFilterSearch}"/>
    <Style x:Key="IncidentsDataGrid" TargetType="DataGrid" BasedOn="{StaticResource ConsumptionsDataGrid}"/>
    <Style x:Key="IncidentsAnalyticsCard" TargetType="Border" BasedOn="{StaticResource ConsumptionsAnalyticsCard}"/>
    <Style x:Key="IncidentsSidebarCard" TargetType="Border" BasedOn="{StaticResource ConsumptionsSidebarCard}"/>
    <Style x:Key="IncidentsSubTableCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="BorderBrush" Value="#E8EFED"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>
</ResourceDictionary>
