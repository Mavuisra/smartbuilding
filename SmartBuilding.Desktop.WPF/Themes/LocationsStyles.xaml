<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/PersonnelStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- KPI compacts -->
    <Style x:Key="LocationsKpiCard" TargetType="Border" BasedOn="{StaticResource PersonnelKpiCard}">
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="CornerRadius" Value="8"/>
    </Style>

    <Style x:Key="LocationsKpiIconBox" TargetType="Border" BasedOn="{StaticResource PersonnelIconBox}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <Style x:Key="LocationsToolbarButton" TargetType="Button" BasedOn="{StaticResource PersonnelToolbarButton}">
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E8F5EE"/>
                <Setter Property="BorderBrush" Value="#9AD7B4"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#D3EEDD"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.6"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LocationsPrimaryButton" TargetType="Button" BasedOn="{StaticResource PersonnelPrimaryButton}">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.92"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Opacity" Value="0.82"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.55"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LocationsFilterCombo" TargetType="ComboBox" BasedOn="{StaticResource PersonnelFilterCombo}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="108"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="LocationsFilterSearch" TargetType="TextBox" BasedOn="{StaticResource PersonnelFilterSearch}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>

    <Style x:Key="LocationsFilterActionButton" TargetType="Button" BasedOn="{StaticResource PersonnelFilterActionButton}">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="LocationsMainTabButton" TargetType="Button" BasedOn="{StaticResource PersonnelDetailTabButton}">
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Margin" Value="2,0"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="#F8FAFC"/>
    </Style>

    <Style x:Key="LocationsAnalyticsCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="BorderBrush" Value="#E8EFED"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="LocationsCellText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=Text}"/>
    </Style>

    <!-- Déclaré AVANT LocationsDataGrid (StaticResource ne supporte pas la référence forward) -->
    <Style x:Key="LocationsDataGridColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="BorderBrush" Value="#E8EFED"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LocationsDataGridFillerCell" TargetType="DataGridCell">
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style x:Key="LocationsDataGrid" TargetType="DataGrid" BasedOn="{StaticResource PersonnelDataGrid}">
        <Setter Property="RowHeight" Value="{DynamicResource SbmsDataGridRowHeight}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="ColumnHeaderHeight" Value="40"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="MinWidth" Value="1200"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource LocationsDataGridColumnHeader}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="LocationsIconActionButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTipService.ShowDuration" Value="4000"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#E8F5EE"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="#D3EEDD"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LocationsStatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Tableau Gestion patrimoine — palette gel #4cc26b -->
    <Color x:Key="PatrimoineGelColor">#4cc26b</Color>
    <SolidColorBrush x:Key="PatrimoineGelBrush" Color="{StaticResource PatrimoineGelColor}"/>
    <SolidColorBrush x:Key="PatrimoineGelLightBrush" Color="#E8F9EF"/>
    <SolidColorBrush x:Key="PatrimoineGelSoftBrush" Color="#F4FCF7"/>
    <SolidColorBrush x:Key="PatrimoineGelHoverBrush" Color="#EDFAF2"/>
    <SolidColorBrush x:Key="PatrimoineGelSelectedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PatrimoineGelSelectedAccentBrush" Color="#4cc26b"/>
    <SolidColorBrush x:Key="PatrimoineGelTextBrush" Color="#1B4332"/>
    <SolidColorBrush x:Key="PatrimoineGelMutedBrush" Color="#475569"/>
    <SolidColorBrush x:Key="PatrimoineGelRowTextBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="PatrimoineGelDangerBrush" Color="#DC2626"/>
    <SolidColorBrush x:Key="PatrimoineGelDangerBgBrush" Color="#FEF2F2"/>
    <SolidColorBrush x:Key="PatrimoineGelDangerBorderBrush" Color="#F87171"/>

    <Style x:Key="PatrimoineGestionColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PatrimoineGelLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PatrimoineGelTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="BorderBrush" Value="#D4EDDC"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PatrimoineGestionCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{StaticResource PatrimoineGelRowTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            TextElement.Foreground="{StaticResource PatrimoineGelRowTextBrush}">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource PatrimoineGelRowTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PatrimoineGestionRow" TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="60"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource PatrimoineGelRowTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#FAFCFB"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource PatrimoineGelHoverBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
            </MultiTrigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PatrimoineGelSelectedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource PatrimoineGelSelectedAccentBrush}"/>
                <Setter Property="BorderThickness" Value="4,0,0,1"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource PatrimoineGelRowTextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PatrimoineGestionDataGrid" TargetType="DataGrid" BasedOn="{StaticResource LocationsDataGrid}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="RowHeight" Value="60"/>
        <Setter Property="ColumnHeaderHeight" Value="46"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="RowStyle" Value="{StaticResource PatrimoineGestionRow}"/>
        <Setter Property="CellStyle" Value="{StaticResource PatrimoineGestionCell}"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource PatrimoineGestionColumnHeader}"/>
        <Setter Property="RowBackground" Value="White"/>
        <Setter Property="AlternatingRowBackground" Value="#FAFCFB"/>
    </Style>

    <Style x:Key="PatrimoineTypeChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="{StaticResource PatrimoineGelLightBrush}"/>
    </Style>

    <Style x:Key="PatrimoineActionPill" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PatrimoineGelSoftBrush}"/>
        <Setter Property="BorderBrush" Value="#D4EDDC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="PatrimoineGelPrimaryButton" TargetType="Button" BasedOn="{StaticResource LocationsPrimaryButton}">
        <Setter Property="Background" Value="{StaticResource PatrimoineGelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PatrimoineGelBrush}"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="PatrimoineGelDangerButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PatrimoineGelDangerBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource PatrimoineGelDangerBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Foreground" Value="{StaticResource PatrimoineGelDangerBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="#EF4444"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#FECACA"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Libellés et cartes partagés (LocationsView, LocationRentFormView, etc.) -->
    <Style x:Key="LocationPageCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E5EAF2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="LocationFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#536173"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="LocationSummaryLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#7A8699"/>
    </Style>

    <Style x:Key="LocationSummaryValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#172033"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Formulaire horizontal noir & blanc (création rapide, modales Local) -->
    <Style x:Key="LocationsBwFormCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#111827"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LocationsBwFormHeader" TargetType="Border">
        <Setter Property="Background" Value="#111827"/>
        <Setter Property="CornerRadius" Value="10,10,0,0"/>
        <Setter Property="Padding" Value="16,12"/>
    </Style>

    <Style x:Key="LocationsBwFormSection" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D1D5DB"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="14,12"/>
    </Style>

    <Style x:Key="LocationsBwFormSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#111827"/>
    </Style>

    <Style x:Key="LocationsBwFormSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#6B7280"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="LocationsTenantKpiCard" TargetType="Border" BasedOn="{StaticResource LocationsKpiCard}">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.06" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LocationsFormFooterBar" TargetType="Border">
        <Setter Property="Background" Value="#F8FAFC"/>
        <Setter Property="BorderBrush" Value="#E5E7EB"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="16,12"/>
        <Setter Property="CornerRadius" Value="0,0,10,10"/>
    </Style>

    <Style x:Key="LocationsDangerOutlineButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Foreground" Value="#DC2626"/>
        <Setter Property="BorderBrush" Value="#FECACA"/>
        <Setter Property="Background" Value="#FEF2F2"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#FEE2E2"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LocationsBwFormResetButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="#9CA3AF"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>

</ResourceDictionary>
