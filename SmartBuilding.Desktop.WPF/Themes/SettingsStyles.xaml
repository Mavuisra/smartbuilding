<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Themes/LocationsStyles.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="SettingsKpiCard" TargetType="Border" BasedOn="{StaticResource SbmsKpiCard}">
        <Setter Property="MinHeight" Value="110"/>
    </Style>

    <Style x:Key="SettingsPanelCard" TargetType="Border" BasedOn="{StaticResource SbmsPanelCard}"/>

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SbmsSettingsTitleBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SettingsCategoryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F0F4F3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSaveButton" TargetType="Button" BasedOn="{StaticResource SbmsButtonPrimary}">
        <Setter Property="Padding" Value="24,10"/>
    </Style>

    <Style x:Key="SettingsQuickCard" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource SbmsTextMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SettingsHeroBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="22,20"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
        <Setter Property="Background" Value="{DynamicResource SbmsSettingsHeroGradient}"/>
    </Style>

    <Style x:Key="SettingsLocationBadge" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF22"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SettingsPreviewCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SbmsSettingsPreviewBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SbmsSettingsPreviewBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="SettingsOutlineAccentButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource SbmsAccentGreenBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SbmsAccentGreenBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="SettingsSubTabBar" TargetType="Border">
        <Setter Property="Background" Value="#F1F5F9"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="0,0,0,22"/>
    </Style>

    <Style x:Key="SettingsSubTabButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#64748B"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="18,12"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PropertyStructPrimaryButton" TargetType="Button" BasedOn="{StaticResource PatrimoineGelPrimaryButton}">
        <Setter Property="Padding" Value="18,11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="PropertyStructSecondaryButton" TargetType="Button" BasedOn="{StaticResource PatrimoineGelPrimaryButton}">
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="PropertyStructDangerButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="BorderBrush" Value="#E8D4D4"/>
        <Setter Property="Foreground" Value="#A67B7B"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Background" Value="#FAF5F5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="PropertyStructKpiChip" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D4EDDC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="MinWidth" Value="120"/>
    </Style>

    <Style x:Key="PropertyStructFloorCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D4EDDC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="20,18"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
    </Style>

    <Style x:Key="PropertyStructUnitCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PatrimoineGelSoftBrush}"/>
        <Setter Property="BorderBrush" Value="#D4EDDC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="18,16"/>
        <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>

    <Style x:Key="PropertyStructRoomCellTextBox" TargetType="TextBox">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#B8DFC8"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PatrimoineGelBrush}"/>
                <Setter Property="Background" Value="#FAFFFC"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource PatrimoineGelBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyStructRoomCellComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#B8DFC8"/>
        <Setter Property="BorderThickness" Value="1.5"/>
    </Style>

    <Style x:Key="PropertyStructRoomDeleteButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="#FAF0F0"/>
        <Setter Property="BorderBrush" Value="#E8D4D4"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTip" Value="Supprimer cette pièce"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#F5E0E0"/>
                <Setter Property="BorderBrush" Value="#D4A8A8"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyStructRoomsColumnHeader" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{StaticResource PatrimoineGelLightBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource PatrimoineGelTextBrush}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="BorderThickness" Value="0,0,1,2"/>
        <Setter Property="BorderBrush" Value="#D4EDDC"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PropertyStructRoomsCell" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource PatrimoineGelHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyStructRoomsRow" TargetType="DataGridRow">
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="#EEF5F1"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#FAFCFB"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsSelected" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource PatrimoineGelHoverBrush}"/>
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PropertyStructRoomsGrid" TargetType="DataGrid" BasedOn="{StaticResource LocationsDataGrid}">
        <Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="MinHeight" Value="120"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#E8F0EC"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#D4EDDC"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowHeight" Value="54"/>
        <Setter Property="ColumnHeaderHeight" Value="44"/>
        <Setter Property="AlternationCount" Value="2"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource PropertyStructRoomsColumnHeader}"/>
        <Setter Property="CellStyle" Value="{StaticResource PropertyStructRoomsCell}"/>
        <Setter Property="RowStyle" Value="{StaticResource PropertyStructRoomsRow}"/>
    </Style>

</ResourceDictionary>
