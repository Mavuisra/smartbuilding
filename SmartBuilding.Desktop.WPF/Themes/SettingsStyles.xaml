<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="SettingsKpiCard" TargetType="Border" BasedOn="{StaticResource SbmsKpiCard}">
        <Setter Property="MinHeight" Value="110"/>
    </Style>

    <Style x:Key="SettingsPanelCard" TargetType="Border" BasedOn="{StaticResource SbmsPanelCard}"/>

    <Style x:Key="SettingsSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource SbmsSettingsTitleBrush}"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="SettingsCategoryButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F0F4F3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsSaveButton" TargetType="Button" BasedOn="{StaticResource SbmsButtonPrimary}">
        <Setter Property="Padding" Value="24,10"/>
    </Style>

    <Style x:Key="SettingsQuickCard" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10" Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#F8FAFC"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource SbmsTextMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="SettingsHeroBanner" TargetType="Border">
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="22,20"/>
        <Setter Property="Margin" Value="0,0,0,18"/>
        <Setter Property="Background" Value="{DynamicResource SbmsSettingsHeroGradient}"/>
    </Style>

    <Style x:Key="SettingsLocationBadge" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF22"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="SettingsPreviewCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SbmsSettingsPreviewBgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SbmsSettingsPreviewBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="SettingsOutlineAccentButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource SbmsAccentGreenBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource SbmsAccentGreenBrush}"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

</ResourceDictionary>
