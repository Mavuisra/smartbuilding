<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="LoginEmeraldBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="LoginEmeraldHoverBrush" Color="#059669"/>
    <SolidColorBrush x:Key="LoginAmberAccentBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="LoginEmeraldLightBrush" Color="#D1FAE5"/>
    <SolidColorBrush x:Key="LoginFormBgBrush" Color="#FAFBFC"/>
  <!-- Carte verre vert léger (comme le splash SBMS) -->
    <SolidColorBrush x:Key="LoginGlassCardBrush" Color="#66B8E6CF"/>
    <SolidColorBrush x:Key="LoginGlassCardBorderBrush" Color="#99FFFFFF"/>
    <SolidColorBrush x:Key="LoginGlassInputBgBrush" Color="#F8FFFB"/>
    <SolidColorBrush x:Key="LoginInputBorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="LoginInputFocusBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="LoginTextDarkBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="LoginTextMutedBrush" Color="#64748B"/>

    <Style x:Key="LoginGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LoginGlassCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LoginGlassCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="22,16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.12" Color="#0F172A"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoginInputBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource LoginGlassInputBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LoginInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="4,2"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
        <Setter Property="MinHeight" Value="46"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource LoginInputFocusBrush}"/>
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.15" Color="#10B981"/>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="LoginInnerTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource LoginTextDarkBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,12"/>
    </Style>

    <Style x:Key="LoginInnerPasswordBox" TargetType="PasswordBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource LoginTextDarkBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="10,12,4,12"/>
    </Style>

    <Style x:Key="LoginPasswordToggleButton" TargetType="Button">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ToggleBg" Background="Transparent" CornerRadius="8" Padding="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ToggleBg" Property="Background" Value="#F1F5F9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ToggleBg" Property="Background" Value="#E2E8F0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoginPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource LoginEmeraldBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,15"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="12" Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#10B981" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#10B981"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="22" ShadowDepth="3" Opacity="0.5" Color="#F59E0B"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoginSecondaryButton" TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{StaticResource LoginTextDarkBrush}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="20,13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="BorderBrush" Value="{StaticResource LoginInputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoginFeatureIconCircle" TargetType="Border">
        <Setter Property="Width" Value="42"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="CornerRadius" Value="21"/>
        <Setter Property="Background" Value="#40FFFFFF"/>
        <Setter Property="Margin" Value="0,0,12,0"/>
    </Style>

    <Style x:Key="LoginRememberCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource LoginTextMutedBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style x:Key="LoginBusyOverlay" TargetType="Border">
        <Setter Property="Background" Value="#B3D1FAE5"/>
        <Setter Property="CornerRadius" Value="12"/>
    </Style>

    <Style x:Key="LoginErrorDialogCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="28,24"/>
        <Setter Property="MaxWidth" Value="420"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.22" Color="#0F172A"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="LoginDialogOkButton" TargetType="Button" BasedOn="{StaticResource LoginPrimaryButton}">
        <Setter Property="MinHeight" Value="46"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="Margin" Value="0,20,0,0"/>
    </Style>

    <Style x:Key="LoginBusyProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="IsIndeterminate" Value="True"/>
        <Setter Property="Foreground" Value="{StaticResource LoginEmeraldBrush}"/>
        <Setter Property="Background" Value="#E2E8F0"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

</ResourceDictionary>
