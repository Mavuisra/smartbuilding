DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
# En local : localhost. Sur Render : ton-host.onrender.com (ou laisse vide, .onrender.com est auto-autorisé)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,smartbuilding-0kbk.onrender.com

# Développement local : SQLite
DATABASE_URL=sqlite:///db.sqlite3
# Production (Render, etc.) : PostgreSQL persistant obligatoire — jamais SQLite dans le conteneur
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartbuilding

# Production Render (auto si blueprint render.yaml)
# RENDER=true
# SBMS_PRODUCTION=true
# SBMS_RUN_SEED=true   # uniquement au tout premier déploiement, puis false

CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

JWT_SIGNING_KEY=SmartBuilding_SuperSecret_Key_Min32Chars_2026!
