{% include 'partials/sbms_common_script.twig' %}
{% include 'partials/mobile_shell.twig' %}
<script>
(async function () {
  if (!Sbms.getToken()) {
    const ok = await Sbms.ensureAuth();
    if (!ok) return;
  }

  const activeSlug = '{{ module_slug|default:"dashboard" }}'.trim() || 'dashboard';

  function renderNav(items) {
    const nav = document.getElementById('sidebar-nav');
    if (!nav) return;
    let html = '';
    for (const item of items) {
      if (item.type === 'header') {
        html += `<div class="sb-nav-group-title">${item.label}</div>`;
        continue;
      }
      const isParentActive = item.slug === activeSlug
        || (item.children || []).some(c => c.slug === activeSlug);
      const parentCls = isParentActive ? 'sb-nav-link active' : 'sb-nav-link';
      const href = `/${item.slug}/`;
      html += `<a href="${href}" class="${parentCls}">${item.label}</a>`;
      if (item.children && item.children.length) {
        html += '<div class="sb-nav-children">';
        for (const child of item.children) {
          const childCls = child.slug === activeSlug ? 'sb-nav-child active' : 'sb-nav-child';
          html += `<a href="/${child.slug}/" class="${childCls}">${child.label}</a>`;
        }
        html += '</div>';
      }
    }
    nav.innerHTML = html || '<div class="text-muted small px-2 py-2">Aucun module accessible pour votre rôle.</div>';
  }

  async function loadNav() {
    try {
      const items = await Sbms.apiFetch('/api/executive/navigation/');
      renderNav(items);
    } catch (e) {
      console.error('Navigation:', e);
      const nav = document.getElementById('sidebar-nav');
      if (nav) {
        nav.innerHTML = '<div class="text-danger small px-2">Menu indisponible. Reconnectez-vous.</div>';
      }
    }
  }

  window.sbmsLoadNavigation = loadNav;
  loadNav();
})();
</script>

