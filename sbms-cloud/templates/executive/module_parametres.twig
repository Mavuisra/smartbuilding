{% extends 'base.twig' %}
{% block title %}Paramètres — SBMS{% endblock %}
{% block extra_head %}
{% include 'partials/desktop_module_styles.twig' %}
<style>
  .danger-card { border:1px solid #fecaca; border-radius:14px; background:#fef2f2; padding:18px; }
</style>
{% endblock %}
{% block body %}
<div class="app-shell dm-page">
  {% include 'partials/sidebar.twig' %}
  <main class="app-main">
    <div class="dm-header">
      <div>
        <h1 class="dm-title">Paramètres</h1>
        <p class="dm-subtitle">Configuration du bâtiment et du portail cloud</p>
      </div>
      <div class="d-flex gap-2">
        <button class="btn btn-sm btn-success" id="refresh-btn">Actualiser</button>
        <button class="btn btn-sm btn-outline-secondary" id="logout-btn">Déconnexion</button>
      </div>
    </div>
    <div class="sb-page-wrap">
      <div class="dm-kpi-grid" id="kpi-row"></div>
      <div class="dm-settings-grid">
        <div class="dm-card">
          <div class="dm-cat-nav" id="cat-nav"></div>
        </div>
        <div class="dm-card" id="cat-panel">
          <p class="text-muted">Chargement…</p>
        </div>
        <div class="dm-card d-none" id="entity-tables-panel">
          <h2 class="h6 fw-bold">Données synchronisées (détail)</h2>
          <div id="entity-tables-host"></div>
        </div>
        <div class="dm-card">
          <h2 class="h6 fw-bold">Informations système</h2>
          <div id="sys-info" class="small mt-2"></div>
          <hr>
          <h2 class="h6 fw-bold text-danger mt-3">Zone sensible</h2>
          <div class="danger-card mt-2">
            <p class="small text-danger mb-2">Réinitialisation irréversible de la base cloud.</p>
            <input type="text" class="form-control form-control-sm mb-2" id="confirm-phrase" placeholder="Phrase de confirmation" />
            <button class="btn btn-sm btn-danger" id="btn-reset" disabled>Réinitialiser cette base</button>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
{% endblock %}
{% block scripts %}
{% include 'partials/nav_script.twig' %}
<script>
if (!Sbms.requireAuth()) throw new Error('auth');
document.getElementById('logout-btn').onclick = Sbms.logout;
const apiFetch = Sbms.apiFetch;
let data = null, activeCat = 'general';
const REQUIRED = 'REINITIALISER SBMS';

const CAT_CONTENT = {
  general: d => `<h2 class="h5 fw-bold">Général</h2><p class="text-muted small">Profil société et environnement cloud.</p>
    <div class="row g-2 mt-2"><div class="col-md-6"><label class="small fw-bold">Société</label><div class="form-control-plaintext">${d.companyName}</div></div>
    <div class="col-md-6"><label class="small fw-bold">Version</label><div class="form-control-plaintext">${d.appVersion}</div></div></div>`,
  buildings: d => `<h2 class="h5 fw-bold">Société &amp; bailleur</h2><p class="small text-muted">Toutes les informations du bâtiment synchronisé.</p>
    <div id="building-table-slot"></div>`,
  synchronisation: d => `<h2 class="h5 fw-bold">Synchronisation</h2><p>Taux de succès : <strong>${d.syncKpiLabel}</strong></p>
    <a href="/synchronisation/" class="btn btn-sm btn-outline-primary">Ouvrir Synchronisation</a>
    <div class="mt-3" id="sync-entity-table-slot"></div>`,
  utilisateurs: d => `<h2 class="h5 fw-bold">Utilisateurs &amp; rôles</h2><p>${d.activeUsersDisplay} utilisateur(s) actif(s).</p>
    <a href="/utilisateurs/" class="btn btn-sm btn-outline-primary">Ouvrir le module Utilisateurs</a>`,
  logs: d => `<h2 class="h5 fw-bold">Logs système</h2><a href="/journal/" class="btn btn-sm btn-outline-primary">Journal d'activité</a>`,
  about: d => `<h2 class="h5 fw-bold">À propos</h2><p class="small">SBMS Web — portail administration cloud Render.</p>
    <p class="small">BDD : ${d.databaseLabel}</p>`,
};

function mountInlineTable(slotId, rows, title) {
  const slot = document.getElementById(slotId);
  if (!slot) return;
  const uid = slotId.replace(/[^a-z0-9]/gi, '');
  slot.innerHTML = `
    <div class="mt-3">
      <div class="fw-bold small mb-1">${title}</div>
      <div class="dm-table-count" id="count-${uid}"></div>
      <div class="dm-table-wrap">
        <table class="table dm-table mb-0">
          <thead id="head-${uid}"></thead>
          <tbody id="body-${uid}"></tbody>
        </table>
      </div>
    </div>`;
  Sbms.renderDataTable(
    document.getElementById(`head-${uid}`),
    document.getElementById(`body-${uid}`),
    rows || [],
    { countEl: document.getElementById(`count-${uid}`) }
  );
}

function renderCat(id) {
  activeCat = id;
  document.querySelectorAll('.dm-cat-link').forEach(b => b.classList.toggle('active', b.dataset.id === id));
  const fn = CAT_CONTENT[id] || (d => `<h2 class="h5 fw-bold">${id}</h2><p class="text-muted small">Paramètres gérés sur l'application desktop.</p>`);
  document.getElementById('cat-panel').innerHTML = fn(data);
  if (id === 'buildings') {
    mountInlineTable('building-table-slot', data.buildingTableRows, 'Bâtiment');
  }
  if (id === 'synchronisation') {
    mountInlineTable('sync-entity-table-slot', data.syncEntityTableRows, 'Entités synchronisées (JSON complet)');
  }
}

async function load() {
  const [mod, info] = await Promise.all([
    apiFetch('/api/executive/modules/parametres/'),
    apiFetch('/api/executive/admin/database-info/'),
  ]);
  data = mod;
  document.getElementById('kpi-row').innerHTML = [
    ['Utilisateurs actifs', mod.activeUsersDisplay, mod.rolesDisplay + ' rôles'],
    ['Sync', mod.syncKpiLabel, mod.syncKpiSub],
    ['Sécurité', mod.securityKpiLabel, mod.securityKpiSub],
  ].map(([l,v,s]) => `<div class="dm-kpi"><small>${l}</small><strong>${v}</strong><div class="trend">${s}</div></div>`).join('');
  document.getElementById('cat-nav').innerHTML = (mod.categories||[]).map(c =>
    `<button class="dm-cat-link" data-id="${c.id}"><i class="bi bi-${c.icon} me-1"></i>${c.label}</button>`).join('');
  document.querySelectorAll('.dm-cat-link').forEach(b => b.onclick = () => renderCat(b.dataset.id));
  document.getElementById('sys-info').innerHTML = `
    <div><strong>Moteur :</strong> ${info.engineLabel}</div>
    <div><strong>Environnement :</strong> ${mod.environmentName}</div>
    <div><strong>Emplacement :</strong> <code class="small">${info.name}</code></div>
    <hr><div class="fw-bold mb-1">Statistiques</div>
    ${(mod.stats||[]).map(s=>`<div class="d-flex justify-content-between"><span>${s.label}</span><strong>${s.value}</strong></div>`).join('')}`;
  renderCat(activeCat);
}

document.getElementById('confirm-phrase').oninput = () => {
  document.getElementById('btn-reset').disabled = document.getElementById('confirm-phrase').value.trim() !== REQUIRED;
};
document.getElementById('btn-reset').onclick = async () => {
  if (!confirm('DERNIÈRE CONFIRMATION — effacer toute la base cloud ?')) return;
  await apiFetch('/api/executive/admin/reset-database/', {
    method: 'POST', body: JSON.stringify({ confirmPhrase: REQUIRED, target: 'server' }),
  });
  alert('Réinitialisation terminée.');
  load();
};
document.getElementById('refresh-btn').onclick = load;
load();
</script>
{% endblock %}

